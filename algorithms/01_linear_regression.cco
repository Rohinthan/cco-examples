// Algorithm 1: Linear Regression & Regularization Variants (OLS, Ridge/L2, Lasso/L1, ElasticNet)

/*
================================================================================
           LINEAR REGRESSION & REGULARIZATION SUITE (OLS, RIDGE, LASSO, ELASTICNET)
================================================================================

1. Ordinary Least Squares (OLS) Closed-Form:
       ŷ = β_1 * x + β_0
       β_1 = Σ_{i=1}^N (x_i - x̄)(y_i - ȳ) / Σ_{i=1}^N (x_i - x̄)²
       β_0 = ȳ - β_1 * x̄

2. Ridge Regression (L2 Regularization / Tikhonov):
       Loss_Ridge(w, b) = (1 / 2N) * Σ_{i=1}^N (ŷ_i - y_i)² + (λ / 2) * ||w||_2²
       ∇_w Loss = (1 / N) * Σ (ŷ_i - y_i) * x_i + λ * w

3. Lasso Regression (L1 Regularization):
       Loss_Lasso(w, b) = (1 / 2N) * Σ_{i=1}^N (ŷ_i - y_i)² + λ * ||w||_1
       ∂_w Loss = (1 / N) * Σ (ŷ_i - y_i) * x_i + λ * sign(w)

4. ElasticNet Regression (L1 + L2 Hybrid):
       Loss_EN(w, b) = (1 / 2N) * Σ (ŷ_i - y_i)² + λ_1 * ||w||_1 + (λ_2 / 2) * ||w||_2²

5. Evaluation Metrics:
       MSE = (1 / N) * Σ_{i=1}^N (y_i - ŷ_i)²
       R²  = 1 - ( SS_res / SS_tot ) = 1 - [ Σ (y_i - ŷ_i)² / Σ (y_i - ȳ)² ]
================================================================================
*/

struct RegressionModel {
    slope: float;
    intercept: float;
    mse: float;
    r2_score: float;
}

fn sign_f(v: float) -> float {
    if (v > 0.0) { return 1.0; }
    if (v < 0.0) { return -1.0; }
    return 0.0;
}

// -------------------------------------------------------------
// 1. Ordinary Least Squares (OLS) - Analytical Solution
// -------------------------------------------------------------
fn train_ols(x: &float[], y: &float[], n: int) -> RegressionModel {
    let sum_x = 0.0;
    let sum_y = 0.0;
    for (let i = 0; i < n; i++) {
        sum_x += x[i];
        sum_y += y[i];
    }
    let n_f = 1.0 * n;
    let mean_x = sum_x / n_f;
    let mean_y = sum_y / n_f;

    let numerator = 0.0;
    let denominator = 0.0;
    for (let i = 0; i < n; i++) {
        let diff_x = x[i] - mean_x;
        let diff_y = y[i] - mean_y;
        numerator += diff_x * diff_y;
        denominator += diff_x * diff_x;
    }

    let slope = 0.0;
    if (denominator != 0.0) {
        slope = numerator / denominator;
    }
    let intercept = mean_y - slope * mean_x;

    // Calculate MSE and R^2
    let ss_res = 0.0;
    let ss_tot = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred = slope * x[i] + intercept;
        let err = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse = ss_res / n_f;
    let r2 = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: slope, intercept: intercept, mse: mse, r2_score: r2 };
}

// -------------------------------------------------------------
// 2. Ridge Regression (L2 Penalty) - Gradient Descent
// -------------------------------------------------------------
fn train_ridge(x: &float[], y: &float[], n: int, l2_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w = 0.0;
    let b = 0.0;
    let n_f = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w = 0.0;
        let grad_b = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred = w * x[i] + b;
            let err = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        grad_w = (grad_w / n_f) + l2_lambda * w;
        grad_b /= n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    let sum_y = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y = sum_y / n_f;

    let ss_res = 0.0;
    let ss_tot = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred = w * x[i] + b;
        let err = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse = ss_res / n_f;
    let r2 = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

// -------------------------------------------------------------
// 3. Lasso Regression (L1 Penalty) - Subgradient Descent
// -------------------------------------------------------------
fn train_lasso(x: &float[], y: &float[], n: int, l1_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w = 0.0;
    let b = 0.0;
    let n_f = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w = 0.0;
        let grad_b = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred = w * x[i] + b;
            let err = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        grad_w = (grad_w / n_f) + l1_lambda * sign_f(w);
        grad_b /= n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    let sum_y = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y = sum_y / n_f;

    let ss_res = 0.0;
    let ss_tot = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred = w * x[i] + b;
        let err = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse = ss_res / n_f;
    let r2 = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

// -------------------------------------------------------------
// 4. ElasticNet Regression (L1 + L2 Mixed Penalty)
// -------------------------------------------------------------
fn train_elastic_net(x: &float[], y: &float[], n: int, l1_lambda: float, l2_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w = 0.0;
    let b = 0.0;
    let n_f = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w = 0.0;
        let grad_b = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred = w * x[i] + b;
            let err = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        grad_w = (grad_w / n_f) + l1_lambda * sign_f(w) + l2_lambda * w;
        grad_b /= n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    let sum_y = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y = sum_y / n_f;

    let ss_res = 0.0;
    let ss_tot = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred = w * x[i] + b;
        let err = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse = ss_res / n_f;
    let r2 = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

fn predict(m: &RegressionModel, x_val: float) -> float {
    return m.slope * x_val + m.intercept;
}

fn print_model_summary(name: string, m: &RegressionModel) -> void {
    print(f"=== {name} Model ===");
    print(f"  Fitted Equation : y = {m.slope} * x + {m.intercept}");
    print(f"  Mean Squared Error (MSE) : {m.mse}");
    print(f"  R^2 Score       : {m.r2_score}");
}

fn main() -> int {
    print("==========================================================");
    print("   LINEAR REGRESSION & REGULARIZATION SUITE (Cco-v20)     ");
    print("==========================================================\n");

    let n = 6;
    let x = alloc(float, n);
    let y = alloc(float, n);

    x[0] = 1.0; y[0] = 3.6;
    x[1] = 2.0; y[1] = 6.3;
    x[2] = 3.0; y[2] = 8.7;
    x[3] = 4.0; y[3] = 11.2;
    x[4] = 5.0; y[4] = 13.8;
    x[5] = 6.0; y[5] = 16.1;

    print(f"Training on {n} data points...\n");

    // 1. OLS
    let ols_model = train_ols(&x, &y, n);
    print_model_summary("Ordinary Least Squares (OLS)", &ols_model);
    let pred_ols_7 = predict(&ols_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_ols_7}\n");

    // 2. Ridge (L2)
    let ridge_model = train_ridge(&x, &y, n, 0.05, 0.01, 2000);
    print_model_summary("Ridge Regression (L2 Regularized)", &ridge_model);
    let pred_ridge_7 = predict(&ridge_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_ridge_7}\n");

    // 3. Lasso (L1)
    let lasso_model = train_lasso(&x, &y, n, 0.02, 0.01, 2000);
    print_model_summary("Lasso Regression (L1 Regularized)", &lasso_model);
    let pred_lasso_7 = predict(&lasso_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_lasso_7}\n");

    // 4. ElasticNet (L1 + L2)
    let en_model = train_elastic_net(&x, &y, n, 0.01, 0.03, 0.01, 2000);
    print_model_summary("ElasticNet Regression (L1 + L2 Regularized)", &en_model);
    let pred_en_7 = predict(&en_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_en_7}\n");

    print("==========================================================");
    print("Linear Regression validation complete with 0 memory leaks!");
    return 0;
}
