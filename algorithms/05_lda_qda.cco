// Algorithm 5: Linear Discriminant Analysis (LDA) & Quadratic Discriminant Analysis (QDA)

/*
================================================================================
                    LINEAR DISCRIMINANT ANALYSIS (LDA)
================================================================================
Assumes all classes share a COMMON (pooled) covariance matrix: Σ_0 = Σ_1 = Σ

1. Class Mean Vector:
       μ_k = (1 / N_k) * Σ_{i ∈ C_k} x_i

2. Pooled Within-Class Covariance Matrix:
       S_k = Σ_{i ∈ C_k} (x_i - μ_k)(x_i - μ_k)^T
       Σ   = (1 / (N - K)) * (S_0 + S_1 + ... + S_K)

3. 2x2 Matrix Inversion (2D Feature Space):
       Σ = [ a  b ]  ===>  Σ^-1 = (1 / det(Σ)) * [  d  -b ]
           [ c  d ]                              [ -c   a ]
       det(Σ) = a*d - b*c

4. Linear Discriminant Score (Decision Function):
       δ_k(x) = x^T Σ^-1 μ_k  -  (1/2) μ_k^T Σ^-1 μ_k  +  ln(P(C_k))

5. Fisher's Optimal 1D Projection Vector:
       w = Σ^-1 (μ_1 - μ_0)
       y_1D = w_1 * x_1 + w_2 * x_2
================================================================================
*/

struct LDAModel {
    prior0: float; prior1: float;
    // Mean Vectors: μ0 and μ1
    m0_1: float; m0_2: float;
    m1_1: float; m1_2: float;
    // Inverse of Pooled Covariance Matrix Σ^-1: [inv_a, inv_b; inv_c, inv_d]
    inv_a: float; inv_b: float;
    inv_c: float; inv_d: float;
    // Fisher 1D Projection Vector: w = [w1, w2]
    w1: float; w2: float;
}

/*
================================================================================
                  QUADRATIC DISCRIMINANT ANALYSIS (QDA)
================================================================================
Relaxes LDA assumption: EACH class has its OWN distinct covariance matrix Σ_k

1. Individual Class Covariance Matrix:
       Σ_k = (1 / (N_k - 1)) * Σ_{i ∈ C_k} (x_i - μ_k)(x_i - μ_k)^T

2. Quadratic Discriminant Score:
       δ_k(x) = - (1/2) ln|Σ_k| - (1/2) (x - μ_k)^T Σ_k^-1 (x - μ_k) + ln(P(C_k))

3. Quadratic Decision Boundary:
       Predict Class 1 if δ_1(x) > δ_0(x), else Class 0
================================================================================
*/

struct QDAModel {
    prior0: float; prior1: float;
    m0_1: float; m0_2: float;
    m1_1: float; m1_2: float;
    // Class 0 Covariance Inverse & Determinant
    inv0_a: float; inv0_b: float; inv0_c: float; inv0_d: float;
    det0: float;
    // Class 1 Covariance Inverse & Determinant
    inv1_a: float; inv1_b: float; inv1_c: float; inv1_d: float;
    det1: float;
}

// -------------------------------------------------------------
// 1. Train Linear Discriminant Analysis (LDA)
// -------------------------------------------------------------
fn train_lda(x1: &float[], x2: &float[], y: &int[], n: int) -> LDAModel {
    let count0 = 0; let count1 = 0;
    let sum0_1 = 0.0; let sum0_2 = 0.0;
    let sum1_1 = 0.0; let sum1_2 = 0.0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            count0++;
            sum0_1 += x1[i]; sum0_2 += x2[i];
        } else {
            count1++;
            sum1_1 += x1[i]; sum1_2 += x2[i];
        }
    }

    let n_f = 1.0 * n;
    let prior0 = (1.0 * count0) / n_f;
    let prior1 = (1.0 * count1) / n_f;

    let m0_1 = sum0_1 / (1.0 * count0);
    let m0_2 = sum0_2 / (1.0 * count0);
    let m1_1 = sum1_1 / (1.0 * count1);
    let m1_2 = sum1_2 / (1.0 * count1);

    // Compute Pooled Covariance Matrix (Within-Class Scatter)
    let s_a = 0.0; let s_b = 0.0;
    let s_c = 0.0; let s_d = 0.0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            let d1 = x1[i] - m0_1;
            let d2 = x2[i] - m0_2;
            s_a += d1 * d1; s_b += d1 * d2;
            s_c += d2 * d1; s_d += d2 * d2;
        } else {
            let d1 = x1[i] - m1_1;
            let d2 = x2[i] - m1_2;
            s_a += d1 * d1; s_b += d1 * d2;
            s_c += d2 * d1; s_d += d2 * d2;
        }
    }

    let dof = (1.0 * n) - 2.0; // N - K degrees of freedom
    let cov_a = s_a / dof;
    let cov_b = s_b / dof;
    let cov_c = s_c / dof;
    let cov_d = s_d / dof;

    // Invert Pooled 2x2 Matrix: det = a*d - b*c
    let det = cov_a * cov_d - cov_b * cov_c;
    if (det == 0.0) { det = 0.00001; }

    let inv_a = cov_d / det;
    let inv_b = -cov_b / det;
    let inv_c = -cov_c / det;
    let inv_d = cov_a / det;

    // Fisher's Optimal 1D Projection Vector: w = Σ^-1 (μ1 - μ0)
    let diff_m1 = m1_1 - m0_1;
    let diff_m2 = m1_2 - m0_2;
    let w1 = inv_a * diff_m1 + inv_b * diff_m2;
    let w2 = inv_c * diff_m1 + inv_d * diff_m2;

    return LDAModel {
        prior0: prior0, prior1: prior1,
        m0_1: m0_1, m0_2: m0_2,
        m1_1: m1_1, m1_2: m1_2,
        inv_a: inv_a, inv_b: inv_b, inv_c: inv_c, inv_d: inv_d,
        w1: w1, w2: w2
    };
}

fn lda_score(m: &LDAModel, x1: float, x2: float, m_x1: float, m_x2: float, prior: float) -> float {
    // x^T Σ^-1 μ
    let inv_x1 = m.inv_a * m_x1 + m.inv_b * m_x2;
    let inv_x2 = m.inv_c * m_x1 + m.inv_d * m_x2;
    let term1 = x1 * inv_x1 + x2 * inv_x2;

    // (1/2) μ^T Σ^-1 μ
    let term2 = 0.5 * (m_x1 * inv_x1 + m_x2 * inv_x2);

    return term1 - term2 + log(prior);
}

fn predict_lda(m: &LDAModel, x1: float, x2: float) -> int {
    let score0 = lda_score(m, x1, x2, m.m0_1, m.m0_2, m.prior0);
    let score1 = lda_score(m, x1, x2, m.m1_1, m.m1_2, m.prior1);

    if (score1 > score0) {
        return 1;
    }
    return 0;
}

fn lda_project_1d(m: &LDAModel, x1: float, x2: float) -> float {
    return m.w1 * x1 + m.w2 * x2;
}

// -------------------------------------------------------------
// 2. Train Quadratic Discriminant Analysis (QDA)
// -------------------------------------------------------------
fn train_qda(x1: &float[], x2: &float[], y: &int[], n: int) -> QDAModel {
    let count0 = 0; let count1 = 0;
    let sum0_1 = 0.0; let sum0_2 = 0.0;
    let sum1_1 = 0.0; let sum1_2 = 0.0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            count0++;
            sum0_1 += x1[i]; sum0_2 += x2[i];
        } else {
            count1++;
            sum1_1 += x1[i]; sum1_2 += x2[i];
        }
    }

    let n_f = 1.0 * n;
    let prior0 = (1.0 * count0) / n_f;
    let prior1 = (1.0 * count1) / n_f;

    let m0_1 = sum0_1 / (1.0 * count0);
    let m0_2 = sum0_2 / (1.0 * count0);
    let m1_1 = sum1_1 / (1.0 * count1);
    let m1_2 = sum1_2 / (1.0 * count1);

    // Compute Individual Class 0 Covariance Σ0
    let s0_a = 0.0; let s0_b = 0.0;
    let s0_c = 0.0; let s0_d = 0.0;
    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            let d1 = x1[i] - m0_1;
            let d2 = x2[i] - m0_2;
            s0_a += d1 * d1; s0_b += d1 * d2;
            s0_c += d2 * d1; s0_d += d2 * d2;
        }
    }
    let dof0 = (1.0 * count0) - 1.0;
    let cov0_a = s0_a / dof0; let cov0_b = s0_b / dof0;
    let cov0_c = s0_c / dof0; let cov0_d = s0_d / dof0;
    let det0 = cov0_a * cov0_d - cov0_b * cov0_c;
    if (det0 <= 0.0) { det0 = 0.00001; }

    let inv0_a = cov0_d / det0; let inv0_b = -cov0_b / det0;
    let inv0_c = -cov0_c / det0; let inv0_d = cov0_a / det0;

    // Compute Individual Class 1 Covariance Σ1
    let s1_a = 0.0; let s1_b = 0.0;
    let s1_c = 0.0; let s1_d = 0.0;
    for (let i = 0; i < n; i++) {
        if (y[i] == 1) {
            let d1 = x1[i] - m1_1;
            let d2 = x2[i] - m1_2;
            s1_a += d1 * d1; s1_b += d1 * d2;
            s1_c += d2 * d1; s1_d += d2 * d2;
        }
    }
    let dof1 = (1.0 * count1) - 1.0;
    let cov1_a = s1_a / dof1; let cov1_b = s1_b / dof1;
    let cov1_c = s1_c / dof1; let cov1_d = s1_d / dof1;
    let det1 = cov1_a * cov1_d - cov1_b * cov1_c;
    if (det1 <= 0.0) { det1 = 0.00001; }

    let inv1_a = cov1_d / det1; let inv1_b = -cov1_b / det1;
    let inv1_c = -cov1_c / det1; let inv1_d = cov1_a / det1;

    return QDAModel {
        prior0: prior0, prior1: prior1,
        m0_1: m0_1, m0_2: m0_2,
        m1_1: m1_1, m1_2: m1_2,
        inv0_a: inv0_a, inv0_b: inv0_b, inv0_c: inv0_c, inv0_d: inv0_d,
        det0: det0,
        inv1_a: inv1_a, inv1_b: inv1_b, inv1_c: inv1_c, inv1_d: inv1_d,
        det1: det1
    };
}

fn qda_score(x1: float, x2: float, m_x1: float, m_x2: float, inv_a: float, inv_b: float, inv_c: float, inv_d: float, det: float, prior: float) -> float {
    let d1 = x1 - m_x1;
    let d2 = x2 - m_x2;

    // Mahalanobis Distance: (x - μ)^T Σ^-1 (x - μ)
    let tmp1 = inv_a * d1 + inv_b * d2;
    let tmp2 = inv_c * d1 + inv_d * d2;
    let mahalanobis = d1 * tmp1 + d2 * tmp2;

    return -0.5 * log(det) - 0.5 * mahalanobis + log(prior);
}

fn predict_qda(m: &QDAModel, x1: float, x2: float) -> int {
    let score0 = qda_score(x1, x2, m.m0_1, m.m0_2, m.inv0_a, m.inv0_b, m.inv0_c, m.inv0_d, m.det0, m.prior0);
    let score1 = qda_score(x1, x2, m.m1_1, m.m1_2, m.inv1_a, m.inv1_b, m.inv1_c, m.inv1_d, m.det1, m.prior1);

    if (score1 > score0) {
        return 1;
    }
    return 0;
}

fn main() -> int {
    print("==================================================================");
    print("   DISCRIMINANT ANALYSIS SUITE: LDA & QDA (Cco-v20)               ");
    print("==================================================================\n");

    let n = 8;
    let x1 = alloc(float, n);
    let x2 = alloc(float, n);
    let y = alloc(int, n);

    // Class 0: Dense tight cluster centered at (2.0, 3.0)
    x1[0] = 1.8; x2[0] = 2.9; y[0] = 0;
    x1[1] = 2.2; x2[1] = 3.1; y[1] = 0;
    x1[2] = 2.0; x2[2] = 3.0; y[2] = 0;
    x1[3] = 1.9; x2[3] = 3.2; y[3] = 0;

    // Class 1: Wider stretched cluster centered at (6.5, 7.5)
    x1[4] = 6.0; x2[4] = 7.0; y[4] = 1;
    x1[5] = 7.0; x2[5] = 8.0; y[5] = 1;
    x1[6] = 6.8; x2[6] = 7.2; y[6] = 1;
    x1[7] = 6.2; x2[7] = 7.8; y[7] = 1;

    print("--- 1. Linear Discriminant Analysis (LDA) ---");
    let lda_mod = train_lda(&x1, &x2, &y, n);
    print(f"  Class 0 Mean : ({lda_mod.m0_1}, {lda_mod.m0_2})");
    print(f"  Class 1 Mean : ({lda_mod.m1_1}, {lda_mod.m1_2})");
    print(f"  Fisher 1D Projection Vector w : [{lda_mod.w1}, {lda_mod.w2}]\n");

    print("  Fisher 1D Subspace Projections (y = w^T * x):");
    for (let i = 0; i < n; i++) {
        let proj = lda_project_1d(&lda_mod, x1[i], x2[i]);
        print(f"    Sample {i} (Class {y[i]}) -> 1D Projection: {proj}");
    }
    print("");

    // Test LDA Predictions
    let lda_p0 = predict_lda(&lda_mod, 2.1, 3.0);
    let lda_p1 = predict_lda(&lda_mod, 6.5, 7.4);
    print(f"  Test Point (2.1, 3.0) -> LDA Predicted Class: {lda_p0} (Expected: 0)");
    print(f"  Test Point (6.5, 7.4) -> LDA Predicted Class: {lda_p1} (Expected: 1)\n");

    print("--- 2. Quadratic Discriminant Analysis (QDA) ---");
    let qda_mod = train_qda(&x1, &x2, &y, n);
    print(f"  Class 0 Det|Σ0| : {qda_mod.det0}");
    print(f"  Class 1 Det|Σ1| : {qda_mod.det1}\n");

    let qda_p0 = predict_qda(&qda_mod, 2.1, 3.0);
    let qda_p1 = predict_qda(&qda_mod, 6.5, 7.4);
    print(f"  Test Point (2.1, 3.0) -> QDA Predicted Class: {qda_p0} (Expected: 0)");
    print(f"  Test Point (6.5, 7.4) -> QDA Predicted Class: {qda_p1} (Expected: 1)\n");

    print("==================================================================");
    print("LDA & QDA validation complete with 0 memory leaks!");
    return 0;
}
