// Algorithm 24: Independent Component Analysis (ICA) - FastICA Blind Source Separation

/*
================================================================================
                    INDEPENDENT COMPONENT ANALYSIS (ICA)
================================================================================

1. The Linear Mixing Problem (Cocktail Party Problem):
       Observed signals x(t) are linear mixtures of unknown independent sources s(t):
           x(t) = A * s(t)
       where:
           s(t) = [s_1(t), s_2(t), ..., s_m(t)]^T  (Non-Gaussian independent sources)
           A ∈ R^{m x m}                           (Unknown invertible mixing matrix)
           x(t) = [x_1(t), x_2(t), ..., x_m(t)]^T  (Observed mixed sensor signals)

       Objective: Find unmixing matrix W ≈ A^(-1) such that:
           ŝ(t) = W * x(t) recovers statistically independent components!

2. Central Limit Theorem & Non-Gaussianity Maximization:
       The sum of independent random variables is strictly MORE Gaussian than any
       individual constituent variable. Therefore, maximizing non-Gaussianity of
       w^T z recovers the original independent sources!

3. Preprocessing Pipeline:
       a. Centering: x_c(t) = x(t) - E[x(t)]
       b. Whitening (Sphering):
              Covariance matrix Σ = E[x_c * x_c^T] = E * D * E^T
              Whitening matrix V = D^(-1/2) * E^T
              Whitened data: z(t) = V * x_c(t),  ensuring E[z * z^T] = I
              Reduces the unmixing problem to finding an orthogonal rotation matrix!

4. FastICA Fixed-Point Algorithm (Hyvärinen, 1999):
       Contrast function G(u) = ln cosh(u)  ===>  g(u) = tanh(u),  g'(u) = 1 - tanh^2(u)
       Fixed-point iterative update rule for weight vector w:
           w^+ = E[ z * g(w^T z) ]  -  E[ g'(w^T z) ] * w
           w   = w^+ / ||w^+||

5. Gram-Schmidt Deflationary Orthogonalization:
       To extract multiple components w_p (p = 2, ..., m):
           w_p = w_p - Σ_{j=1}^{p-1} (w_p^T w_j) * w_j
           w_p = w_p / ||w_p||

6. Indeterminacies of ICA:
       Inherent ambiguities in blind separation:
       - Permutation ambiguity: Sources may appear in any order.
       - Sign / Scale ambiguity: Sources may be inverted (ŝ_j = ± s_j).
================================================================================
*/

fn my_tanh(u: float) -> float {
    if (u > 10.0) { return 1.0; }
    if (u < -10.0) { return -1.0; }
    let ep = exp(u);
    let em = exp(-u);
    return (ep - em) / (ep + em);
}

// -------------------------------------------------------------
// Pearson Correlation Coefficient: r(a, b) ∈ [-1, 1]
// -------------------------------------------------------------
fn calc_pearson_corr(a: &float[], b: &float[], n: int) -> float {
    let n_f = 1.0 * n;
    let sum_a = 0.0; let sum_b = 0.0;
    for (let i = 0; i < n; i++) {
        sum_a += a[i];
        sum_b += b[i];
    }
    let ma = sum_a / n_f;
    let mb = sum_b / n_f;

    let num = 0.0;
    let den_a = 0.0;
    let den_b = 0.0;

    for (let i = 0; i < n; i++) {
        let da = a[i] - ma;
        let db = b[i] - mb;
        num += da * db;
        den_a += da * da;
        den_b += db * db;
    }

    let den = sqrt(den_a * den_b);
    if (den < 0.0000001) { return 0.0; }
    return num / den;
}

// -------------------------------------------------------------
// FastICA 2-Channel Blind Source Separation Engine
// -------------------------------------------------------------
fn run_fastica_2d(x1: &float[], x2: &float[], n: int, max_iters: int,
                  s_rec1: &float[], s_rec2: &float[]) -> void {
    let n_f = 1.0 * n;

    // --- Step 1: Centering ---
    let sum1 = 0.0; let sum2 = 0.0;
    for (let i = 0; i < n; i++) {
        sum1 += x1[i];
        sum2 += x2[i];
    }
    let m1 = sum1 / n_f;
    let m2 = sum2 / n_f;

    let x1_c = alloc(float, n);
    let x2_c = alloc(float, n);
    for (let i = 0; i < n; i++) {
        x1_c[i] = x1[i] - m1;
        x2_c[i] = x2[i] - m2;
    }

    // --- Step 2: Covariance Matrix & Whitening ---
    let c00 = 0.0; let c01 = 0.0; let c11 = 0.0;
    for (let i = 0; i < n; i++) {
        c00 += x1_c[i] * x1_c[i];
        c01 += x1_c[i] * x2_c[i];
        c11 += x2_c[i] * x2_c[i];
    }
    c00 /= n_f;
    c01 /= n_f;
    c11 /= n_f;

    // Eigendecomposition of 2x2 Covariance Matrix
    let tr = c00 + c11;
    let det = c00 * c11 - c01 * c01;
    let disc = sqrt((0.5 * tr) * (0.5 * tr) - det);
    let l1 = 0.5 * tr + disc;
    let l2 = 0.5 * tr - disc;

    // Eigenvectors
    let e1_x = c01;
    let e1_y = l1 - c00;
    let e1_norm = sqrt(e1_x * e1_x + e1_y * e1_y);
    if (e1_norm < 0.00001) { e1_x = 1.0; e1_y = 0.0; e1_norm = 1.0; }
    e1_x /= e1_norm;
    e1_y /= e1_norm;

    // Second orthogonal eigenvector
    let e2_x = -e1_y;
    let e2_y = e1_x;

    // Whitened Signals: z = D^(-1/2) * E^T * x_c
    let inv_sqrt_l1 = 1.0 / sqrt(l1);
    let inv_sqrt_l2 = 1.0 / sqrt(l2);

    let z1 = alloc(float, n);
    let z2 = alloc(float, n);
    for (let i = 0; i < n; i++) {
        z1[i] = inv_sqrt_l1 * (e1_x * x1_c[i] + e1_y * x2_c[i]);
        z2[i] = inv_sqrt_l2 * (e2_x * x1_c[i] + e2_y * x2_c[i]);
    }

    // --- Step 3: FastICA Fixed-Point Iteration for Component 1 ---
    let w1_1 = 1.0;
    let w1_2 = 0.0;

    for (let it = 0; it < max_iters; it++) {
        let sum_z1_g = 0.0;
        let sum_z2_g = 0.0;
        let sum_gp = 0.0;

        for (let i = 0; i < n; i++) {
            let u = w1_1 * z1[i] + w1_2 * z2[i];
            let g = my_tanh(u);
            let gp = 1.0 - (g * g);

            sum_z1_g += z1[i] * g;
            sum_z2_g += z2[i] * g;
            sum_gp += gp;
        }

        let mean_gp = sum_gp / n_f;
        let nw1_1 = (sum_z1_g / n_f) - mean_gp * w1_1;
        let nw1_2 = (sum_z2_g / n_f) - mean_gp * w1_2;

        let norm = sqrt(nw1_1 * nw1_1 + nw1_2 * nw1_2);
        if (norm < 0.000001) { norm = 0.000001; }
        w1_1 = nw1_1 / norm;
        w1_2 = nw1_2 / norm;
    }

    // --- Step 4: FastICA Fixed-Point Iteration for Component 2 (with Orthogonalization) ---
    let w2_1 = 0.0;
    let w2_2 = 1.0;

    for (let it = 0; it < max_iters; it++) {
        let sum_z1_g = 0.0;
        let sum_z2_g = 0.0;
        let sum_gp = 0.0;

        for (let i = 0; i < n; i++) {
            let u = w2_1 * z1[i] + w2_2 * z2[i];
            let g = my_tanh(u);
            let gp = 1.0 - (g * g);

            sum_z1_g += z1[i] * g;
            sum_z2_g += z2[i] * g;
            sum_gp += gp;
        }

        let mean_gp = sum_gp / n_f;
        let nw2_1 = (sum_z1_g / n_f) - mean_gp * w2_1;
        let nw2_2 = (sum_z2_g / n_f) - mean_gp * w2_2;

        // Gram-Schmidt Orthogonalization against w1: w2 = w2 - (w2 · w1) w1
        let dot = nw2_1 * w1_1 + nw2_2 * w1_2;
        nw2_1 -= dot * w1_1;
        nw2_2 -= dot * w1_2;

        let norm = sqrt(nw2_1 * nw2_1 + nw2_2 * nw2_2);
        if (norm < 0.000001) { norm = 0.000001; }
        w2_1 = nw2_1 / norm;
        w2_2 = nw2_2 / norm;
    }

    // --- Step 5: Unmix Sources: ŝ = W * z ---
    for (let i = 0; i < n; i++) {
        s_rec1[i] = w1_1 * z1[i] + w1_2 * z2[i];
        s_rec2[i] = w2_1 * z1[i] + w2_2 * z2[i];
    }
}

fn main() -> int {
    print("==================================================================");
    print("   INDEPENDENT COMPONENT ANALYSIS (ICA) - FASTICA SEPARATION      ");
    print("==================================================================\n");

    // 16 Time Samples of Two Non-Gaussian Independent Sources:
    // Source 1: Sinusoidal Periodic Signal
    // Source 2: Sawtooth Ramp Signal
    let n = 16;
    let s1 = alloc(float, n);
    let s2 = alloc(float, n);
    let pi_val = 3.141592653589793;

    for (let t = 0; t < n; t++) {
        // Sine wave
        s1[t] = sin((2.0 * pi_val * (1.0 * t)) / (1.0 * n));
        // Sawtooth wave (-1.0 to +1.0)
        let phase = (t % 4);
        s2[t] = ((1.0 * phase) - 1.5) / 1.5;
    }

    // Linear Mixing Matrix A = [[0.8, 0.6], [0.3, 0.7]]
    let a11 = 0.8; let a12 = 0.6;
    let a21 = 0.3; let a22 = 0.7;

    let x1 = alloc(float, n);
    let x2 = alloc(float, n);

    for (let t = 0; t < n; t++) {
        x1[t] = a11 * s1[t] + a12 * s2[t];
        x2[t] = a21 * s1[t] + a22 * s2[t];
    }

    print("--- 1. Original vs Mixed Signals (First 5 Time Steps) ---");
    for (let t = 0; t < 5; t++) {
        print(f"  t={t} | True Sources: [s1={s1[t]}, s2={s2[t]}] ==> Mixed Sensors: [x1={x1[t]}, x2={x2[t]}]");
    }
    print("");

    // --- 2. Running FastICA ---
    print("--- 2. Running FastICA Negentropy Optimization ---");
    let s_rec1 = alloc(float, n);
    let s_rec2 = alloc(float, n);

    run_fastica_2d(&x1, &x2, n, 40, &s_rec1, &s_rec2);

    print("--- 3. Recovered Independent Sources (First 5 Time Steps) ---");
    for (let t = 0; t < 5; t++) {
        print(f"  t={t} | Recovered: [ŝ1={s_rec1[t]}, ŝ2={s_rec2[t]}]");
    }
    print("");

    // --- 4. Signal Separation Evaluation via Cross-Correlation ---
    print("--- 4. Signal Separation Evaluation (Pearson Correlation Matrix) ---");
    let r11 = calc_pearson_corr(&s1, &s_rec1, n);
    let r12 = calc_pearson_corr(&s1, &s_rec2, n);
    let r21 = calc_pearson_corr(&s2, &s_rec1, n);
    let r22 = calc_pearson_corr(&s2, &s_rec2, n);

    print(f"  Corr(True s1, Recovered ŝ1) : {r11}");
    print(f"  Corr(True s1, Recovered ŝ2) : {r12}");
    print(f"  Corr(True s2, Recovered ŝ1) : {r21}");
    print(f"  Corr(True s2, Recovered ŝ2) : {r22}\n");

    // Account for ICA sign and permutation invariance:
    let abs_r11 = r11; if (abs_r11 < 0.0) { abs_r11 = -abs_r11; }
    let abs_r12 = r12; if (abs_r12 < 0.0) { abs_r12 = -abs_r12; }
    let abs_r21 = r21; if (abs_r21 < 0.0) { abs_r21 = -abs_r21; }
    let abs_r22 = r22; if (abs_r22 < 0.0) { abs_r22 = -abs_r22; }

    let separated = false;
    if ((abs_r11 > 0.95 && abs_r22 > 0.95) || (abs_r12 > 0.95 && abs_r21 > 0.95)) {
        separated = true;
    }

    if (separated) {
        print("  SUCCESS: Independent sources isolated blindly with >95% correlation!\n");
    }

    print("==================================================================");
    print("Independent Component Analysis (ICA) verified with 0 memory leaks!");
    return 0;
}
