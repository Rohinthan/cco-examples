// Algorithm 2: Logistic Regression (Binary Classification with Sigmoid & Multi-Class with Softmax)

struct BinaryModel {
    w1: float;
    w2: float;
    bias: float;
    loss: float;
    accuracy: float;
}

struct MultiClassModel {
    // 3 Classes, 2 Features (Flattened W: 3x2, B: 3)
    w00: float; w01: float; b0: float;
    w10: float; w11: float; b1: float;
    w20: float; w21: float; b2: float;
    loss: float;
    accuracy: float;
}

fn sigmoid(z: float) -> float {
    if (z < -20.0) { return 0.0; }
    if (z > 20.0) { return 1.0; }
    return 1.0 / (1.0 + exp(-z));
}

// -------------------------------------------------------------
// 1. Binary Logistic Regression (Sigmoid + Binary Cross-Entropy)
// -------------------------------------------------------------
fn train_binary_logistic(x1: &float[], x2: &float[], y: &float[], n: int, lr: float, epochs: int) -> BinaryModel {
    let w1: float = 0.0;
    let w2: float = 0.0;
    let b: float = 0.0;
    let n_f: float = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w1: float = 0.0;
        let grad_w2: float = 0.0;
        let grad_b: float = 0.0;

        for (let i = 0; i < n; i++) {
            let z: float = w1 * x1[i] + w2 * x2[i] + b;
            let y_hat: float = sigmoid(z);
            let err: float = y_hat - y[i];

            grad_w1 += err * x1[i];
            grad_w2 += err * x2[i];
            grad_b += err;
        }

        w1 -= lr * (grad_w1 / n_f);
        w2 -= lr * (grad_w2 / n_f);
        b -= lr * (grad_b / n_f);
    }

    // Evaluate final loss and accuracy
    let total_loss: float = 0.0;
    let correct: int = 0;
    let eps: float = 0.0000001;

    for (let i = 0; i < n; i++) {
        let z: float = w1 * x1[i] + w2 * x2[i] + b;
        let y_hat: float = sigmoid(z);
        if (y_hat < eps) { y_hat = eps; }
        if (y_hat > 1.0 - eps) { y_hat = 1.0 - eps; }

        let bce: float = -(y[i] * log(y_hat) + (1.0 - y[i]) * log(1.0 - y_hat));
        total_loss += bce;

        let pred_class: float = 0.0;
        if (y_hat >= 0.5) { pred_class = 1.0; }
        if (pred_class == y[i]) { correct = correct + 1; }
    }

    let avg_loss: float = total_loss / n_f;
    let acc: float = (1.0 * correct) / n_f;

    return BinaryModel { w1: w1, w2: w2, bias: b, loss: avg_loss, accuracy: acc };
}

fn predict_binary_prob(m: &BinaryModel, x1_val: float, x2_val: float) -> float {
    return sigmoid(m.w1 * x1_val + m.w2 * x2_val + m.bias);
}

// -------------------------------------------------------------
// 2. Multinomial Logistic Regression (Softmax + Cross-Entropy)
// -------------------------------------------------------------
fn train_multiclass_logistic(x1: &float[], x2: &float[], y: &int[], n: int, lr: float, epochs: int) -> MultiClassModel {
    // 3 Classes (0, 1, 2), 2 Features
    let w00: float = 0.0; let w01: float = 0.0; let b0: float = 0.0;
    let w10: float = 0.0; let w11: float = 0.0; let b1: float = 0.0;
    let w20: float = 0.0; let w21: float = 0.0; let b2: float = 0.0;
    let n_f: float = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let gw00: float = 0.0; let gw01: float = 0.0; let gb0: float = 0.0;
        let gw10: float = 0.0; let gw11: float = 0.0; let gb1: float = 0.0;
        let gw20: float = 0.0; let gw21: float = 0.0; let gb2: float = 0.0;

        for (let i = 0; i < n; i++) {
            let z0: float = w00 * x1[i] + w01 * x2[i] + b0;
            let z1: float = w10 * x1[i] + w11 * x2[i] + b1;
            let z2: float = w20 * x1[i] + w21 * x2[i] + b2;

            // Numerically stable Softmax
            let max_z: float = z0;
            if (z1 > max_z) { max_z = z1; }
            if (z2 > max_z) { max_z = z2; }

            let exp0: float = exp(z0 - max_z);
            let exp1: float = exp(z1 - max_z);
            let exp2: float = exp(z2 - max_z);
            let sum_exp: float = exp0 + exp1 + exp2;

            let p0: float = exp0 / sum_exp;
            let p1: float = exp1 / sum_exp;
            let p2: float = exp2 / sum_exp;

            // One-hot target comparison
            let target0: float = 0.0;
            let target1: float = 0.0;
            let target2: float = 0.0;
            if (y[i] == 0) { target0 = 1.0; }
            else if (y[i] == 1) { target1 = 1.0; }
            else { target2 = 1.0; }

            let err0: float = p0 - target0;
            let err1: float = p1 - target1;
            let err2: float = p2 - target2;

            gw00 += err0 * x1[i]; gw01 += err0 * x2[i]; gb0 += err0;
            gw10 += err1 * x1[i]; gw11 += err1 * x2[i]; gb1 += err1;
            gw20 += err2 * x1[i]; gw21 += err2 * x2[i]; gb2 += err2;
        }

        w00 -= lr * (gw00 / n_f); w01 -= lr * (gw01 / n_f); b0 -= lr * (gb0 / n_f);
        w10 -= lr * (gw10 / n_f); w11 -= lr * (gw11 / n_f); b1 -= lr * (gb1 / n_f);
        w20 -= lr * (gw20 / n_f); w21 -= lr * (gw21 / n_f); b2 -= lr * (gb2 / n_f);
    }

    // Evaluate final categorical cross-entropy and accuracy
    let total_loss: float = 0.0;
    let correct: int = 0;
    let eps: float = 0.0000001;

    for (let i = 0; i < n; i++) {
        let z0: float = w00 * x1[i] + w01 * x2[i] + b0;
        let z1: float = w10 * x1[i] + w11 * x2[i] + b1;
        let z2: float = w20 * x1[i] + w21 * x2[i] + b2;

        let max_z: float = z0;
        if (z1 > max_z) { max_z = z1; }
        if (z2 > max_z) { max_z = z2; }

        let exp0: float = exp(z0 - max_z);
        let exp1: float = exp(z1 - max_z);
        let exp2: float = exp(z2 - max_z);
        let sum_exp: float = exp0 + exp1 + exp2;

        let p0: float = exp0 / sum_exp;
        let p1: float = exp1 / sum_exp;
        let p2: float = exp2 / sum_exp;

        // Argmax prediction
        let pred_class: int = 0;
        let max_p: float = p0;
        if (p1 > max_p) { max_p = p1; pred_class = 1; }
        if (p2 > max_p) { max_p = p2; pred_class = 2; }

        if (pred_class == y[i]) { correct = correct + 1; }

        if (y[i] == 0) { total_loss -= log(p0 + eps); }
        else if (y[i] == 1) { total_loss -= log(p1 + eps); }
        else { total_loss -= log(p2 + eps); }
    }

    let avg_loss: float = total_loss / n_f;
    let acc: float = (1.0 * correct) / n_f;

    return MultiClassModel {
        w00: w00, w01: w01, b0: b0,
        w10: w10, w11: w11, b1: b1,
        w20: w20, w21: w21, b2: b2,
        loss: avg_loss,
        accuracy: acc
    };
}

fn predict_multiclass_class(m: &MultiClassModel, x1_val: float, x2_val: float) -> int {
    let z0: float = m.w00 * x1_val + m.w01 * x2_val + m.b0;
    let z1: float = m.w10 * x1_val + m.w11 * x2_val + m.b1;
    let z2: float = m.w20 * x1_val + m.w21 * x2_val + m.b2;

    let best_class: int = 0;
    let best_z: float = z0;
    if (z1 > best_z) { best_z = z1; best_class = 1; }
    if (z2 > best_z) { best_z = z2; best_class = 2; }
    return best_class;
}

fn main() -> int {
    print("==================================================================");
    print("   LOGISTIC REGRESSION & SOFTMAX CLASSIFICATION SUITE (Cco-v20)   ");
    print("==================================================================\n");

    // --- PART 1: BINARY LOGISTIC REGRESSION (Pass / Fail Exam Predictor) ---
    // Features: [Hours Studied, Attendance % / 100], Label: [0 = Fail, 1 = Pass]
    let n_bin: int = 8;
    let bx1: float[] = alloc(float, n_bin);
    let bx2: float[] = alloc(float, n_bin);
    let by: float[] = alloc(float, n_bin);

    // Fail samples
    bx1[0] = 1.0; bx2[0] = 0.50; by[0] = 0.0;
    bx1[1] = 2.0; bx2[1] = 0.60; by[1] = 0.0;
    bx1[2] = 2.5; bx2[2] = 0.55; by[2] = 0.0;
    bx1[3] = 3.0; bx2[3] = 0.65; by[3] = 0.0;
    // Pass samples
    bx1[4] = 6.0; bx2[4] = 0.85; by[4] = 1.0;
    bx1[5] = 7.5; bx2[5] = 0.90; by[5] = 1.0;
    bx1[6] = 8.0; bx2[6] = 0.80; by[6] = 1.0;
    bx1[7] = 9.0; bx2[7] = 0.95; by[7] = 1.0;

    print("--- 1. Training Binary Logistic Regression (Sigmoid) ---");
    let bin_model: BinaryModel = train_binary_logistic(&bx1, &bx2, &by, n_bin, 0.1, 3000);
    print(f"  Trained Decision Weights : w1={bin_model.w1}, w2={bin_model.w2}, bias={bin_model.bias}");
    print(f"  Binary Cross-Entropy Loss: {bin_model.loss}");
    print(f"  Training Accuracy        : {bin_model.accuracy * 100.0}%\n");

    // Test Predictions
    let prob_fail_student: float = predict_binary_prob(&bin_model, 1.5, 0.55);
    let prob_pass_student: float = predict_binary_prob(&bin_model, 8.5, 0.92);
    print(f"  Student [1.5 hrs, 55% att] -> Pass Probability = {prob_fail_student * 100.0}% (Predicted: Fail)");
    print(f"  Student [8.5 hrs, 92% att] -> Pass Probability = {prob_pass_student * 100.0}% (Predicted: Pass)\n");

    // --- PART 2: MULTINOMIAL LOGISTIC REGRESSION (3-Class Softmax Classifier) ---
    // 3 Iris-like Clusters: Class 0, Class 1, Class 2
    let n_mc: int = 9;
    let mx1: float[] = alloc(float, n_mc);
    let mx2: float[] = alloc(float, n_mc);
    let my: int[] = alloc(int, n_mc);

    // Class 0: Low x1, Low x2
    mx1[0] = 1.0; mx2[0] = 1.2; my[0] = 0;
    mx1[1] = 1.5; mx2[1] = 1.8; my[1] = 0;
    mx1[2] = 2.0; mx2[2] = 1.0; my[2] = 0;

    // Class 1: Medium x1, High x2
    mx1[3] = 4.0; mx2[3] = 8.0; my[3] = 1;
    mx1[4] = 4.5; mx2[4] = 8.5; my[4] = 1;
    mx1[5] = 5.0; mx2[5] = 7.8; my[5] = 1;

    // Class 2: High x1, Low x2
    mx1[6] = 8.0; mx2[6] = 2.0; my[6] = 2;
    mx1[7] = 8.5; mx2[7] = 2.5; my[7] = 2;
    mx1[8] = 9.0; mx2[8] = 1.5; my[8] = 2;

    print("--- 2. Training Multinomial Logistic Regression (Softmax) ---");
    let mc_model: MultiClassModel = train_multiclass_logistic(&mx1, &mx2, &my, n_mc, 0.05, 4000);
    print(f"  Categorical Cross-Entropy Loss : {mc_model.loss}");
    print(f"  Training Accuracy              : {mc_model.accuracy * 100.0}%\n");

    // Multi-class Predictions
    let test_c0: int = predict_multiclass_class(&mc_model, 1.2, 1.4);
    let test_c1: int = predict_multiclass_class(&mc_model, 4.8, 8.2);
    let test_c2: int = predict_multiclass_class(&mc_model, 8.8, 2.1);

    print(f"  Sample [1.2, 1.4] -> Predicted Class = {test_c0} (Expected: 0)");
    print(f"  Sample [4.8, 8.2] -> Predicted Class = {test_c1} (Expected: 1)");
    print(f"  Sample [8.8, 2.1] -> Predicted Class = {test_c2} (Expected: 2)\n");

    print("==================================================================");
    print("Logistic Regression & Softmax validation complete with 0 leaks!");
    return 0;
}
