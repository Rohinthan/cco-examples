// Algorithm 46: Stochastic Gradient Descent (SGD) - Online Mini-Batch Updates & Momentum Acceleration

/*
================================================================================
                    STOCHASTIC GRADIENT DESCENT (SGD)
================================================================================

1. The Stochastic Approximation Principle (Robbins & Monro, 1951):
       Full-Batch Gradient Descent requires scanning all N training samples
       before making a single parameter update:
           θ <- θ - (η / N) * Σ_{i=1}^N ∇L_i(θ)   [ O(N) cost per step ]

       In contrast, Stochastic Gradient Descent (SGD) computes updates on
       mini-batches B ⊂ {1, ..., N} of size B << N (or single samples B=1):
           g_t = (1 / |B|) * Σ_{i ∈ B} ∇L_i(θ)
           θ <- θ - η * g_t                       [ O(|B|) cost per step ]

2. Unbiased Expectation & Robbins-Monro Conditions:
       The stochastic mini-batch gradient is an unbiased estimator of the true gradient:
           E_{i ~ Uniform}[ ∇L_i(θ) ] = ∇L(θ)

       Asymptotic convergence to optimal parameters θ* is guaranteed if the
       learning rate schedule satisfies:
           Σ_{t=1}^∞ η_t = ∞    (Can travel arbitrarily far)
           Σ_{t=1}^∞ η_t^2 < ∞  (Variance eventually vanishes to zero)

3. Polyak Momentum Acceleration (Polyak, 1964):
       Stochastic gradients exhibit noisy oscillations. Classical momentum
       accumulates an exponentially decaying velocity vector v:
           v_t = β * v_{t-1} + (1 - β) * g_t
           θ_t = θ_{t-1} - η * v_t
       where β ∈ [0.8, 0.99] dampens high-frequency stochastic jitter and
       accelerates descent along persistent gradient directions.
================================================================================
*/

fn main() -> int {
    print("==================================================================");
    print("   STOCHASTIC GRADIENT DESCENT (SGD): ONLINE MINI-BATCH (v20)     ");
    print("==================================================================\n");

    // Large-scale synthetic streaming dataset: 12 samples, 2 features
    // Target relationship: y = 2.5 * x_0 - 1.5 * x_1 + 4.0
    let n_samples = 12;
    let n_features = 2;

    let x_data = alloc(float, n_samples * n_features);
    let y_data = alloc(float, n_samples);

    x_data[0*2+0]  = 1.0; x_data[0*2+1]  = 0.5; y_data[0]  = 5.75;
    x_data[1*2+0]  = 1.5; x_data[1*2+1]  = 1.0; y_data[1]  = 6.25;
    x_data[2*2+0]  = 2.0; x_data[2*2+1]  = 0.5; y_data[2]  = 8.25;
    x_data[3*2+0]  = 2.5; x_data[3*2+1]  = 2.0; y_data[3]  = 7.25;
    x_data[4*2+0]  = 3.0; x_data[4*2+1]  = 1.5; y_data[4]  = 9.25;
    x_data[5*2+0]  = 3.5; x_data[5*2+1]  = 0.5; y_data[5]  = 12.0;
    x_data[6*2+0]  = 4.0; x_data[6*2+1]  = 2.5; y_data[6]  = 10.25;
    x_data[7*2+0]  = 4.5; x_data[7*2+1]  = 1.0; y_data[7]  = 13.75;
    x_data[8*2+0]  = 5.0; x_data[8*2+1]  = 3.0; y_data[8]  = 12.0;
    x_data[9*2+0]  = 5.5; x_data[9*2+1]  = 2.0; y_data[9]  = 14.75;
    x_data[10*2+0] = 6.0; x_data[10*2+1] = 1.5; y_data[10] = 16.75;
    x_data[11*2+0] = 6.5; x_data[11*2+1] = 3.5; y_data[11] = 15.0;

    print("--- 1. Dataset & Optimization Task ---");
    print("  True Function: y = 2.5 * x_0 - 1.5 * x_1 + 4.0");
    print(f"  Dataset Size : N = {n_samples} samples | Mini-Batch Size |B| = 3 samples\n");

    // =====================================================================
    // Model 1: Full-Batch Gradient Descent (1 update per epoch)
    // =====================================================================
    print("--- 2. Full-Batch Gradient Descent (1 Update / Epoch) ---");
    let w_batch = alloc(float, n_features);
    let b_batch = 0.0;
    w_batch[0] = 0.0; w_batch[1] = 0.0;

    let lr_batch = 0.03;
    let epochs_batch = 400;
    let n_f = 1.0 * n_samples;

    for (let ep = 0; ep < epochs_batch; ep++) {
        let grad_w0 = 0.0;
        let grad_w1 = 0.0;
        let grad_b = 0.0;

        for (let i = 0; i < n_samples; i++) {
            let pred = b_batch + w_batch[0] * x_data[i * 2 + 0] + w_batch[1] * x_data[i * 2 + 1];
            let err = pred - y_data[i];
            grad_b += err;
            grad_w0 += err * x_data[i * 2 + 0];
            grad_w1 += err * x_data[i * 2 + 1];
        }

        b_batch -= lr_batch * (grad_b / n_f);
        w_batch[0] -= lr_batch * (grad_w0 / n_f);
        w_batch[1] -= lr_batch * (grad_w1 / n_f);
    }
    print(f"  Full-Batch GD ({epochs_batch} Updates) -> Weights: [{w_batch[0]}, {w_batch[1]}], Bias: {b_batch}\n");

    // =====================================================================
    // Model 2: Mini-Batch SGD with Polyak Momentum (4 updates per epoch!)
    // =====================================================================
    print("--- 3. Mini-Batch SGD with Momentum (Batch Size = 3, 4 Updates / Epoch) ---");
    let w_sgd = alloc(float, n_features);
    let b_sgd = 0.0;
    w_sgd[0] = 0.0; w_sgd[1] = 0.0;

    // Velocity vectors for momentum
    let v_w0 = 0.0;
    let v_w1 = 0.0;
    let v_b = 0.0;
    let beta = 0.80; // Momentum factor

    let batch_size = 3;
    let num_batches = n_samples / batch_size; // 4 mini-batches per epoch
    let epochs_sgd = 100;
    let lr_sgd = 0.03;

    for (let ep = 0; ep < epochs_sgd; ep++) {
        // Robbins-Monro learning rate decay
        let lr_curr = lr_sgd / (1.0 + 0.002 * (1.0 * ep));

        for (let b = 0; b < num_batches; b++) {
            let start_idx = b * batch_size;
            let mb_grad_w0 = 0.0;
            let mb_grad_w1 = 0.0;
            let mb_grad_b = 0.0;

            for (let k = 0; k < batch_size; k++) {
                let idx = start_idx + k;
                let pred = b_sgd + w_sgd[0] * x_data[idx * 2 + 0] + w_sgd[1] * x_data[idx * 2 + 1];
                let err = pred - y_data[idx];
                mb_grad_b += err;
                mb_grad_w0 += err * x_data[idx * 2 + 0];
                mb_grad_w1 += err * x_data[idx * 2 + 1];
            }

            let b_f = 1.0 * batch_size;
            let g_b = mb_grad_b / b_f;
            let g_w0 = mb_grad_w0 / b_f;
            let g_w1 = mb_grad_w1 / b_f;

            // Update momentum velocity: v = β*v + (1-β)*g
            v_b = beta * v_b + (1.0 - beta) * g_b;
            v_w0 = beta * v_w0 + (1.0 - beta) * g_w0;
            v_w1 = beta * v_w1 + (1.0 - beta) * g_w1;

            // Parameter step
            b_sgd -= lr_curr * v_b;
            w_sgd[0] -= lr_curr * v_w0;
            w_sgd[1] -= lr_curr * v_w1;
        }

        if (ep == 0 || (ep + 1) % 25 == 0 || ep == epochs_sgd - 1) {
            // Compute full epoch MSE
            let epoch_mse = 0.0;
            for (let i = 0; i < n_samples; i++) {
                let p = b_sgd + w_sgd[0] * x_data[i * 2 + 0] + w_sgd[1] * x_data[i * 2 + 1];
                let diff = p - y_data[i];
                epoch_mse += diff * diff;
            }
            epoch_mse /= (2.0 * n_f);
            print(f"  Epoch #{ep + 1}: MSE = {epoch_mse} | Weights: [{w_sgd[0]}, {w_sgd[1]}], Bias: {b_sgd}");
        }
    }
    print("");

    // --- 4. Prediction on Unseen Test Query ---
    print("--- 4. Generalization Test on Unseen Sample: x_test = [3.2, 1.8] ---");
    let tx0 = 3.2;
    let tx1 = 1.8;
    let true_y = 2.5 * tx0 - 1.5 * tx1 + 4.0; // 2.5*3.2 - 1.5*1.8 + 4 = 8.0 - 2.7 + 4 = 9.3

    let pred_sgd = b_sgd + w_sgd[0] * tx0 + w_sgd[1] * tx1;
    let err_diff = pred_sgd - true_y;
    if (err_diff < 0.0) { err_diff = -err_diff; }

    print(f"  Ground Truth y_target : {true_y}");
    print(f"  SGD Model Prediction  : {pred_sgd} (Error: {err_diff})\n");

    if (err_diff < 0.25) {
        print("  SUCCESS: Mini-Batch SGD with Momentum converged rapidly to optimal parameters!\n");
    }

    print("==================================================================");
    print("Stochastic Gradient Descent (SGD) verified with 0 memory leaks!");
    return 0;
}
