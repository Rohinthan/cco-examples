// Algorithm 4: Naive Bayes Classifiers (Gaussian, Multinomial, and Bernoulli Variants)

/*
================================================================================
                       NAIVE BAYES CLASSIFICATION SUITE
================================================================================

1. Bayes' Theorem for Classification:
       P(C_k | x) = [ P(C_k) * P(x | C_k) ] / P(x)
       ŷ = argmax_{k} [ ln(P(C_k)) + Σ_{j=1}^D ln(P(x_j | C_k)) ]

2. Gaussian Naive Bayes (Continuous Features):
       P(x_j | C_k) = ( 1 / √(2π * σ_{kj}²) ) * exp( -(x_j - μ_{kj})² / (2 * σ_{kj}²) )
       ln(P(x_j | C_k)) = - (1/2) * ln(2π * σ_{kj}²) - (x_j - μ_{kj})² / (2 * σ_{kj}²)

3. Multinomial Naive Bayes (Bag-of-Words / Token Counts):
       P(x_j | C_k) = ( N_{kj} + α ) / ( N_k + α * |V| )
       where N_{kj} is count of feature j in class k, |V| is vocabulary size, α = 1 (Laplace)

4. Bernoulli Naive Bayes (Binary Boolean Indicators):
       P(x_j | C_k) = p_{kj}^{x_j} * (1 - p_{kj})^{(1 - x_j)}
       with Laplace smoothing: p_{kj} = ( N_{kj} + 1 ) / ( N_k + 2 )
================================================================================
*/

// ============================================================================
// 1. GAUSSIAN NAIVE BAYES (Continuous Features)
// ============================================================================
struct GaussianNBModel {
    prior0: float; prior1: float;
    mean0_1: float; mean0_2: float;
    var0_1: float;  var0_2: float;
    mean1_1: float; mean1_2: float;
    var1_1: float;  var1_2: float;
}

fn gaussian_log_prob(x: float, mean: float, var: float) -> float {
    let pi = 3.141592653589793;
    let eps = 0.00001;
    let safe_var = var + eps;
    let diff = x - mean;
    let exponent = -(diff * diff) / (2.0 * safe_var);
    let log_coeff = -0.5 * log(2.0 * pi * safe_var);
    return log_coeff + exponent;
}

fn train_gaussian_nb(x1: &float[], x2: &float[], y: &int[], n: int) -> GaussianNBModel {
    let count0 = 0;
    let count1 = 0;
    let sum0_1 = 0.0; let sum0_2 = 0.0;
    let sum1_1 = 0.0; let sum1_2 = 0.0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            count0++;
            sum0_1 += x1[i];
            sum0_2 += x2[i];
        } else {
            count1++;
            sum1_1 += x1[i];
            sum1_2 += x2[i];
        }
    }

    let n_f = 1.0 * n;
    let prior0 = (1.0 * count0) / n_f;
    let prior1 = (1.0 * count1) / n_f;

    let m0_1 = sum0_1 / (1.0 * count0);
    let m0_2 = sum0_2 / (1.0 * count0);
    let m1_1 = sum1_1 / (1.0 * count1);
    let m1_2 = sum1_2 / (1.0 * count1);

    // Compute Variances
    let v_sum0_1 = 0.0; let v_sum0_2 = 0.0;
    let v_sum1_1 = 0.0; let v_sum1_2 = 0.0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            let d1 = x1[i] - m0_1;
            let d2 = x2[i] - m0_2;
            v_sum0_1 += d1 * d1;
            v_sum0_2 += d2 * d2;
        } else {
            let d1 = x1[i] - m1_1;
            let d2 = x2[i] - m1_2;
            v_sum1_1 += d1 * d1;
            v_sum1_2 += d2 * d2;
        }
    }

    let var0_1 = v_sum0_1 / (1.0 * count0);
    let var0_2 = v_sum0_2 / (1.0 * count0);
    let var1_1 = v_sum1_1 / (1.0 * count1);
    let var1_2 = v_sum1_2 / (1.0 * count1);

    return GaussianNBModel {
        prior0: prior0, prior1: prior1,
        mean0_1: m0_1, mean0_2: m0_2,
        var0_1: var0_1, var0_2: var0_2,
        mean1_1: m1_1, mean1_2: m1_2,
        var1_1: var1_1, var1_2: var1_2
    };
}

fn predict_gaussian_nb(m: &GaussianNBModel, x1_val: float, x2_val: float) -> int {
    let log_posterior0 = log(m.prior0) + gaussian_log_prob(x1_val, m.mean0_1, m.var0_1) + gaussian_log_prob(x2_val, m.mean0_2, m.var0_2);
    let log_posterior1 = log(m.prior1) + gaussian_log_prob(x1_val, m.mean1_1, m.var1_1) + gaussian_log_prob(x2_val, m.mean1_2, m.var1_2);

    if (log_posterior1 > log_posterior0) {
        return 1;
    }
    return 0;
}

// ============================================================================
// 2. MULTINOMIAL NAIVE BAYES (Word / Token Count Features)
// ============================================================================
struct MultinomialNBModel {
    prior0: float; prior1: float;
    log_p0_w0: float; log_p0_w1: float; log_p0_w2: float;
    log_p1_w0: float; log_p1_w1: float; log_p1_w2: float;
}

fn train_multinomial_nb(w0: &int[], w1: &int[], w2: &int[], y: &int[], n: int) -> MultinomialNBModel {
    let count0 = 0; let count1 = 0;
    let total_words0 = 0; let total_words1 = 0;
    let word0_class0 = 0; let word1_class0 = 0; let word2_class0 = 0;
    let word0_class1 = 0; let word1_class1 = 0; let word2_class1 = 0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            count0++;
            word0_class0 += w0[i];
            word1_class0 += w1[i];
            word2_class0 += w2[i];
            total_words0 += w0[i] + w1[i] + w2[i];
        } else {
            count1++;
            word0_class1 += w0[i];
            word1_class1 += w1[i];
            word2_class1 += w2[i];
            total_words1 += w0[i] + w1[i] + w2[i];
        }
    }

    let n_f = 1.0 * n;
    let prior0 = (1.0 * count0) / n_f;
    let prior1 = (1.0 * count1) / n_f;

    let vocab_size = 3.0;
    let denom0 = (1.0 * total_words0) + vocab_size;
    let denom1 = (1.0 * total_words1) + vocab_size;

    let lp0_0 = log(((1.0 * word0_class0) + 1.0) / denom0);
    let lp0_1 = log(((1.0 * word1_class0) + 1.0) / denom0);
    let lp0_2 = log(((1.0 * word2_class0) + 1.0) / denom0);

    let lp1_0 = log(((1.0 * word0_class1) + 1.0) / denom1);
    let lp1_1 = log(((1.0 * word1_class1) + 1.0) / denom1);
    let lp1_2 = log(((1.0 * word2_class1) + 1.0) / denom1);

    return MultinomialNBModel {
        prior0: prior0, prior1: prior1,
        log_p0_w0: lp0_0, log_p0_w1: lp0_1, log_p0_w2: lp0_2,
        log_p1_w0: lp1_0, log_p1_w1: lp1_1, log_p1_w2: lp1_2
    };
}

fn predict_multinomial_nb(m: &MultinomialNBModel, w0_cnt: int, w1_cnt: int, w2_cnt: int) -> int {
    let log_posterior0 = log(m.prior0) + (1.0 * w0_cnt) * m.log_p0_w0 + (1.0 * w1_cnt) * m.log_p0_w1 + (1.0 * w2_cnt) * m.log_p0_w2;
    let log_posterior1 = log(m.prior1) + (1.0 * w0_cnt) * m.log_p1_w0 + (1.0 * w1_cnt) * m.log_p1_w1 + (1.0 * w2_cnt) * m.log_p1_w2;

    if (log_posterior1 > log_posterior0) {
        return 1;
    }
    return 0;
}

// ============================================================================
// 3. BERNOULLI NAIVE BAYES (Binary Indicator Features)
// ============================================================================
struct BernoulliNBModel {
    prior0: float; prior1: float;
    p0_f0: float; p0_f1: float; p0_f2: float;
    p1_f0: float; p1_f1: float; p1_f2: float;
}

fn train_bernoulli_nb(f0: &int[], f1: &int[], f2: &int[], y: &int[], n: int) -> BernoulliNBModel {
    let count0 = 0; let count1 = 0;
    let sum0_0 = 0; let sum0_1 = 0; let sum0_2 = 0;
    let sum1_0 = 0; let sum1_1 = 0; let sum1_2 = 0;

    for (let i = 0; i < n; i++) {
        if (y[i] == 0) {
            count0++;
            sum0_0 += f0[i]; sum0_1 += f1[i]; sum0_2 += f2[i];
        } else {
            count1++;
            sum1_0 += f0[i]; sum1_1 += f1[i]; sum1_2 += f2[i];
        }
    }

    let n_f = 1.0 * n;
    let prior0 = (1.0 * count0) / n_f;
    let prior1 = (1.0 * count1) / n_f;

    let p0_0 = ((1.0 * sum0_0) + 1.0) / ((1.0 * count0) + 2.0);
    let p0_1 = ((1.0 * sum0_1) + 1.0) / ((1.0 * count0) + 2.0);
    let p0_2 = ((1.0 * sum0_2) + 1.0) / ((1.0 * count0) + 2.0);

    let p1_0 = ((1.0 * sum1_0) + 1.0) / ((1.0 * count1) + 2.0);
    let p1_1 = ((1.0 * sum1_1) + 1.0) / ((1.0 * count1) + 2.0);
    let p1_2 = ((1.0 * sum1_2) + 1.0) / ((1.0 * count1) + 2.0);

    return BernoulliNBModel {
        prior0: prior0, prior1: prior1,
        p0_f0: p0_0, p0_f1: p0_1, p0_f2: p0_2,
        p1_f0: p1_0, p1_f1: p1_1, p1_f2: p1_2
    };
}

fn bernoulli_feature_log_prob(x: int, p: float) -> float {
    if (x == 1) {
        return log(p);
    }
    return log(1.0 - p);
}

fn predict_bernoulli_nb(m: &BernoulliNBModel, f0_val: int, f1_val: int, f2_val: int) -> int {
    let log_posterior0 = log(m.prior0) + bernoulli_feature_log_prob(f0_val, m.p0_f0) + bernoulli_feature_log_prob(f1_val, m.p0_f1) + bernoulli_feature_log_prob(f2_val, m.p0_f2);
    let log_posterior1 = log(m.prior1) + bernoulli_feature_log_prob(f0_val, m.p1_f0) + bernoulli_feature_log_prob(f1_val, m.p1_f1) + bernoulli_feature_log_prob(f2_val, m.p1_f2);

    if (log_posterior1 > log_posterior0) {
        return 1;
    }
    return 0;
}

fn main() -> int {
    print("==================================================================");
    print("   NAIVE BAYES PROBABILISTIC CLASSIFICATION SUITE (Cco-v20)       ");
    print("==================================================================\n");

    // 1. GAUSSIAN NAIVE BAYES TEST
    let gn = 6;
    let gx1 = alloc(float, gn);
    let gx2 = alloc(float, gn);
    let gy = alloc(int, gn);

    // Class 0: centered around (2.0, 2.0)
    gx1[0] = 1.8; gx2[0] = 2.1; gy[0] = 0;
    gx1[1] = 2.2; gx2[1] = 1.9; gy[1] = 0;
    gx1[2] = 2.0; gx2[2] = 2.0; gy[2] = 0;
    // Class 1: centered around (7.0, 7.0)
    gx1[3] = 6.9; gx2[3] = 7.1; gy[3] = 1;
    gx1[4] = 7.2; gx2[4] = 6.8; gy[4] = 1;
    gx1[5] = 7.0; gx2[5] = 7.0; gy[5] = 1;

    print("--- 1. Gaussian Naive Bayes (Continuous Features) ---");
    let g_model = train_gaussian_nb(&gx1, &gx2, &gy, gn);
    print(f"  Class 0 Mean: ({g_model.mean0_1}, {g_model.mean0_2}), Variance: ({g_model.var0_1}, {g_model.var0_2})");
    print(f"  Class 1 Mean: ({g_model.mean1_1}, {g_model.mean1_2}), Variance: ({g_model.var1_1}, {g_model.var1_2})");

    let g_pred0 = predict_gaussian_nb(&g_model, 2.1, 1.8);
    let g_pred1 = predict_gaussian_nb(&g_model, 7.1, 6.9);
    print(f"  Sample (2.1, 1.8) -> Predicted Class: {g_pred0} (Expected: 0)");
    print(f"  Sample (7.1, 6.9) -> Predicted Class: {g_pred1} (Expected: 1)\n");

    // 2. MULTINOMIAL NAIVE BAYES TEST (Document Classification)
    let mn = 6;
    let mw0 = alloc(int, mn); // "buy"
    let mw1 = alloc(int, mn); // "meeting"
    let mw2 = alloc(int, mn); // "money"
    let my = alloc(int, mn);  // 0: Ham, 1: Spam

    // Ham documents
    mw0[0] = 0; mw1[0] = 3; mw2[0] = 0; my[0] = 0;
    mw0[1] = 1; mw1[1] = 4; mw2[1] = 0; my[1] = 0;
    mw0[2] = 0; mw1[2] = 2; mw2[2] = 1; my[2] = 0;
    // Spam documents
    mw0[3] = 4; mw1[3] = 0; mw2[3] = 3; my[3] = 1;
    mw0[4] = 5; mw1[4] = 1; mw2[4] = 4; my[4] = 1;
    mw0[5] = 3; mw1[5] = 0; mw2[5] = 5; my[5] = 1;

    print("--- 2. Multinomial Naive Bayes (Spam vs Ham Word Counts) ---");
    let m_model = train_multinomial_nb(&mw0, &mw1, &mw2, &my, mn);
    let m_pred_ham = predict_multinomial_nb(&m_model, 0, 3, 0); // "meeting meeting meeting"
    let m_pred_spam = predict_multinomial_nb(&m_model, 4, 0, 2); // "buy buy buy buy money money"
    print(f"  Doc ['meeting', 'meeting', 'meeting'] -> Prediction: {m_pred_ham} (0: Ham)");
    print(f"  Doc ['buy', 'buy', 'buy', 'buy', 'money', 'money'] -> Prediction: {m_pred_spam} (1: Spam)\n");

    // 3. BERNOULLI NAIVE BAYES TEST (Binary Flags Risk Model)
    let bn = 6;
    let bf0 = alloc(int, bn);
    let bf1 = alloc(int, bn);
    let bf2 = alloc(int, bn);
    let by = alloc(int, bn);

    // Low Risk: [0, 0, 0], [0, 1, 0], [1, 0, 0]
    bf0[0] = 0; bf1[0] = 0; bf2[0] = 0; by[0] = 0;
    bf0[1] = 0; bf1[1] = 1; bf2[1] = 0; by[0] = 0;
    bf0[2] = 1; bf1[2] = 0; bf2[2] = 0; by[2] = 0;
    // High Risk: [1, 1, 1], [0, 1, 1], [1, 0, 1]
    bf0[3] = 1; bf1[3] = 1; bf2[3] = 1; by[3] = 1;
    bf0[4] = 0; bf1[4] = 1; bf2[4] = 1; by[4] = 1;
    bf0[5] = 1; bf1[5] = 0; bf2[5] = 1; by[5] = 1;

    print("--- 3. Bernoulli Naive Bayes (Binary Boolean Indicator Flags) ---");
    let b_model = train_bernoulli_nb(&bf0, &bf1, &bf2, &by, bn);
    let b_pred_low = predict_bernoulli_nb(&b_model, 0, 0, 0);
    let b_pred_high = predict_bernoulli_nb(&b_model, 1, 1, 1);
    print(f"  Profile [Flag0=0, Flag1=0, Flag2=0] -> Prediction: {b_pred_low} (0: Low Risk)");
    print(f"  Profile [Flag0=1, Flag1=1, Flag2=1] -> Prediction: {b_pred_high} (1: High Risk)\n");

    print("==================================================================");
    print("Naive Bayes (Gaussian, Multinomial, Bernoulli) verified with 0 leaks!");
    return 0;
}
