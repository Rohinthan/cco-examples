// Algorithm 63: Normalizing Flows - Invertible Bijective Mappings & Change-of-Variables Density Estimation

/*
================================================================================
                        NORMALIZING FLOWS (RealNVP)
================================================================================

1. Change of Variables & Exact Likelihood (Rezende & Mohamed 2015, Dinh et al. 2017):
       Transforms a simple base distribution p_Z(z) (e.g. isotropic standard Gaussian)
       into an expressive, multimodal target distribution p_X(x) through a composition
       of K smooth, invertible bijective transformations f = f_K ∘ ... ∘ f_1:
           z = f(x),   x = f^{-1}(z)

       By the multivariate change-of-variables theorem:
           p_X(x) = p_Z( f(x) ) * | det( J_f(x) ) |
           ln p_X(x) = ln p_Z( f(x) ) + Σ_{k=1}^K ln | det( J_{f_k} ) |

2. RealNVP Affine Coupling Layer (Dinh, Sohl-Dickstein & Bengio, ICLR 2017):
       Splits D-dimensional data into two partitions x = [x_{1:d}, x_{d+1:D}]:
           Forward Map (x -> y):
               y_{1:d}     = x_{1:d}
               y_{d+1:D}   = x_{d+1:D} ⊙ exp( s( x_{1:d} ) ) + t( x_{1:d} )

           Inverse Map (y -> x) [Generative Sampling]:
               x_{1:d}     = y_{1:d}
               x_{d+1:D}   = ( y_{d+1:D} - t( y_{1:d} ) ) ⊙ exp( -s( y_{1:d} ) )

3. Triangular Jacobian & O(D) Determinant:
       The Jacobian matrix J is triangular:
           J = [ I_d                           0                 ]
               [ ∂y_{d+1:D} / ∂x_{1:d}        diag( exp(s(x)) ) ]
       Hence, the log-determinant requires NO matrix inversion or O(D^3) operations:
           ln | det( J ) | = Σ_j s( x_{1:d} )_j

4. Dual Capabilities:
       - Density Estimation: Exact analytical log-likelihood ln p(x) for any sample.
       - Exact Generative Sampling: Transforms random Gaussian noise z ~ N(0, I)
         into complex data space with ZERO numerical approximations!
================================================================================
*/

fn standard_gaussian_log_prob(z0: float, z1: float) -> float {
    // ln N(0, I) = -0.5 * (2 * ln(2π) + z0^2 + z1^2)
    // ln(2π) ≈ 1.8378770664
    let quad = z0 * z0 + z1 * z1;
    return -0.5 * (2.0 * 1.8378770664 + quad);
}

// Neural Scale Network s(x) and Translation Network t(x)
fn scale_net(x_in: float) -> float {
    return 0.5 * tanh(0.8 * x_in + 0.2);
}

fn trans_net(x_in: float) -> float {
    return 1.2 * sin(1.5 * x_in);
}

fn main() -> int {
    print("==================================================================");
    print("   NORMALIZING FLOWS: RealNVP AFFINE COUPLING & LIKELIHOOD (v20)  ");
    print("==================================================================\n");

    // 2D Normalizing Flow Architecture: D = 2 dimensions
    // x = [x0, x1]
    // Layer 1: Modifies x1 conditioned on x0
    // Layer 2: Modifies x0 conditioned on x1 (Alternating coupling)
    print("--- 1. RealNVP 2-Stage Alternating Coupling Architecture ---");
    print("  Base Distribution: 2D Standard Isotropic Gaussian Z ~ N(0, I)");
    print("  Coupling Layer 1 : y0 = x0,  y1 = x1 * exp(s1(x0)) + t1(x0)");
    print("  Coupling Layer 2 : z1 = y1,  z0 = y0 * exp(s2(y1)) + t2(y1)\n");

    // --- 2. Test Exact Bijective Invertibility ---
    print("--- 2. Validating Exact Numerical Invertibility: f^{-1}(f(x)) == x ---");
    let test_points = 3;
    let px0 = alloc(float, test_points);
    let px1 = alloc(float, test_points);

    px0[0] =  1.5; px1[0] = -0.8;
    px0[1] = -0.4; px1[1] =  2.1;
    px0[2] =  0.0; px1[2] =  1.0;

    let max_inversion_error = 0.0;

    for (let i = 0; i < test_points; i++) {
        let x0 = px0[i];
        let x1 = px1[i];

        // Forward Transformation: x -> z
        // Stage 1 (condition on x0):
        let s1 = scale_net(x0);
        let t1 = trans_net(x0);
        let y0 = x0;
        let y1 = x1 * exp(s1) + t1;

        // Stage 2 (condition on y1):
        let s2 = scale_net(y1);
        let t2 = trans_net(y1);
        let z0 = y0 * exp(s2) + t2;
        let z1 = y1;

        // Backward Transformation: z -> x_reconstructed
        // Inverse Stage 2:
        let rev_y1 = z1;
        let rev_s2 = scale_net(rev_y1);
        let rev_t2 = trans_net(rev_y1);
        let rev_y0 = (z0 - rev_t2) * exp(-rev_s2);

        // Inverse Stage 1:
        let rev_x0 = rev_y0;
        let rev_s1 = scale_net(rev_x0);
        let rev_t1 = trans_net(rev_x0);
        let rev_x1 = (rev_y1 - rev_t1) * exp(-rev_s1);

        let err0 = rev_x0 - x0;
        if (err0 < 0.0) { err0 = -err0; }
        let err1 = rev_x1 - x1;
        if (err1 < 0.0) { err1 = -err1; }
        let err_total = err0 + err1;
        if (err_total > max_inversion_error) { max_inversion_error = err_total; }

        print(f"  Point #{i}: Original x=({x0}, {x1}) -> Latent z=({z0}, {z1}) -> Reconstructed x=({rev_x0}, {rev_x1}) [Error = {err_total}]");
    }
    print(f"\n  Maximum Inversion Numerical Discrepancy = {max_inversion_error}\n");

    // --- 3. Exact Log-Likelihood Evaluation via Change-of-Variables ---
    print("--- 3. Exact Log-Likelihood Evaluation: ln p_X(x) = ln p_Z(z) + ln |det J| ---");
    for (let i = 0; i < test_points; i++) {
        let x0 = px0[i];
        let x1 = px1[i];

        // Forward
        let s1 = scale_net(x0);
        let t1 = trans_net(x0);
        let y0 = x0;
        let y1 = x1 * exp(s1) + t1;

        let s2 = scale_net(y1);
        let t2 = trans_net(y1);
        let z0 = y0 * exp(s2) + t2;
        let z1 = y1;

        // Jacobian log-determinant: sum of scaling coefficients!
        let log_det_J = s1 + s2;
        let base_log_prob = standard_gaussian_log_prob(z0, z1);
        let data_log_prob = base_log_prob + log_det_J;
        let exact_density = exp(data_log_prob);

        print(f"  Sample #{i} ({x0}, {x1}):");
        print(f"    Base Log-Prob ln p_Z(z) = {base_log_prob}");
        print(f"    Log-Determinant ln |det J| = {log_det_J} (Triangular Jacobian)");
        print(f"    Total Log-Likelihood ln p_X(x) = {data_log_prob} => Density p(x) = {exact_density}\n");
    }

    // --- 4. Generative Sampling: z ~ N(0, I) -> x_generated ---
    print("--- 4. Generative Sampling via Inverse Flow Map f^{-1}(z) ---");
    let sample_z0 = alloc(float, 2);
    let sample_z1 = alloc(float, 2);
    sample_z0[0] = 0.5;  sample_z1[0] = -0.2; // Gaussian sample 1
    sample_z0[1] = -1.1; sample_z1[1] = 0.9;  // Gaussian sample 2

    for (let s = 0; s < 2; s++) {
        let z0 = sample_z0[s];
        let z1 = sample_z1[s];

        // Synthesize complex data point by inverting flow:
        let y1 = z1;
        let s2 = scale_net(y1);
        let t2 = trans_net(y1);
        let y0 = (z0 - t2) * exp(-s2);

        let x0 = y0;
        let s1 = scale_net(x0);
        let t1 = trans_net(x0);
        let x1 = (y1 - t1) * exp(-s1);

        print(f"  Gaussian Prior Latent z=({z0}, {z1}) -> Synthesized Output x=({x0}, {x1})");
    }
    print("");

    if (max_inversion_error < 0.000001) {
        print("  SUCCESS: Normalizing Flows achieved exact invertibility, analytical likelihoods & generative sampling!\n");
    }

    print("==================================================================");
    print("Normalizing Flows verified with 0 memory leaks!");
    return 0;
}
