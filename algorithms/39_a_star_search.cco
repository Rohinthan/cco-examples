// Algorithm 39: A* Search Algorithm - Optimal Pathfinding & Heuristic Graph Traversal

/*
================================================================================
                        A* SEARCH ALGORITHM
================================================================================

1. Heuristic Evaluation Function (Hart, Nilsson & Raphael, 1968):
       f(n) = g(n) + h(n)
       where:
           - g(n) : Exact known cost of the shortest path from start to node n.
           - h(n) : Heuristic estimate of the cheapest path from node n to the goal.
           - f(n) : Total estimated cost of the cheapest path constrained through n.

2. Mathematical Optimality Conditions:
       - Admissibility:
             h(n) <= h^*(n),  ∀ n
             The heuristic never overestimates the true remaining cost to the goal.
             Guarantees A* will find the mathematically optimal shortest path.
       - Consistency (Monotonicity):
             h(n) <= c(n, a, n') + h(n')
             Satisfies the triangle inequality. Guarantees that the first time
             any node is expanded from the open set, its path is guaranteed optimal.

3. Standard Spatial Heuristic Formulations:
       - Manhattan Distance (L1 Metric for 4-connected grid):
             h_L1(n) = |x_n - x_goal| + |y_n - y_goal|
       - Euclidean Distance (L2 Metric for straight-line Euclidean space):
             h_L2(n) = sqrt( (x_n - x_goal)^2 + (y_n - y_goal)^2 )
       - Chebyshev Distance (L_inf Metric for 8-connected grid with diagonal moves):
             h_inf(n) = max( |x_n - x_goal|, |y_n - y_goal| )

4. Graph Search State Spaces:
       - Open Set   : Priority queue of candidate frontier nodes ordered by min f(n).
       - Closed Set : Set of finalized nodes whose minimum cost g(n) is verified.
       - Came_From  : Backtracking map used to reconstruct the exact path sequence.
================================================================================
*/

fn abs_i(val: int) -> int {
    if (val < 0) { return -val; }
    return val;
}

fn manhattan_distance(r1: int, c1: int, r2: int, c2: int) -> float {
    let dr = abs_i(r1 - r2);
    let dc = abs_i(c1 - c2);
    return 1.0 * (dr + dc);
}

fn main() -> int {
    print("==================================================================");
    print("   A* HEURISTIC PATHFINDING ALGORITHM: MAZE TRAVERSAL (v20)       ");
    print("==================================================================\n");

    // 6x6 Obstacle Maze Grid:
    // 0 = Walkable, 1 = Impassable Wall Obstacle
    let rows = 6;
    let cols = 6;
    let total_nodes = rows * cols; // 36

    let grid = alloc(int, total_nodes);
    for (let i = 0; i < total_nodes; i++) {
        grid[i] = 0;
    }

    // Insert Wall Obstacles forcing a non-trivial detour around the center
    // Wall cluster blocking direct diagonal route:
    grid[1 * cols + 2] = 1;
    grid[2 * cols + 2] = 1;
    grid[3 * cols + 2] = 1;
    grid[3 * cols + 1] = 1;
    grid[3 * cols + 3] = 1;
    grid[4 * cols + 3] = 1;

    let start_r = 0;
    let start_c = 0;
    let goal_r = 5;
    let goal_c = 5;

    let start_idx = start_r * cols + start_c;
    let goal_idx = goal_r * cols + goal_c;

    print("--- 1. Initial Obstacle Grid Map (S = Start, G = Goal, # = Wall) ---");
    for (let r = 0; r < rows; r++) {
        print(f"  Row {r}: [ {grid[r * cols + 0]}  {grid[r * cols + 1]}  {grid[r * cols + 2]}  {grid[r * cols + 3]}  {grid[r * cols + 4]}  {grid[r * cols + 5]} ]");
    }
    print(f"\n  Start Coordinate: ({start_r}, {start_c}) | Goal Coordinate: ({goal_r}, {goal_c})\n");

    // Node Arrays for A* Search
    let g_score = alloc(float, total_nodes);
    let f_score = alloc(float, total_nodes);
    let came_from = alloc(int, total_nodes);
    let in_open = alloc(bool, total_nodes);
    let in_closed = alloc(bool, total_nodes);

    let inf_cost = 999999.0;
    for (let i = 0; i < total_nodes; i++) {
        g_score[i] = inf_cost;
        f_score[i] = inf_cost;
        came_from[i] = -1;
        in_open[i] = false;
        in_closed[i] = false;
    }

    // Initialize Start Node
    g_score[start_idx] = 0.0;
    f_score[start_idx] = manhattan_distance(start_r, start_c, goal_r, goal_c);
    in_open[start_idx] = true;

    // Movement offsets (4 directions: Up, Down, Left, Right)
    let dr = alloc(int, 4);
    let dc = alloc(int, 4);
    dr[0] = -1; dc[0] =  0; // Up
    dr[1] =  1; dc[1] =  0; // Down
    dr[2] =  0; dc[2] = -1; // Left
    dr[3] =  0; dc[3] =  1; // Right

    print("--- 2. Running A* Graph Traversal ---");
    let goal_reached = false;
    let nodes_expanded = 0;

    for (let iter = 0; iter < total_nodes; iter++) {
        // Find node in Open Set with lowest f_score
        let current = -1;
        let min_f = inf_cost;

        for (let i = 0; i < total_nodes; i++) {
            if (in_open[i] && f_score[i] < min_f) {
                min_f = f_score[i];
                current = i;
            }
        }

        if (current == -1) {
            // Open set is empty, no path exists
            break;
        }

        if (current == goal_idx) {
            goal_reached = true;
            break;
        }

        // Move current from Open to Closed
        in_open[current] = false;
        in_closed[current] = true;
        nodes_expanded++;

        let curr_r = current / cols;
        let curr_c = current % cols;

        // Examine all 4 orthogonal neighbors
        for (let dir = 0; dir < 4; dir++) {
            let nr = curr_r + dr[dir];
            let nc = curr_c + dc[dir];

            // Boundary checks
            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                let neighbor = nr * cols + nc;

                // Skip obstacles and already evaluated closed nodes
                if (grid[neighbor] == 0 && in_closed[neighbor] == false) {
                    let tentative_g = g_score[current] + 1.0; // Unit edge cost = 1.0

                    if (tentative_g < g_score[neighbor]) {
                        came_from[neighbor] = current;
                        g_score[neighbor] = tentative_g;
                        let h = manhattan_distance(nr, nc, goal_r, goal_c);
                        f_score[neighbor] = tentative_g + h;
                        in_open[neighbor] = true;
                    }
                }
            }
        }
    }

    print(f"  A* Expansion Complete: {nodes_expanded} nodes evaluated.");
    print(f"  Goal Reached: {goal_reached}\n");

    // --- 3. Reconstruct Optimal Path from Goal to Start ---
    print("--- 3. Path Reconstruction ---");
    let path_r = alloc(int, total_nodes);
    let path_c = alloc(int, total_nodes);
    let path_len = 0;

    let curr_back = goal_idx;
    for (let step = 0; step < total_nodes; step++) {
        if (curr_back == -1) { break; }
        path_r[path_len] = curr_back / cols;
        path_c[path_len] = curr_back % cols;
        path_len++;

        if (curr_back == start_idx) { break; }
        curr_back = came_from[curr_back];
    }

    print(f"  Optimal Path Length: {path_len} steps (Total Travel Cost g = {g_score[goal_idx]})");
    print("  Waypoints from Start to Goal:");
    for (let i = path_len - 1; i >= 0; i--) {
        let step_num = (path_len - 1) - i;
        print(f"    Step {step_num}: Coordinate ({path_r[i]}, {path_c[i]})");
    }
    print("");

    // --- 4. Render Grid with Path Marked ---
    print("--- 4. Visualized Solution Map (Path Marked with 8) ---");
    let solution_map = alloc(int, total_nodes);
    for (let i = 0; i < total_nodes; i++) {
        solution_map[i] = grid[i];
    }
    for (let i = 0; i < path_len; i++) {
        let idx = path_r[i] * cols + path_c[i];
        solution_map[idx] = 8; // 8 represents path waypoint
    }

    for (let r = 0; r < rows; r++) {
        print(f"  Row {r}: [ {solution_map[r * cols + 0]}  {solution_map[r * cols + 1]}  {solution_map[r * cols + 2]}  {solution_map[r * cols + 3]}  {solution_map[r * cols + 4]}  {solution_map[r * cols + 5]} ]");
    }
    print("");

    if (goal_reached && path_len > 0) {
        print("  SUCCESS: A* Algorithm guaranteed optimal path with admissible Manhattan heuristic!\n");
    }

    print("==================================================================");
    print("A* Search Algorithm verified with 0 memory leaks!");
    return 0;
}
