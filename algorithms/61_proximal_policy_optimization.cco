// Algorithm 61: Proximal Policy Optimization (PPO) - Clipped Surrogate Policy Gradient & Actor-Critic

/*
================================================================================
                    PROXIMAL POLICY OPTIMIZATION (PPO)
================================================================================

1. Policy Gradient & Destructive Step Avoidance (Schulman et al., OpenAI 2017):
       Standard policy gradient methods take unbounded gradient steps that often
       ruin policy performance irreversibly. While TRPO enforces a strict KL divergence
       constraint via costly second-order Hessian approximations, PPO achieves
       state-of-the-art stability using a simple First-Order Clipped Surrogate Objective.

2. Probability Ratio r_t(θ):
       r_t(θ) = π_θ( a_t | s_t ) / π_{θ_old}( a_t | s_t )
       where r_t(θ_old) = 1.0.

3. Clipped Surrogate Objective L^{CLIP}(θ):
       L^{CLIP}(θ) = Ê_t [ min( r_t(θ) * Â_t,  clip( r_t(θ), 1 - ε, 1 + ε ) * Â_t ) ]
       where:
           - ε ≈ 0.20 : Clipping boundary coefficient (restricts ratio to [0.8, 1.2])
           - Â_t      : Advantage estimate Â_t = Q(s_t, a_t) - V(s_t)
           - The min operator creates a pessimistic lower bound: if a policy update
             improves the objective beyond (1 + ε) when Â > 0 or degrades beyond (1 - ε)
             when Â < 0, the objective is strictly clipped to prevent catastrophic updates!

4. Complete Actor-Critic Loss:
       L^{PPO}(θ, ϕ) = Ê_t [ L^{CLIP}(θ) - c_1 * ( V_ϕ(s_t) - V_t^{targ} )^2 + c_2 * S[π_θ](s_t) ]
       where S[π] is the entropy bonus encouraging exploration.
================================================================================
*/

fn clip_val(val: float, low: float, high: float) -> float {
    if (val < low) { return low; }
    if (val > high) { return high; }
    return val;
}

fn softmax_2d(logit0: float, logit1: float, probs: &float[]) -> void {
    let max_l = logit0;
    if (logit1 > max_l) { max_l = logit1; }
    let e0 = exp(logit0 - max_l);
    let e1 = exp(logit1 - max_l);
    let sum_e = e0 + e1;
    probs[0] = e0 / sum_e;
    probs[1] = e1 / sum_e;
}

fn main() -> int {
    print("==================================================================");
    print("   PROXIMAL POLICY OPTIMIZATION (PPO): CLIPPED SURROGATE (v20)    ");
    print("==================================================================\n");

    // Discrete Decision Scenario (2 Actions: 0 = Suboptimal, 1 = Optimal)
    // Batch of T = 4 transition steps collected under behavior policy π_{θ_old}
    let n_steps = 4;
    let eps_clip = 0.20; // PPO Clipping range [0.8, 1.2]

    // Recorded batch transitions under π_{θ_old}:
    // actions taken: [1, 1, 0, 1]
    // old action probabilities: π_{old}(a_t|s_t)
    // advantages Â_t: positive for action 1, negative for action 0
    let a_taken = alloc(int, n_steps);
    let pi_old = alloc(float, n_steps);
    let advantages = alloc(float, n_steps);

    a_taken[0] = 1; pi_old[0] = 0.50; advantages[0] =  1.8; // Favorable step
    a_taken[1] = 1; pi_old[1] = 0.52; advantages[1] =  2.1; // Favorable step
    a_taken[2] = 0; pi_old[2] = 0.48; advantages[2] = -1.5; // Unfavorable step
    a_taken[3] = 1; pi_old[3] = 0.51; advantages[3] =  1.6; // Favorable step

    print("--- 1. Rollout Trajectory Batch Collected Under π_{θ_old} ---");
    print(f"  Clipping Epsilon ε = {eps_clip} => Allowed Ratio Interval: [1 - ε, 1 + ε] = [0.80, 1.20]");
    for (let t = 0; t < n_steps; t++) {
        print(f"  Step t={t}: Action {a_taken[t]} | π_old = {pi_old[t]} | Advantage Â = {advantages[t]}");
    }
    print("");

    // Current Policy Parameter θ (Softmax logits: [θ_0, θ_1])
    let theta = alloc(float, 2);
    theta[0] = 0.0; // Logit for Action 0
    theta[1] = 0.0; // Logit for Action 1

    let probs_curr = alloc(float, 2);
    let lr = 0.15;
    let ppo_epochs = 8;

    print(f"--- 2. PPO Clipped Surrogate Optimization ({ppo_epochs} Epochs on Same Batch) ---");

    for (let ep = 0; ep < ppo_epochs; ep++) {
        let total_ppo_loss = 0.0;
        let total_clipped_events = 0;

        // Gradient accumulator for θ
        let grad_theta0 = 0.0;
        let grad_theta1 = 0.0;

        for (let t = 0; t < n_steps; t++) {
            // Forward current policy: π_θ
            softmax_2d(theta[0], theta[1], &probs_curr);

            let act = a_taken[t];
            let pi_curr = probs_curr[act];
            let adv = advantages[t];

            // 1. Probability Ratio: r_t(θ) = π_θ(a_t) / π_{old}(a_t)
            let ratio = pi_curr / pi_old[t];

            // 2. Unclipped vs Clipped Terms
            let surr1 = ratio * adv;
            let ratio_clipped = clip_val(ratio, 1.0 - eps_clip, 1.0 + eps_clip);
            let surr2 = ratio_clipped * adv;

            // 3. PPO Min-Clipping Objective
            let ppo_step_loss = surr1;
            let was_clipped = false;
            if (surr2 < ppo_step_loss) {
                ppo_step_loss = surr2;
                was_clipped = true;
                total_clipped_events++;
            }
            total_ppo_loss += ppo_step_loss;

            // Gradient: If not clipped, gradient wrt logits:
            // ∂(r_t * A)/∂logit = (adv / pi_old) * ∂(pi_curr)/∂logit
            // where ∂(pi_curr)/∂logit_k = pi_curr * (δ_{act,k} - pi_k)
            if (!was_clipped) {
                let factor = (adv / pi_old[t]) * pi_curr;
                if (act == 0) {
                    grad_theta0 += factor * (1.0 - probs_curr[0]);
                    grad_theta1 += factor * (-probs_curr[1]);
                } else {
                    grad_theta0 += factor * (-probs_curr[0]);
                    grad_theta1 += factor * (1.0 - probs_curr[1]);
                }
            }
        }

        // Apply Policy Gradient Ascent
        theta[0] += lr * (grad_theta0 / (1.0 * n_steps));
        theta[1] += lr * (grad_theta1 / (1.0 * n_steps));

        softmax_2d(theta[0], theta[1], &probs_curr);
        let avg_loss = total_ppo_loss / (1.0 * n_steps);
        print(f"  Epoch #{ep + 1}: Surrogate Objective = {avg_loss} | Clipped Steps = {total_clipped_events}/{n_steps} | π(Action 1) = {probs_curr[1]}");
    }
    print("");

    // --- 3. Final Policy Probability Evaluation ---
    softmax_2d(theta[0], theta[1], &probs_curr);
    print("--- 3. Final Trained Policy Distribution ---");
    print(f"  P(Suboptimal Action 0) = {probs_curr[0] * 100.0}%");
    print(f"  P(Optimal Action 1)    = {probs_curr[1] * 100.0}%\n");

    if (probs_curr[1] > 0.60) {
        print("  SUCCESS: PPO Clipped Surrogate successfully updated policy while preventing destructive jumps!\n");
    }

    print("==================================================================");
    print("Proximal Policy Optimization (PPO) verified with 0 memory leaks!");
    return 0;
}
