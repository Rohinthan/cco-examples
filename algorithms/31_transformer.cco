// Algorithm 31: Transformers - Multi-Head Self-Attention, Positional Encoding & Causal Masking

/*
================================================================================
                    TRANSFORMER ARCHITECTURE & SELF-ATTENTION
================================================================================

1. Scaled Dot-Product Attention (Vaswani et al., 2017):
       Attention(Q, K, V) = Softmax( (Q * K^T) / sqrt(d_k) + M ) * V
       where:
           Q = X * W_Q ∈ R^{T x d_k}  (Queries: What information is sought?)
           K = X * W_K ∈ R^{T x d_k}  (Keys: What information is offered?)
           V = X * W_V ∈ R^{T x d_v}  (Values: What content is communicated?)
           M ∈ R^{T x T}              (Attention Mask)
           1 / sqrt(d_k)              (Scaling factor preventing vanishing softmax gradients)

2. Multi-Head Attention (MHA):
       MultiHead(Q, K, V) = Concat(head_1, ..., head_h) * W_O
       head_m = Attention( Q * W_m^Q,  K * W_m^K,  V * W_m^V )
       Enables joint attention across representation subspaces at different positions.

3. Positional Encoding (Injecting Sequence Order without Recurrence):
       Sinusoidal PE (Vaswani et al.):
           PE(pos, 2i)   = sin( pos / 10000^(2i / d_model) )
           PE(pos, 2i+1) = cos( pos / 10000^(2i / d_model) )
       Modern alternatives: RoPE (Rotary Position Embeddings - LLaMA, DeepSeek).

4. Position-Wise Feedforward Network (FFN / MLP Block):
       FFN(x) = max(0, x * W_1 + b_1) * W_2 + b_2

5. Residual Shortcuts & Root Mean Square Normalization (RMSNorm - Zhang & Sennrich, 2019):
       RMSNorm(x) = x / sqrt( (1 / d) * Σ_{i=1}^d x_i^2 + ε ) ⊙ γ
       Pre-LN Transformer Block:
           x_mid = x + Attention( RMSNorm(x) )
           x_out = x_mid + FFN( RMSNorm(x_mid) )

6. Three Foundational Paradigms:
       - Encoder-Only (BERT, RoBERTa)       : Unmasked Bidirectional Attention.
       - Decoder-Only (GPT, LLaMA, DeepSeek): Causal Autoregressive Masking (M_{i, j} = -∞ for j > i).
       - Encoder-Decoder (T5, BART)         : Cross-Attention between Encoder & Decoder.
================================================================================
*/

fn rms_norm(x: &float[], n: int, d: int, gamma: &float[], out_norm: &float[]) -> void {
    let eps = 0.00001;
    let d_f = 1.0 * d;

    for (let t = 0; t < n; t++) {
        let sum_sq = 0.0;
        for (let j = 0; j < d; j++) {
            let val = x[t * d + j];
            sum_sq += val * val;
        }
        let rms = sqrt(sum_sq / d_f + eps);

        for (let j = 0; j < d; j++) {
            out_norm[t * d + j] = (x[t * d + j] / rms) * gamma[j];
        }
    }
}

// -------------------------------------------------------------
// Scaled Dot-Product Attention (with optional Causal Mask)
// -------------------------------------------------------------
fn scaled_dot_product_attention(q: &float[], k: &float[], v: &float[],
                                t_steps: int, d_k: int, is_causal: bool,
                                attn_weights: &float[], out_ctx: &float[]) -> void {
    let scale = 1.0 / sqrt(1.0 * d_k);

    for (let i = 0; i < t_steps; i++) {
        let max_score = -999999.0;
        let scores = alloc(float, t_steps);

        // 1. Raw scaled dot product: S_{ij} = (q_i · k_j) / sqrt(d_k)
        for (let j = 0; j < t_steps; j++) {
            if (is_causal && j > i) {
                // Causal mask: Future positions receive -∞
                scores[j] = -999999.0;
            } else {
                let dot = 0.0;
                for (let c = 0; c < d_k; c++) {
                    dot += q[i * d_k + c] * k[j * d_k + c];
                }
                scores[j] = dot * scale;
                if (scores[j] > max_score) { max_score = scores[j]; }
            }
        }

        // 2. Softmax normalization: A_{ij} = exp(S_{ij} - S_max) / Σ exp(...)
        let sum_exp = 0.0;
        for (let j = 0; j < t_steps; j++) {
            if (is_causal && j > i) {
                attn_weights[i * t_steps + j] = 0.0;
            } else {
                let e = exp(scores[j] - max_score);
                attn_weights[i * t_steps + j] = e;
                sum_exp += e;
            }
        }

        if (sum_exp < 0.0000001) { sum_exp = 0.0000001; }

        for (let j = 0; j < t_steps; j++) {
            attn_weights[i * t_steps + j] /= sum_exp;
        }

        // 3. Value aggregation: Out_i = Σ_j A_{ij} * v_j
        for (let c = 0; c < d_k; c++) {
            let sum_v = 0.0;
            for (let j = 0; j < t_steps; j++) {
                sum_v += attn_weights[i * t_steps + j] * v[j * d_k + c];
            }
            out_ctx[i * d_k + c] = sum_v;
        }
    }
}

// -------------------------------------------------------------
// Multi-Head Attention Block (2 Heads)
// -------------------------------------------------------------
fn multi_head_attention(x: &float[], t_steps: int, d_model: int, num_heads: int, is_causal: bool,
                        wq: &float[], wk: &float[], wv: &float[], wo: &float[],
                        weights_head0: &float[], weights_head1: &float[],
                        out_mha: &float[]) -> void {
    let d_k = d_model / num_heads; // e.g. 4 / 2 = 2

    // Project Q, K, V
    let q = alloc(float, t_steps * d_model);
    let k = alloc(float, t_steps * d_model);
    let v = alloc(float, t_steps * d_model);

    for (let t = 0; t < t_steps; t++) {
        for (let j = 0; j < d_model; j++) {
            let sum_q = 0.0; let sum_k = 0.0; let sum_v = 0.0;
            for (let c = 0; c < d_model; c++) {
                let xt = x[t * d_model + c];
                sum_q += xt * wq[c * d_model + j];
                sum_k += xt * wk[c * d_model + j];
                sum_v += xt * wv[c * d_model + j];
            }
            q[t * d_model + j] = sum_q;
            k[t * d_model + j] = sum_k;
            v[t * d_model + j] = sum_v;
        }
    }

    // Split heads: Head 0 (features 0..1), Head 1 (features 2..3)
    let q0 = alloc(float, t_steps * d_k); let k0 = alloc(float, t_steps * d_k); let v0 = alloc(float, t_steps * d_k);
    let q1 = alloc(float, t_steps * d_k); let k1 = alloc(float, t_steps * d_k); let v1 = alloc(float, t_steps * d_k);

    for (let t = 0; t < t_steps; t++) {
        q0[t * d_k + 0] = q[t * d_model + 0]; q0[t * d_k + 1] = q[t * d_model + 1];
        k0[t * d_k + 0] = k[t * d_model + 0]; k0[t * d_k + 1] = k[t * d_model + 1];
        v0[t * d_k + 0] = v[t * d_model + 0]; v0[t * d_k + 1] = v[t * d_model + 1];

        q1[t * d_k + 0] = q[t * d_model + 2]; q1[t * d_k + 1] = q[t * d_model + 3];
        k1[t * d_k + 0] = k[t * d_model + 2]; k1[t * d_k + 1] = k[t * d_model + 3];
        v1[t * d_k + 0] = v[t * d_model + 2]; v1[t * d_k + 1] = v[t * d_model + 3];
    }

    let ctx0 = alloc(float, t_steps * d_k);
    let ctx1 = alloc(float, t_steps * d_k);

    scaled_dot_product_attention(&q0, &k0, &v0, t_steps, d_k, is_causal, weights_head0, &ctx0);
    scaled_dot_product_attention(&q1, &k1, &v1, t_steps, d_k, is_causal, weights_head1, &ctx1);

    // Concatenate Heads and project through W_O
    let concat_ctx = alloc(float, t_steps * d_model);
    for (let t = 0; t < t_steps; t++) {
        concat_ctx[t * d_model + 0] = ctx0[t * d_k + 0];
        concat_ctx[t * d_model + 1] = ctx0[t * d_k + 1];
        concat_ctx[t * d_model + 2] = ctx1[t * d_k + 0];
        concat_ctx[t * d_model + 3] = ctx1[t * d_k + 1];
    }

    for (let t = 0; t < t_steps; t++) {
        for (let j = 0; j < d_model; j++) {
            let sum = 0.0;
            for (let c = 0; c < d_model; c++) {
                sum += concat_ctx[t * d_model + c] * wo[c * d_model + j];
            }
            out_mha[t * d_model + j] = sum;
        }
    }
}

// -------------------------------------------------------------
// Feedforward Network (MLP Expansion & Projection)
// -------------------------------------------------------------
fn feedforward_network(x: &float[], t_steps: int, d_model: int, d_ff: int,
                       w1: &float[], b1: &float[],
                       w2: &float[], b2: &float[],
                       out_ffn: &float[]) -> void {
    let hidden = alloc(float, d_ff);

    for (let t = 0; t < t_steps; t++) {
        // Linear + ReLU
        for (let j = 0; j < d_ff; j++) {
            let sum = b1[j];
            for (let c = 0; c < d_model; c++) {
                sum += x[t * d_model + c] * w1[c * d_ff + j];
            }
            if (sum < 0.0) { sum = 0.0; } // ReLU
            hidden[j] = sum;
        }

        // Linear Output Projection
        for (let j = 0; j < d_model; j++) {
            let sum = b2[j];
            for (let c = 0; c < d_ff; c++) {
                sum += hidden[c] * w2[c * d_model + j];
            }
            out_ffn[t * d_model + j] = sum;
        }
    }
}

fn main() -> int {
    print("==================================================================");
    print("   TRANSFORMERS: MULTI-HEAD SELF-ATTENTION & RESIDUAL STACK (v20) ");
    print("==================================================================\n");

    // Sequence of T = 4 Tokens, Dimension d_model = 4:
    // Input sequence: "The", "cat", "sat", "down"
    let t_steps = 4;
    let d_model = 4;
    let num_heads = 2;
    let d_ff = 8;

    let x_token = alloc(float, t_steps * d_model);

    // Initial token embeddings
    x_token[0 * d_model + 0] = 0.5; x_token[0 * d_model + 1] = 0.1; x_token[0 * d_model + 2] = 0.8; x_token[0 * d_model + 3] = 0.2;
    x_token[1 * d_model + 0] = 0.9; x_token[1 * d_model + 1] = 0.4; x_token[1 * d_model + 2] = 0.1; x_token[1 * d_model + 3] = 0.7;
    x_token[2 * d_model + 0] = 0.2; x_token[2 * d_model + 1] = 0.8; x_token[2 * d_model + 2] = 0.5; x_token[2 * d_model + 3] = 0.3;
    x_token[3 * d_model + 0] = 0.4; x_token[3 * d_model + 1] = 0.6; x_token[3 * d_model + 2] = 0.9; x_token[3 * d_model + 3] = 0.1;

    // --- 1. Sinusoidal Positional Encoding ---
    print("--- 1. Injecting Sinusoidal Positional Encoding PE(pos, 2i) ---");
    let x_embedded = alloc(float, t_steps * d_model);

    for (let pos = 0; pos < t_steps; pos++) {
        let pe0 = sin((1.0 * pos) / 1.0);
        let pe1 = cos((1.0 * pos) / 1.0);
        let pe2 = sin((1.0 * pos) / 100.0);
        let pe3 = cos((1.0 * pos) / 100.0);

        x_embedded[pos * d_model + 0] = x_token[pos * d_model + 0] + pe0;
        x_embedded[pos * d_model + 1] = x_token[pos * d_model + 1] + pe1;
        x_embedded[pos * d_model + 2] = x_token[pos * d_model + 2] + pe2;
        x_embedded[pos * d_model + 3] = x_token[pos * d_model + 3] + pe3;

        print(f"  Token {pos} Embed+PE: [{x_embedded[pos * d_model + 0]}, {x_embedded[pos * d_model + 1]}, {x_embedded[pos * d_model + 2]}, {x_embedded[pos * d_model + 3]}]");
    }
    print("");

    // Projection weights (Orthogonal / Identity initialization for demonstration)
    let wq = alloc(float, d_model * d_model);
    let wk = alloc(float, d_model * d_model);
    let wv = alloc(float, d_model * d_model);
    let wo = alloc(float, d_model * d_model);

    for (let i = 0; i < d_model; i++) {
        for (let j = 0; j < d_model; j++) {
            if (i == j) {
                wq[i * d_model + j] = 1.0;
                wk[i * d_model + j] = 1.0;
                wv[i * d_model + j] = 1.0;
                wo[i * d_model + j] = 1.0;
            } else {
                wq[i * d_model + j] = 0.0;
                wk[i * d_model + j] = 0.0;
                wv[i * d_model + j] = 0.0;
                wo[i * d_model + j] = 0.0;
            }
        }
    }

    let gamma = alloc(float, d_model);
    for (let j = 0; j < d_model; j++) { gamma[j] = 1.0; }

    // --- 2. Bidirectional Self-Attention (Encoder / BERT Mode) ---
    print("--- 2. Encoder Mode: Bidirectional Self-Attention (BERT) ---");
    let weights_bert_h0 = alloc(float, t_steps * t_steps);
    let weights_bert_h1 = alloc(float, t_steps * t_steps);
    let out_mha_bert = alloc(float, t_steps * d_model);

    multi_head_attention(&x_embedded, t_steps, d_model, num_heads, false,
                         &wq, &wk, &wv, &wo,
                         &weights_bert_h0, &weights_bert_h1,
                         &out_mha_bert);

    print("  Bidirectional Attention Matrix Head 0 (Full Cross-Token Visibility):");
    for (let i = 0; i < t_steps; i++) {
        print(f"    Token {i} Attends to: [{weights_bert_h0[i * t_steps + 0]}, {weights_bert_h0[i * t_steps + 1]}, {weights_bert_h0[i * t_steps + 2]}, {weights_bert_h0[i * t_steps + 3]}]");
    }
    print("");

    // --- 3. Causal Masked Self-Attention (Decoder / GPT & LLaMA Mode) ---
    print("--- 3. Decoder Mode: Causal Masked Self-Attention (GPT, LLaMA, DeepSeek) ---");
    let weights_gpt_h0 = alloc(float, t_steps * t_steps);
    let weights_gpt_h1 = alloc(float, t_steps * t_steps);
    let out_mha_gpt = alloc(float, t_steps * d_model);

    multi_head_attention(&x_embedded, t_steps, d_model, num_heads, true,
                         &wq, &wk, &wv, &wo,
                         &weights_gpt_h0, &weights_gpt_h1,
                         &out_mha_gpt);

    print("  Causal Lower-Triangular Attention Matrix Head 0 (Zero Future Leaks):");
    for (let i = 0; i < t_steps; i++) {
        print(f"    Token {i} Attends to: [{weights_gpt_h0[i * t_steps + 0]}, {weights_gpt_h0[i * t_steps + 1]}, {weights_gpt_h0[i * t_steps + 2]}, {weights_gpt_h0[i * t_steps + 3]}]");
    }
    print("");

    // Verify Causal Invariant: Token 0 must attend 100% to itself, 0% to future
    if (weights_gpt_h0[0 * t_steps + 0] > 0.99 && weights_gpt_h0[0 * t_steps + 1] == 0.0) {
        print("  VERIFIED: Causal autoregressive mask completely blocks future information leaks!\n");
    }

    // --- 4. Full Pre-LN Transformer Block Execution (MHA + RMSNorm + FFN) ---
    print("--- 4. Full Pre-LN Transformer Block Pipeline ---");
    let x_norm1 = alloc(float, t_steps * d_model);
    rms_norm(&x_embedded, t_steps, d_model, &gamma, &x_norm1);

    let x_mid = alloc(float, t_steps * d_model);
    for (let t = 0; t < t_steps * d_model; t++) {
        x_mid[t] = x_embedded[t] + out_mha_gpt[t]; // Residual Addition
    }

    let x_norm2 = alloc(float, t_steps * d_model);
    rms_norm(&x_mid, t_steps, d_model, &gamma, &x_norm2);

    let w1_ff = alloc(float, d_model * d_ff);
    let b1_ff = alloc(float, d_ff);
    let w2_ff = alloc(float, d_ff * d_model);
    let b2_ff = alloc(float, d_model);

    for (let i = 0; i < d_model * d_ff; i++) { w1_ff[i] = 0.2; }
    for (let j = 0; j < d_ff; j++) { b1_ff[j] = 0.05; }
    for (let i = 0; i < d_ff * d_model; i++) { w2_ff[i] = 0.2; }
    for (let j = 0; j < d_model; j++) { b2_ff[j] = 0.0; }

    let ffn_out = alloc(float, t_steps * d_model);
    feedforward_network(&x_norm2, t_steps, d_model, d_ff, &w1_ff, &b1_ff, &w2_ff, &b2_ff, &ffn_out);

    let x_final = alloc(float, t_steps * d_model);
    for (let t = 0; t < t_steps * d_model; t++) {
        x_final[t] = x_mid[t] + ffn_out[t]; // Second Residual Addition
    }

    for (let pos = 0; pos < t_steps; pos++) {
        print(f"  Final Token {pos} Latent Output: [{x_final[pos * d_model + 0]}, {x_final[pos * d_model + 1]}, {x_final[pos * d_model + 2]}, {x_final[pos * d_model + 3]}]");
    }
    print("");

    print("==================================================================");
    print("Transformer (MHA, Causal & Non-Causal) verified with 0 leaks!");
    return 0;
}
