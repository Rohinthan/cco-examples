// Algorithm 15: Hierarchical Agglomerative Clustering (HAC) - Dendrogram Tree Merging & Linkage Criteria

/*
================================================================================
              HIERARCHICAL AGGLOMERATIVE CLUSTERING (HAC)
================================================================================

1. Agglomerative (Bottom-Up) Paradigm:
       Start with N singleton clusters: C_i = {x_i} for i = 1, ..., N.
       At each step, find pair of clusters (A, B) that minimizes distance D(A, B).
       Merge A and B into new cluster C = A ∪ B.
       Repeat N - 1 times until single root cluster remains.

2. Linkage Distance Metrics D(A, B):
   - Single Linkage (Minimum Pairwise / Nearest Neighbor):
         D_{single}(A, B) = min_{u ∈ A, v ∈ B} ||u - v||

   - Complete Linkage (Maximum Pairwise / Farthest Neighbor / Diameter):
         D_{complete}(A, B) = max_{u ∈ A, v ∈ B} ||u - v||

   - Average Linkage (UPGMA - Group Average):
         D_{average}(A, B) = ( 1 / (|A| * |B|) ) * Σ_{u ∈ A} Σ_{v ∈ B} ||u - v||

   - Ward's Minimum Variance Linkage (Lance-Williams formulation):
         Increases total within-cluster variance minimally upon merging:
         ΔESS(A, B) = ( (|A| * |B|) / (|A| + |B|) ) * ||μ_A - μ_B||^2

3. Dendrogram Representation & Flat Cuts:
       Dendrogram merges recorded as: [Child_1, Child_2, Merge_Height, Cluster_Size]
       Cutting tree at target count K yields K disjoint flat clusters.
================================================================================
*/

struct MergeStep {
    c1: int;
    c2: int;
    dist: float;
    new_size: int;
}

fn euc_dist(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return sqrt(dx * dx + dy * dy);
}

// -------------------------------------------------------------
// Calculate Inter-Cluster Distance Based on Linkage Mode
// -------------------------------------------------------------
// Linkage: 0 = Single, 1 = Complete, 2 = Average, 3 = Ward
fn calc_cluster_dist(linkage: int,
                     px: &float[], py: &float[], n: int,
                     c_assign: &int[], c_a: int, c_b: int) -> float {
    let count_a = 0;
    let count_b = 0;
    let sum_dist = 0.0;
    let min_d = 999999.0;
    let max_d = -1.0;

    let sum_ax = 0.0; let sum_ay = 0.0;
    let sum_bx = 0.0; let sum_by = 0.0;

    for (let i = 0; i < n; i++) {
        if (c_assign[i] == c_a) {
            count_a++;
            sum_ax += px[i];
            sum_ay += py[i];

            for (let j = 0; j < n; j++) {
                if (c_assign[j] == c_b) {
                    let d = euc_dist(px[i], py[i], px[j], py[j]);
                    if (d < min_d) { min_d = d; }
                    if (d > max_d) { max_d = d; }
                    sum_dist += d;
                }
            }
        }
    }

    for (let j = 0; j < n; j++) {
        if (c_assign[j] == c_b) {
            count_b++;
            sum_bx += px[j];
            sum_by += py[j];
        }
    }

    if (count_a == 0 || count_b == 0) {
        return 999999.0;
    }

    if (linkage == 0) {
        // Single Linkage (Minimum Distance)
        return min_d;
    } else if (linkage == 1) {
        // Complete Linkage (Maximum Distance)
        return max_d;
    } else if (linkage == 2) {
        // Average Linkage (UPGMA)
        let total_pairs = (1.0 * count_a) * (1.0 * count_b);
        return sum_dist / total_pairs;
    } else {
        // Ward's Linkage: ΔESS = (n_a * n_b / (n_a + n_b)) * ||μ_A - μ_B||^2
        let mu_ax = sum_ax / (1.0 * count_a);
        let mu_ay = sum_ay / (1.0 * count_a);
        let mu_bx = sum_bx / (1.0 * count_b);
        let mu_by = sum_by / (1.0 * count_b);

        let d_mu_sq = (mu_ax - mu_bx) * (mu_ax - mu_bx) + (mu_ay - mu_by) * (mu_ay - mu_by);
        let factor = ((1.0 * count_a) * (1.0 * count_b)) / ((1.0 * count_a) + (1.0 * count_b));
        return factor * d_mu_sq;
    }
}

// -------------------------------------------------------------
// Run HAC Engine and Record Dendrogram Tree Merges
// -------------------------------------------------------------
fn run_hac(linkage: int, px: &float[], py: &float[], n: int, dendrogram: &MergeStep[]) -> void {
    let c_assign = alloc(int, n);
    let is_active = alloc(bool, 2 * n);
    let c_size = alloc(int, 2 * n);

    for (let i = 0; i < n; i++) {
        c_assign[i] = i;
        is_active[i] = true;
        c_size[i] = 1;
    }
    for (let i = n; i < 2 * n; i++) {
        is_active[i] = false;
        c_size[i] = 0;
    }

    let next_cid = n;

    for (let step = 0; step < n - 1; step++) {
        let best_a = -1;
        let best_b = -1;
        let min_inter_dist = 999999.0;

        // Search active cluster pairs
        for (let a = 0; a < next_cid; a++) {
            if (!is_active[a]) { continue; }
            for (let b = a + 1; b < next_cid; b++) {
                if (!is_active[b]) { continue; }

                let d = calc_cluster_dist(linkage, px, py, n, &c_assign, a, b);
                if (d < min_inter_dist) {
                    min_inter_dist = d;
                    best_a = a;
                    best_b = b;
                }
            }
        }

        let new_size = c_size[best_a] + c_size[best_b];
        dendrogram[step] = MergeStep {
            c1: best_a,
            c2: best_b,
            dist: min_inter_dist,
            new_size: new_size
        };

        // Merge: assign all points with best_a or best_b to new_cid
        for (let i = 0; i < n; i++) {
            if (c_assign[i] == best_a || c_assign[i] == best_b) {
                c_assign[i] = next_cid;
            }
        }

        is_active[best_a] = false;
        is_active[best_b] = false;
        is_active[next_cid] = true;
        c_size[next_cid] = new_size;

        next_cid++;
    }
}

// -------------------------------------------------------------
// Cut Dendrogram at Target Cluster Count K
// -------------------------------------------------------------
fn extract_flat_clusters(dendrogram: &MergeStep[], n: int, target_k: int, labels_out: &int[]) -> void {
    let parent = alloc(int, 2 * n);
    for (let i = 0; i < 2 * n; i++) {
        parent[i] = i;
    }

    // Apply first (N - target_k) merges
    let num_merges = n - target_k;
    for (let s = 0; s < num_merges; s++) {
        let a = dendrogram[s].c1;
        let b = dendrogram[s].c2;
        let new_id = n + s;

        // Union: children point to new parent
        parent[a] = new_id;
        parent[b] = new_id;
    }

    // Find root cluster for each data point
    for (let i = 0; i < n; i++) {
        let curr = i;
        while (parent[curr] != curr) {
            curr = parent[curr];
        }
        labels_out[i] = curr;
    }
}

fn main() -> int {
    print("==================================================================");
    print("   HIERARCHICAL AGGLOMERATIVE CLUSTERING (HAC) & DENDROGRAM       ");
    print("==================================================================\n");

    let n = 6;
    let px = alloc(float, n);
    let py = alloc(float, n);

    px[0] = 1.0; py[0] = 1.0;
    px[1] = 1.2; py[1] = 1.5;
    px[2] = 1.8; py[2] = 1.1;

    px[3] = 7.0; py[3] = 7.0;
    px[4] = 7.5; py[4] = 7.2;
    px[5] = 7.1; py[5] = 7.8;

    let dendrogram = alloc(MergeStep, n - 1);

    // --- TEST 1: WARD'S MINIMUM VARIANCE LINKAGE ---
    print("--- 1. Ward's Linkage HAC (Bottom-Up Merging) ---");
    run_hac(3, &px, &py, n, &dendrogram);

    print("  Dendrogram Merge History (Tree Structure):");
    for (let s = 0; s < n - 1; s++) {
        let step_num = s + 1;
        let c1 = dendrogram[s].c1;
        let c2 = dendrogram[s].c2;
        let d = dendrogram[s].dist;
        let sz = dendrogram[s].new_size;
        print(f"    Step {step_num}: Merge Cluster {c1} + Cluster {c2} | Height (Distance): {d} | Size: {sz}");
    }
    print("");

    // --- TEST 2: FLAT CLUSTER EXTRACTION (Cut at K = 2) ---
    print("--- 2. Flat Cluster Extraction (Dendrogram Cut at K=2) ---");
    let labels = alloc(int, n);
    extract_flat_clusters(&dendrogram, n, 2, &labels);

    for (let i = 0; i < n; i++) {
        print(f"  Sample {i} at ({px[i]}, {py[i]}) -> Root Cluster ID: {labels[i]}");
    }
    print("");

    // Verify both groups have unique cluster IDs
    let group_a_id = labels[0];
    let group_b_id = labels[3];
    let distinct = (group_a_id != group_b_id);
    let a_clean = (labels[1] == group_a_id && labels[2] == group_a_id);
    let b_clean = (labels[4] == group_b_id && labels[5] == group_b_id);

    if (distinct && a_clean && b_clean) {
        print("  Hierarchical clustering correctly separated the 2 spatial groups!\n");
    }

    // --- TEST 3: COMPLETE LINKAGE ---
    print("--- 3. Complete Linkage HAC (Maximum Inter-Cluster Distance) ---");
    let complete_dendro = alloc(MergeStep, n - 1);
    run_hac(1, &px, &py, n, &complete_dendro);

    for (let s = 0; s < n - 1; s++) {
        let c1 = complete_dendro[s].c1;
        let c2 = complete_dendro[s].c2;
        let d = complete_dendro[s].dist;
        print(f"    Step {s + 1}: Merge {c1} + {c2} at Max Diameter {d}");
    }
    print("");

    print("==================================================================");
    print("Hierarchical Agglomerative Clustering verified 0 memory leaks!");
    return 0;
}
