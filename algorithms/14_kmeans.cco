// Algorithm 14: k-Means & k-Means++ Centroid Clustering Optimization

/*
================================================================================
                    k-MEANS & k-MEANS++ CLUSTERING
================================================================================

1. Objective Function (Within-Cluster Sum of Squares / Inertia):
       J(C, μ) = Σ_{k=1}^K Σ_{x_i ∈ C_k} ||x_i - μ_k||^2

2. k-Means++ Probabilistic Seeding (Arthur & Vassilvitskii, 2007):
   a. Choose first centroid c_1 uniformly at random from dataset X.
   b. For each remaining centroid c_k (k = 2, ..., K):
          Compute shortest squared distance to any existing centroid:
              D(x)^2 = min_{j < k} ||x - c_j||^2
          Select next centroid c_k from X with probability:
              P(x) = D(x)^2 / Σ_{x' ∈ X} D(x')^2
      Guarantees O(log K) competitive ratio against optimal clustering!

3. Lloyd's Iterative Optimization Algorithm:
   - Assignment Step (Voronoi Partitioning):
         C_k^{(t)} = { x_i : ||x_i - μ_k^{(t)}||^2 ≤ ||x_i - μ_j^{(t)}||^2, ∀ j }

   - Update Step (Center of Mass):
         μ_k^{(t+1)} = (1 / |C_k^{(t)}|) * Σ_{x_i ∈ C_k^{(t)}} x_i

4. Convergence:
       Stop when centroid displacement max_k ||μ_k^{(t+1)} - μ_k^{(t)}|| < ε
       or point assignments remain unchanged.
================================================================================
*/

fn dist_sq_2d(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return dx * dx + dy * dy;
}

// -------------------------------------------------------------
// k-Means++ Initialization (D^2 Weighted Seeding)
// -------------------------------------------------------------
fn init_kmeans_plus_plus(px: &float[], py: &float[], n: int, k: int, cx: &float[], cy: &float[]) -> void {
    // 1. Choose first center uniformly at random
    let first_idx = random_int(0, n - 1);
    cx[0] = px[first_idx];
    cy[0] = py[first_idx];

    let d_sq = alloc(float, n);

    // 2. Select remaining K - 1 centroids via D^2 weighting
    for (let c = 1; c < k; c++) {
        let sum_d2 = 0.0;

        for (let i = 0; i < n; i++) {
            let min_d = 999999.0;
            for (let j = 0; j < c; j++) {
                let d = dist_sq_2d(px[i], py[i], cx[j], cy[j]);
                if (d < min_d) { min_d = d; }
            }
            d_sq[i] = min_d;
            sum_d2 += min_d;
        }

        // Sample point with probability proportional to D(x)^2
        let rnd_pct = random_int(0, 999);
        let threshold = ((1.0 * rnd_pct) / 1000.0) * sum_d2;

        let accum = 0.0;
        let chosen_idx = n - 1;

        for (let i = 0; i < n; i++) {
            accum += d_sq[i];
            if (accum >= threshold) {
                chosen_idx = i;
                break;
            }
        }

        cx[c] = px[chosen_idx];
        cy[c] = py[chosen_idx];
    }
}

// -------------------------------------------------------------
// Calculate Within-Cluster Sum of Squares (Inertia)
// -------------------------------------------------------------
fn compute_wcss(px: &float[], py: &float[], n: int, cx: &float[], cy: &float[], cluster_assignments: &int[]) -> float {
    let total_inertia = 0.0;
    for (let i = 0; i < n; i++) {
        let c = cluster_assignments[i];
        total_inertia += dist_sq_2d(px[i], py[i], cx[c], cy[c]);
    }
    return total_inertia;
}

// -------------------------------------------------------------
// Lloyd's Iterative k-Means Engine
// -------------------------------------------------------------
fn train_kmeans(px: &float[], py: &float[], n: int, k: int, max_iters: int, cx: &float[], cy: &float[], assignments: &int[]) -> float {
    let sum_x = alloc(float, k);
    let sum_y = alloc(float, k);
    let counts = alloc(int, k);

    let tol = 0.00001;

    for (let iter = 0; iter < max_iters; iter++) {
        // --- Step 1: Assignment Step (Voronoi partition) ---
        let changed = 0;
        for (let i = 0; i < n; i++) {
            let best_c = 0;
            let min_dist = 999999.0;

            for (let c = 0; c < k; c++) {
                let d = dist_sq_2d(px[i], py[i], cx[c], cy[c]);
                if (d < min_dist) {
                    min_dist = d;
                    best_c = c;
                }
            }

            if (assignments[i] != best_c) {
                assignments[i] = best_c;
                changed++;
            }
        }

        // Compute current Inertia
        let cur_wcss = compute_wcss(px, py, n, cx, cy, assignments);
        print(f"  Iteration {iter + 1}: WCSS (Inertia) = {cur_wcss} | Reassigned Points = {changed}");

        // --- Step 2: Centroid Update Step (Center of Mass) ---
        for (let c = 0; c < k; c++) {
            sum_x[c] = 0.0;
            sum_y[c] = 0.0;
            counts[c] = 0;
        }

        for (let i = 0; i < n; i++) {
            let c = assignments[i];
            sum_x[c] += px[i];
            sum_y[c] += py[i];
            counts[c]++;
        }

        let max_shift = 0.0;
        for (let c = 0; c < k; c++) {
            if (counts[c] > 0) {
                let new_x = sum_x[c] / (1.0 * counts[c]);
                let new_y = sum_y[c] / (1.0 * counts[c]);
                let shift = dist_sq_2d(cx[c], cy[c], new_x, new_y);
                if (shift > max_shift) { max_shift = shift; }
                cx[c] = new_x;
                cy[c] = new_y;
            }
        }

        if (max_shift < tol || changed == 0) {
            print(f"  Converged after {iter + 1} iterations!");
            break;
        }
    }

    return compute_wcss(px, py, n, cx, cy, assignments);
}

fn predict_cluster(qx: float, qy: float, cx: &float[], cy: &float[], k: int) -> int {
    let best_c = 0;
    let min_d = 999999.0;
    for (let c = 0; c < k; c++) {
        let d = dist_sq_2d(qx, qy, cx[c], cy[c]);
        if (d < min_d) {
            min_d = d;
            best_c = c;
        }
    }
    return best_c;
}

fn main() -> int {
    print("==================================================================");
    print("   K-MEANS & K-MEANS++ CENTROID CLUSTERING OPTIMIZER (Cco-v20)    ");
    print("==================================================================\n");

    let n = 9;
    let px = alloc(float, n);
    let py = alloc(float, n);

    // Group 1
    px[0] = 1.0; py[0] = 1.5;
    px[1] = 1.5; py[1] = 2.0;
    px[2] = 2.0; py[2] = 1.0;

    // Group 2
    px[3] = 1.0; py[3] = 8.0;
    px[4] = 1.5; py[4] = 9.0;
    px[5] = 2.0; py[5] = 8.5;

    // Group 3
    px[6] = 8.0; py[6] = 5.0;
    px[7] = 8.5; py[7] = 5.5;
    px[8] = 9.0; py[8] = 4.5;

    let k = 3;
    let cx = alloc(float, k);
    let cy = alloc(float, k);
    let assignments = alloc(int, n);
    for (let i = 0; i < n; i++) { assignments[i] = -1; }

    random_seed(42);

    print("--- 1. k-Means++ D^2 Seed Selection ---");
    init_kmeans_plus_plus(&px, &py, n, k, &cx, &cy);
    for (let c = 0; c < k; c++) {
        print(f"  Seeded Centroid #{c + 1} : ({cx[c]}, {cy[c]})");
    }
    print("");

    print("--- 2. Lloyd Centroid Optimization (WCSS Descent) ---");
    let final_inertia = train_kmeans(&px, &py, n, k, 20, &cx, &cy, &assignments);
    print("");

    print("--- 3. Final Optimized Cluster Centers ---");
    for (let c = 0; c < k; c++) {
        print(f"  Cluster #{c}: Centroid = ({cx[c]}, {cy[c]})");
    }
    print(f"  Final Total Inertia (WCSS): {final_inertia}\n");

    print("--- 4. Querying Unseen Continuous Vectors ---");
    let q1 = predict_cluster(1.2, 1.8, &cx, &cy, k);
    let q2 = predict_cluster(1.4, 8.7, &cx, &cy, k);
    let q3 = predict_cluster(8.4, 5.1, &cx, &cy, k);

    print(f"  Query Vector (1.2, 1.8) -> Nearest Cluster: {q1}");
    print(f"  Query Vector (1.4, 8.7) -> Nearest Cluster: {q2}");
    print(f"  Query Vector (8.4, 5.1) -> Nearest Cluster: {q3}\n");

    print("==================================================================");
    print("k-Means & k-Means++ verified with 0 memory leaks!");
    return 0;
}
