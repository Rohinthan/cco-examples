// Algorithm 28: Long Short-Term Memory (LSTM) - Gated Recurrent Unit & Constant Error Carousel (CEC)

/*
================================================================================
                    LONG SHORT-TERM MEMORY (LSTM)
================================================================================

1. The Constant Error Carousel (CEC) & Gating Architecture:
       Introduced by Hochreiter & Schmidhuber (1997) to solve the vanishing and
       exploding gradient problem in recurrent networks.
       Key Innovation: An additive memory cell c_t acting as an information highway:
           ∂c_t / ∂c_{t-1} = f_t  ===>  Gradients flow across 100+ steps when f_t ≈ 1.

2. Gating Equations at Time Step t:
       Given input x_t and previous hidden state h_{t-1}:

       - Forget Gate (Decides what past history to discard):
             f_t = σ( W_f * x_t + U_f * h_{t-1} + b_f )

       - Input / Candidate Gate (Decides what new memory to store):
             i_t = σ( W_i * x_t + U_i * h_{t-1} + b_i )
             c̃_t = tanh( W_c * x_t + U_c * h_{t-1} + b_c )

       - Cell State Update (Linear additive update):
             c_t = f_t ⊙ c_{t-1}  +  i_t ⊙ c̃_t

       - Output Gate (Decides what memory to expose to hidden state):
             o_t = σ( W_o * x_t + U_o * h_{t-1} + b_o )
             h_t = o_t ⊙ tanh( c_t )

3. Final Sequence Prediction:
       ŷ = W_y * h_{T-1} + b_y
       Loss (MSE): L = 0.5 * (ŷ - y)^2

4. Backpropagation Through Time (BPTT) for LSTM:
       Output error: δ_y = ŷ - y
       Terminal hidden error: δ_{h, T-1} = δ_y * W_y
       Cell state error delta:
           δ_{c, t} = δ_{h, t} ⊙ o_t ⊙ (1 - tanh^2(c_t))  +  δ_{c, t+1} ⊙ f_{t+1}

       Gate error deltas:
           δ_{o, t} = δ_{h, t} ⊙ tanh(c_t) ⊙ o_t ⊙ (1 - o_t)
           δ_{c̃, t} = δ_{c, t} ⊙ i_t ⊙ (1 - c̃_t^2)
           δ_{i, t} = δ_{c, t} ⊙ c̃_t ⊙ i_t ⊙ (1 - i_t)
           δ_{f, t} = δ_{c, t} ⊙ c_{t-1} ⊙ f_t ⊙ (1 - f_t)

       State error backward propagation to step t - 1:
           δ_{h, t-1} = U_f^T * δ_{f, t} + U_i^T * δ_{i, t} + U_c^T * δ_{c̃, t} + U_o^T * δ_{o, t}

5. Long-Range Memory Benchmark:
       The "Delayed Memory Flag" task: Remember an initial signal flag at t=0 across
       distractor noise steps t=1..4 to make a correct prediction at t=5.
================================================================================
*/

fn sigmoid_lstm(z: float) -> float {
    if (z > 15.0) { return 1.0; }
    if (z < -15.0) { return 0.0; }
    return 1.0 / (1.0 + exp(-z));
}

fn tanh_lstm(u: float) -> float {
    if (u > 10.0) { return 1.0; }
    if (u < -10.0) { return -1.0; }
    let ep = exp(u);
    let em = exp(-u);
    return (ep - em) / (ep + em);
}

// -------------------------------------------------------------
// LSTM Forward Pass Over Sequence of Length T
// -------------------------------------------------------------
fn lstm_forward(x_seq: &float[], t_steps: int, d_hid: int,
                w_f: &float[], u_f: &float[], b_f: &float[],
                w_i: &float[], u_i: &float[], b_i: &float[],
                w_c: &float[], u_c: &float[], b_c: &float[],
                w_o: &float[], u_o: &float[], b_o: &float[],
                w_y: &float[], b_y: float,
                f_all: &float[], i_all: &float[], c_tilde_all: &float[],
                c_all: &float[], o_all: &float[], h_all: &float[]) -> float {
    for (let t = 0; t < t_steps; t++) {
        let xt = x_seq[t];

        for (let j = 0; j < d_hid; j++) {
            // Linear combinations from x_t and h_{t-1}
            let z_f = w_f[j] * xt + b_f[j];
            let z_i = w_i[j] * xt + b_i[j];
            let z_c = w_c[j] * xt + b_c[j];
            let z_o = w_o[j] * xt + b_o[j];

            if (t > 0) {
                let prev_t = t - 1;
                for (let k = 0; k < d_hid; k++) {
                    let prev_h = h_all[prev_t * d_hid + k];
                    z_f += u_f[j * d_hid + k] * prev_h;
                    z_i += u_i[j * d_hid + k] * prev_h;
                    z_c += u_c[j * d_hid + k] * prev_h;
                    z_o += u_o[j * d_hid + k] * prev_h;
                }
            }

            let f_val = sigmoid_lstm(z_f);
            let i_val = sigmoid_lstm(z_i);
            let c_tilde = tanh_lstm(z_c);
            let o_val = sigmoid_lstm(z_o);

            f_all[t * d_hid + j] = f_val;
            i_all[t * d_hid + j] = i_val;
            c_tilde_all[t * d_hid + j] = c_tilde;
            o_all[t * d_hid + j] = o_val;

            // Cell state update: c_t = f_t * c_{t-1} + i_t * c̃_t
            let prev_c = 0.0;
            if (t > 0) {
                prev_c = c_all[(t - 1) * d_hid + j];
            }
            let c_val = f_val * prev_c + i_val * c_tilde;
            c_all[t * d_hid + j] = c_val;

            // Hidden state: h_t = o_t * tanh(c_t)
            h_all[t * d_hid + j] = o_val * tanh_lstm(c_val);
        }
    }

    // Final prediction from terminal hidden state
    let last_t = t_steps - 1;
    let y_hat = b_y;
    for (let j = 0; j < d_hid; j++) {
        y_hat += w_y[j] * h_all[last_t * d_hid + j];
    }
    return y_hat;
}

// -------------------------------------------------------------
// Train LSTM on Sequential Dataset via BPTT
// -------------------------------------------------------------
fn train_lstm_bptt(x_data: &float[], y_targets: &float[], num_seqs: int, t_steps: int, d_hid: int,
                   epochs: int, lr: float,
                   w_f: &float[], u_f: &float[], b_f: &float[],
                   w_i: &float[], u_i: &float[], b_i: &float[],
                   w_c: &float[], u_c: &float[], b_c: &float[],
                   w_o: &float[], u_o: &float[], b_o: &float[],
                   w_y: &float[], b_y_box: &float[]) -> float {
    let b_y = b_y_box[0];
    let n_f = 1.0 * num_seqs;

    // Buffer allocations
    let f_all = alloc(float, t_steps * d_hid);
    let i_all = alloc(float, t_steps * d_hid);
    let c_tilde_all = alloc(float, t_steps * d_hid);
    let c_all = alloc(float, t_steps * d_hid);
    let o_all = alloc(float, t_steps * d_hid);
    let h_all = alloc(float, t_steps * d_hid);

    let delta_h = alloc(float, t_steps * d_hid);
    let delta_c = alloc(float, t_steps * d_hid);
    let delta_f = alloc(float, t_steps * d_hid);
    let delta_i = alloc(float, t_steps * d_hid);
    let delta_ct = alloc(float, t_steps * d_hid);
    let delta_o = alloc(float, t_steps * d_hid);

    // Gradient accumulators
    let gw_f = alloc(float, d_hid); let gu_f = alloc(float, d_hid * d_hid); let gb_f = alloc(float, d_hid);
    let gw_i = alloc(float, d_hid); let gu_i = alloc(float, d_hid * d_hid); let gb_i = alloc(float, d_hid);
    let gw_c = alloc(float, d_hid); let gu_c = alloc(float, d_hid * d_hid); let gb_c = alloc(float, d_hid);
    let gw_o = alloc(float, d_hid); let gu_o = alloc(float, d_hid * d_hid); let gb_o = alloc(float, d_hid);
    let gw_y = alloc(float, d_hid);

    let cur_seq = alloc(float, t_steps);
    let final_mse = 0.0;

    for (let ep = 0; ep < epochs; ep++) {
        let total_loss = 0.0;

        // Reset accumulators
        let gb_y = 0.0;
        for (let j = 0; j < d_hid; j++) {
            gw_f[j] = 0.0; gb_f[j] = 0.0;
            gw_i[j] = 0.0; gb_i[j] = 0.0;
            gw_c[j] = 0.0; gb_c[j] = 0.0;
            gw_o[j] = 0.0; gb_o[j] = 0.0;
            gw_y[j] = 0.0;
            for (let k = 0; k < d_hid; k++) {
                gu_f[j * d_hid + k] = 0.0;
                gu_i[j * d_hid + k] = 0.0;
                gu_c[j * d_hid + k] = 0.0;
                gu_o[j * d_hid + k] = 0.0;
            }
        }

        // Process all training sequences
        for (let s = 0; s < num_seqs; s++) {
            for (let t = 0; t < t_steps; t++) {
                cur_seq[t] = x_data[s * t_steps + t];
            }
            let target = y_targets[s];

            // 1. Forward Pass
            let y_hat = lstm_forward(&cur_seq, t_steps, d_hid,
                                     w_f, u_f, b_f,
                                     w_i, u_i, b_i,
                                     w_c, u_c, b_c,
                                     w_o, u_o, b_o,
                                     w_y, b_y,
                                     &f_all, &i_all, &c_tilde_all,
                                     &c_all, &o_all, &h_all);

            let err = y_hat - target;
            total_loss += err * err;

            // 2. Output Error
            let delta_y = err;
            gb_y += delta_y;
            let last_t = t_steps - 1;
            for (let j = 0; j < d_hid; j++) {
                gw_y[j] += delta_y * h_all[last_t * d_hid + j];
                delta_h[last_t * d_hid + j] = delta_y * w_y[j];
            }

            // 3. Backward Pass Through Time
            for (let t = t_steps - 1; t >= 0; t--) {
                for (let j = 0; j < d_hid; j++) {
                    let dh = delta_h[t * d_hid + j];
                    let ct = c_all[t * d_hid + j];
                    let ot = o_all[t * d_hid + j];
                    let ft = f_all[t * d_hid + j];
                    let it = i_all[t * d_hid + j];
                    let c_tilde = c_tilde_all[t * d_hid + j];

                    let tanh_c = tanh_lstm(ct);
                    let d_tanh_c = 1.0 - (tanh_c * tanh_c);

                    // Cell error: δ_c = δ_h * o * (1 - tanh^2(c)) + δ_{c, next} * f_{next}
                    let dc = dh * ot * d_tanh_c;
                    if (t < t_steps - 1) {
                        let next_f = f_all[(t + 1) * d_hid + j];
                        let next_dc = delta_c[(t + 1) * d_hid + j];
                        dc += next_dc * next_f;
                    }
                    delta_c[t * d_hid + j] = dc;

                    // Gate error deltas
                    let do_val = dh * tanh_c * ot * (1.0 - ot);
                    let dct_val = dc * it * (1.0 - (c_tilde * c_tilde));
                    let di_val = dc * c_tilde * it * (1.0 - it);

                    let prev_c = 0.0;
                    if (t > 0) { prev_c = c_all[(t - 1) * d_hid + j]; }
                    let df_val = dc * prev_c * ft * (1.0 - ft);

                    delta_o[t * d_hid + j] = do_val;
                    delta_ct[t * d_hid + j] = dct_val;
                    delta_i[t * d_hid + j] = di_val;
                    delta_f[t * d_hid + j] = df_val;

                    // Parameter gradient accumulations
                    let xt = cur_seq[t];
                    gw_o[j] += do_val * xt; gb_o[j] += do_val;
                    gw_c[j] += dct_val * xt; gb_c[j] += dct_val;
                    gw_i[j] += di_val * xt; gb_i[j] += di_val;
                    gw_f[j] += df_val * xt; gb_f[j] += df_val;

                    if (t > 0) {
                        let prev_t = t - 1;
                        for (let k = 0; k < d_hid; k++) {
                            let prev_h = h_all[prev_t * d_hid + k];
                            gu_o[j * d_hid + k] += do_val * prev_h;
                            gu_c[j * d_hid + k] += dct_val * prev_h;
                            gu_i[j * d_hid + k] += di_val * prev_h;
                            gu_f[j * d_hid + k] += df_val * prev_h;
                        }
                    }
                }

                // Propagate delta_h back to t - 1
                if (t > 0) {
                    let prev_t = t - 1;
                    for (let k = 0; k < d_hid; k++) {
                        let sum_dh = 0.0;
                        for (let j = 0; j < d_hid; j++) {
                            sum_dh += u_f[j * d_hid + k] * delta_f[t * d_hid + j];
                            sum_dh += u_i[j * d_hid + k] * delta_i[t * d_hid + j];
                            sum_dh += u_c[j * d_hid + k] * delta_ct[t * d_hid + j];
                            sum_dh += u_o[j * d_hid + k] * delta_o[t * d_hid + j];
                        }
                        delta_h[prev_t * d_hid + k] = sum_dh;
                    }
                }
            }
        }

        final_mse = total_loss / n_f;

        // 4. Update Weights via Gradient Descent
        b_y -= lr * (gb_y / n_f);
        for (let j = 0; j < d_hid; j++) {
            w_y[j] -= lr * (gw_y[j] / n_f);

            w_f[j] -= lr * (gw_f[j] / n_f); gb_f[j] -= lr * (gb_f[j] / n_f);
            w_i[j] -= lr * (gw_i[j] / n_f); gb_i[j] -= lr * (gb_i[j] / n_f);
            w_c[j] -= lr * (gw_c[j] / n_f); gb_c[j] -= lr * (gb_c[j] / n_f);
            w_o[j] -= lr * (gw_o[j] / n_f); gb_o[j] -= lr * (gb_o[j] / n_f);

            for (let k = 0; k < d_hid; k++) {
                u_f[j * d_hid + k] -= lr * (gu_f[j * d_hid + k] / n_f);
                u_i[j * d_hid + k] -= lr * (gu_i[j * d_hid + k] / n_f);
                u_c[j * d_hid + k] -= lr * (gu_c[j * d_hid + k] / n_f);
                u_o[j * d_hid + k] -= lr * (gu_o[j * d_hid + k] / n_f);
            }
        }

        if (ep == 0 || (ep + 1) % 150 == 0 || ep == epochs - 1) {
            print(f"  Epoch #{ep + 1}: Mean Squared Error (MSE) = {final_mse}");
        }
    }

    b_y_box[0] = b_y;
    return final_mse;
}

fn main() -> int {
    print("==================================================================");
    print("   LONG SHORT-TERM MEMORY (LSTM): GATED MEMORY CAROUSEL (v20)     ");
    print("==================================================================\n");

    // 6 Sequences of Length T = 6:
    // Task: Delayed Signal Retention across 5 distractor noise steps
    // Class +1: Starts with +1.0 at t=0
    // Class -1: Starts with -1.0 at t=0
    let num_seqs = 6;
    let t_steps = 6;
    let x_data = alloc(float, num_seqs * t_steps);
    let y_targets = alloc(float, num_seqs);

    for (let i = 0; i < num_seqs * t_steps; i++) {
        x_data[i] = 0.0;
    }

    // Sequence 0: Type +1
    x_data[0 * t_steps + 0] =  1.0; x_data[0 * t_steps + 2] =  0.05; y_targets[0] =  1.0;
    // Sequence 1: Type -1
    x_data[1 * t_steps + 0] = -1.0; x_data[1 * t_steps + 3] = -0.05; y_targets[1] = -1.0;
    // Sequence 2: Type +1
    x_data[2 * t_steps + 0] =  0.9; x_data[2 * t_steps + 1] =  0.02; y_targets[2] =  1.0;
    // Sequence 3: Type -1
    x_data[3 * t_steps + 0] = -0.9; x_data[3 * t_steps + 4] =  0.03; y_targets[3] = -1.0;
    // Sequence 4: Type +1
    x_data[4 * t_steps + 0] =  1.1; x_data[4 * t_steps + 3] = -0.02; y_targets[4] =  1.0;
    // Sequence 5: Type -1
    x_data[5 * t_steps + 0] = -1.1; x_data[5 * t_steps + 2] =  0.01; y_targets[5] = -1.0;

    let d_hid = 2;

    // Allocate LSTM weights
    let w_f = alloc(float, d_hid); let u_f = alloc(float, d_hid * d_hid); let b_f = alloc(float, d_hid);
    let w_i = alloc(float, d_hid); let u_i = alloc(float, d_hid * d_hid); let b_i = alloc(float, d_hid);
    let w_c = alloc(float, d_hid); let u_c = alloc(float, d_hid * d_hid); let b_c = alloc(float, d_hid);
    let w_o = alloc(float, d_hid); let u_o = alloc(float, d_hid * d_hid); let b_o = alloc(float, d_hid);
    let w_y = alloc(float, d_hid); let b_y_box = alloc(float, 1);

    // Initial parameters: bias forget gate towards 1.0 (Gers recommendation)
    b_f[0] = 1.0; b_f[1] = 1.0;
    b_i[0] = 0.0; b_i[1] = 0.0;
    b_c[0] = 0.0; b_c[1] = 0.0;
    b_o[0] = 0.5; b_o[1] = 0.5;

    w_f[0] = 0.1; w_f[1] = 0.1;
    w_i[0] = 0.5; w_i[1] = -0.5;
    w_c[0] = 0.8; w_c[1] = -0.8;
    w_o[0] = 0.2; w_o[1] = 0.2;

    for (let j = 0; j < d_hid * d_hid; j++) {
        u_f[j] = 0.1; u_i[j] = 0.1; u_c[j] = 0.1; u_o[j] = 0.1;
    }

    w_y[0] = 0.7; w_y[1] = -0.7;
    b_y_box[0] = 0.0;

    let epochs = 600;
    let lr = 0.4;

    print("--- 1. Training LSTM on Delayed Information Highway (BPTT) ---");
    print(f"Sequence Horizon T={t_steps} Steps | Cell Memory Dimension={d_hid}");
    print(f"Training across {epochs} epochs with learning rate η = {lr}...\n");

    let final_loss = train_lstm_bptt(&x_data, &y_targets, num_seqs, t_steps, d_hid, epochs, lr,
                                     &w_f, &u_f, &b_f,
                                     &w_i, &u_i, &b_i,
                                     &w_c, &u_c, &b_c,
                                     &w_o, &u_o, &b_o,
                                     &w_y, &b_y_box);
    print(f"  Converged Sequence MSE: {final_loss}\n");

    // --- 2. Testing Unseen Sequences with Long Delays ---
    print("--- 2. Evaluating Unseen Sequences with Distractor Noise ---");
    let test_pos = alloc(float, t_steps);
    let test_neg = alloc(float, t_steps);
    for (let t = 0; t < t_steps; t++) {
        test_pos[t] = 0.0;
        test_neg[t] = 0.0;
    }
    // Unseen query sequences
    test_pos[0] =  0.95; test_pos[2] =  0.04; test_pos[4] = -0.03;
    test_neg[0] = -0.95; test_neg[1] = -0.04; test_neg[3] =  0.03;

    let f_buf = alloc(float, t_steps * d_hid);
    let i_buf = alloc(float, t_steps * d_hid);
    let ct_buf = alloc(float, t_steps * d_hid);
    let c_buf = alloc(float, t_steps * d_hid);
    let o_buf = alloc(float, t_steps * d_hid);
    let h_buf = alloc(float, t_steps * d_hid);

    let pred_pos = lstm_forward(&test_pos, t_steps, d_hid,
                                &w_f, &u_f, &b_f,
                                &w_i, &u_i, &b_i,
                                &w_c, &u_c, &b_c,
                                &w_o, &u_o, &b_o,
                                &w_y, b_y_box[0],
                                &f_buf, &i_buf, &ct_buf,
                                &c_buf, &o_buf, &h_buf);

    print(f"  Unseen Sequence (+1 signal at t=0) -> Terminal Forecast ŷ: {pred_pos} [Expected: +1.0]");
    print(f"    Cell Memory State at t=0 : c_0 = [{c_buf[0 * d_hid + 0]}, {c_buf[0 * d_hid + 1]}]");
    print(f"    Cell Memory State at t=5 : c_5 = [{c_buf[5 * d_hid + 0]}, {c_buf[5 * d_hid + 1]}] (Carried across 5 steps!)");

    let pred_neg = lstm_forward(&test_neg, t_steps, d_hid,
                                &w_f, &u_f, &b_f,
                                &w_i, &u_i, &b_i,
                                &w_c, &u_c, &b_c,
                                &w_o, &u_o, &b_o,
                                &w_y, b_y_box[0],
                                &f_buf, &i_buf, &ct_buf,
                                &c_buf, &o_buf, &h_buf);

    print(f"  Unseen Sequence (-1 signal at t=0) -> Terminal Forecast ŷ: {pred_neg} [Expected: -1.0]");
    print(f"    Cell Memory State at t=0 : c_0 = [{c_buf[0 * d_hid + 0]}, {c_buf[0 * d_hid + 1]}]");
    print(f"    Cell Memory State at t=5 : c_5 = [{c_buf[5 * d_hid + 0]}, {c_buf[5 * d_hid + 1]}]\n");

    if (pred_pos > 0.8 && pred_neg < -0.8) {
        print("  SUCCESS: Constant Error Carousel (CEC) maintained long-term memory perfectly!\n");
    }

    print("==================================================================");
    print("Long Short-Term Memory (LSTM) verified with 0 memory leaks!");
    return 0;
}
