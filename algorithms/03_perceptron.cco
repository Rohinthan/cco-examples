// Algorithm 3: Rosenblatt's Perceptron - Single-Layer Artificial Neuron with Step Activation

struct PerceptronModel {
    w1: float;
    w2: float;
    bias: float;
    epochs_converged: int;
    total_errors: int;
    accuracy: float;
}

fn step_activation(z: float) -> int {
    if (z >= 0.0) {
        return 1;
    }
    return 0;
}

fn train_perceptron(x1: &float[], x2: &float[], y: &int[], n: int, lr: float, max_epochs: int) -> PerceptronModel {
    let w1: float = 0.0;
    let w2: float = 0.0;
    let b: float = 0.0;

    let conv_epoch: int = max_epochs;
    let last_errors: int = 0;

    for (let ep = 1; ep <= max_epochs; ep++) {
        let errors: int = 0;

        for (let i = 0; i < n; i++) {
            let z: float = w1 * x1[i] + w2 * x2[i] + b;
            let y_hat: int = step_activation(z);
            let diff: int = y[i] - y_hat;

            if (diff != 0) {
                let diff_f: float = 1.0 * diff;
                w1 += lr * diff_f * x1[i];
                w2 += lr * diff_f * x2[i];
                b += lr * diff_f;
                errors = errors + 1;
            }
        }

        last_errors = errors;
        if (errors == 0) {
            conv_epoch = ep;
            break;
        }
    }

    // Compute final training accuracy
    let correct: int = 0;
    for (let i = 0; i < n; i++) {
        let z: float = w1 * x1[i] + w2 * x2[i] + b;
        let y_hat: int = step_activation(z);
        if (y_hat == y[i]) {
            correct = correct + 1;
        }
    }

    let acc: float = (1.0 * correct) / (1.0 * n);
    return PerceptronModel {
        w1: w1,
        w2: w2,
        bias: b,
        epochs_converged: conv_epoch,
        total_errors: last_errors,
        accuracy: acc
    };
}

fn predict_perceptron(m: &PerceptronModel, x1_val: float, x2_val: float) -> int {
    let z: float = m.w1 * x1_val + m.w2 * x2_val + m.bias;
    return step_activation(z);
}

fn print_gate_results(gate_name: string, m: &PerceptronModel, x1: &float[], x2: &float[], y: &int[], n: int) -> void {
    print(f"=== {gate_name} Perceptron ===");
    print(f"  Converged at Epoch : {m.epochs_converged} (Remaining Errors: {m.total_errors})");
    print(f"  Decision Boundary  : {m.w1}*x1 + {m.w2}*x2 + ({m.bias}) = 0");
    print(f"  Accuracy           : {m.accuracy * 100.0}%\n");
    print("  Truth Table Verification:");
    for (let i = 0; i < n; i++) {
        let pred: int = predict_perceptron(m, x1[i], x2[i]);
        print(f"    ({x1[i]}, {x2[i]}) -> Target: {y[i]} | Predicted: {pred}");
    }
    print("");
}

fn main() -> int {
    print("==================================================================");
    print("   ROSENBLATT'S PERCEPTRON & LOGIC CLASSIFIER SUITE (Cco-v20)     ");
    print("==================================================================\n");

    let n: int = 4;
    let x1: float[] = alloc(float, n);
    let x2: float[] = alloc(float, n);
    let y_and: int[] = alloc(int, n);
    let y_or: int[] = alloc(int, n);
    let y_nand: int[] = alloc(int, n);
    let y_xor: int[] = alloc(int, n);

    // Standard 2-input boolean inputs
    x1[0] = 0.0; x2[0] = 0.0;
    x1[1] = 0.0; x2[1] = 1.0;
    x1[2] = 1.0; x2[2] = 0.0;
    x1[3] = 1.0; x2[3] = 1.0;

    // 1. AND Gate Target
    y_and[0] = 0; y_and[1] = 0; y_and[2] = 0; y_and[3] = 1;
    let and_model: PerceptronModel = train_perceptron(&x1, &x2, &y_and, n, 0.1, 100);
    print_gate_results("AND Gate", &and_model, &x1, &x2, &y_and, n);

    // 2. OR Gate Target
    y_or[0] = 0; y_or[1] = 1; y_or[2] = 1; y_or[3] = 1;
    let or_model: PerceptronModel = train_perceptron(&x1, &x2, &y_or, n, 0.1, 100);
    print_gate_results("OR Gate", &or_model, &x1, &x2, &y_or, n);

    // 3. NAND Gate Target
    y_nand[0] = 1; y_nand[1] = 1; y_nand[2] = 1; y_nand[3] = 0;
    let nand_model: PerceptronModel = train_perceptron(&x1, &x2, &y_nand, n, 0.1, 100);
    print_gate_results("NAND Gate", &nand_model, &x1, &x2, &y_nand, n);

    // 4. Linearly Non-Separable Case: XOR Gate (Historical Minsky-Papert Limit)
    y_xor[0] = 0; y_xor[1] = 1; y_xor[2] = 1; y_xor[3] = 0;
    let xor_model: PerceptronModel = train_perceptron(&x1, &x2, &y_xor, n, 0.1, 100);
    print("=== XOR Gate (Linearly Non-Separable Demonstration) ===");
    print(f"  Reached max epochs without single-line convergence (Accuracy: {xor_model.accuracy * 100.0}%)");
    print("  (Demonstrates the classical Perceptron linear separation boundary)\n");

    // 5. Continuous 2D Feature Classification (Credit Score & Income Threshold)
    let n_real: int = 6;
    let rx1: float[] = alloc(float, n_real); // Scaled Income
    let rx2: float[] = alloc(float, n_real); // Scaled Credit Score
    let ry: int[] = alloc(int, n_real);      // 0 = Denied, 1 = Approved

    rx1[0] = 1.2; rx2[0] = 2.0; ry[0] = 0;
    rx1[1] = 2.0; rx2[1] = 1.5; ry[1] = 0;
    rx1[2] = 1.8; rx2[2] = 2.5; ry[2] = 0;

    rx1[3] = 5.0; rx2[3] = 7.0; ry[3] = 1;
    rx1[4] = 6.5; rx2[4] = 6.0; ry[4] = 1;
    rx1[5] = 7.0; rx2[5] = 8.5; ry[5] = 1;

    let real_model: PerceptronModel = train_perceptron(&rx1, &rx2, &ry, n_real, 0.05, 200);
    print("=== Continuous 2D Linear Classifier (Credit Approval) ===");
    print(f"  Converged at Epoch : {real_model.epochs_converged}");
    print(f"  Decision Boundary  : {real_model.w1}*x1 + {real_model.w2}*x2 + ({real_model.bias}) = 0");
    print(f"  Training Accuracy  : {real_model.accuracy * 100.0}%\n");

    // Test unseen continuous profiles
    let test1: int = predict_perceptron(&real_model, 1.5, 1.8);
    let test2: int = predict_perceptron(&real_model, 6.0, 7.5);
    print(f"  Applicant [Income: 1.5, Credit: 1.8] -> Prediction = {test1} (0: Denied)");
    print(f"  Applicant [Income: 6.0, Credit: 7.5] -> Prediction = {test2} (1: Approved)\n");

    print("==================================================================");
    print("Rosenblatt's Perceptron validation complete with 0 memory leaks!");
    return 0;
}
