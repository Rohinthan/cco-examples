// Algorithm 50: Fuzzy C-Means (FCM) - Soft Clustering, Membership Degrees & Fuzzy Objective Minimization

/*
================================================================================
                        FUZZY C-MEANS (FCM)
================================================================================

1. Soft / Fuzzy Clustering Principle (Dunn, 1973; Bezdek, 1981):
       Unlike standard K-Means which enforces hard binary partitioning (u_{ij} ∈ {0, 1}),
       Fuzzy C-Means allows each data point to belong to ALL clusters simultaneously
       with continuous membership degrees u_{ij} ∈ [0, 1] satisfying:
           Σ_{j=1}^C u_{ij} = 1.0,   ∀ i ∈ {1, ..., n}

2. The Fuzzy Objective Function J_m:
       J_m(U, V) = Σ_{i=1}^n Σ_{j=1}^C ( u_{ij} )^m * ||x_i - v_j||^2
       where:
           - m > 1       : Fuzzification coefficient (typically m = 2.0).
                           As m -> 1, FCM converges to hard K-Means.
                           As m -> ∞, all memberships become equally uniform (1/C).
           - v_j ∈ R^d   : Centroid vector of cluster j.
           - u_{ij}      : Degree of membership of sample x_i in cluster j.

3. Iterative Alternating Optimization:
       At each iteration until convergence:
       a. Centroid Update (Weighted Center of Gravity):
              v_j = ( Σ_{i=1}^n (u_{ij})^m * x_i ) / ( Σ_{i=1}^n (u_{ij})^m )

       b. Membership Matrix Update:
              u_{ij} = 1.0 / [ Σ_{k=1}^C ( ||x_i - v_j|| / ||x_i - v_k|| )^{ 2 / (m - 1) } ]

4. Uncertainty Quantification:
       Data points located on boundary regions between clusters receive split
       memberships (e.g. u_{i, 1} ≈ 0.50, u_{i, 2} ≈ 0.50), providing probabilistic
       insight into ambiguous instances!
================================================================================
*/

fn dist_sq_fcm(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    let d2 = dx * dx + dy * dy;
    if (d2 < 0.00001) { d2 = 0.00001; }
    return d2;
}

fn main() -> int {
    print("==================================================================");
    print("   FUZZY C-MEANS (FCM): SOFT CLUSTERING & MEMBERSHIPS (v20)       ");
    print("==================================================================\n");

    // Dataset: 5 points in 2D space
    // Cluster 0 core: Points 0, 1 around (1.0, 1.0)
    // Cluster 1 core: Points 2, 3 around (5.0, 5.0)
    // Ambiguous boundary point: Point 4 at exact midpoint (3.0, 3.0)
    let n_samples = 5;
    let n_clusters = 2;
    let m_fuzz = 2.0;

    let px = alloc(float, n_samples);
    let py = alloc(float, n_samples);

    px[0] = 1.0; py[0] = 1.0;
    px[1] = 1.2; py[1] = 0.8;
    px[2] = 5.0; py[2] = 5.0;
    px[3] = 4.8; py[3] = 5.2;
    px[4] = 3.0; py[4] = 3.0; // Boundary Point!

    print("--- 1. Dataset & Cluster Specifications ---");
    print("  Cluster A Core: Points #0, #1 near (1.0, 1.0)");
    print("  Cluster B Core: Points #2, #3 near (5.0, 5.0)");
    print("  Boundary Point: Point #4 at exact midpoint (3.0, 3.0)");
    print(f"  Fuzzifier     : m = {m_fuzz} (quadratic membership weighting)\n");

    // Centroids: [vx0, vy0, vx1, vy1]
    let vx = alloc(float, n_clusters);
    let vy = alloc(float, n_clusters);

    // Initial Centroids
    vx[0] = 1.5; vy[0] = 1.5;
    vx[1] = 4.5; vy[1] = 4.5;

    // Membership Matrix: U ∈ R^{n x C}
    let u_mat = alloc(float, n_samples * n_clusters);

    let max_iter = 25;
    print(f"--- 2. Minimizing Fuzzy Objective J_m over {max_iter} Alternating Iterations ---");

    for (let iter = 0; iter < max_iter; iter++) {
        // 1. Update Memberships: u_{ij} = 1 / Σ_k ( d_{ij} / d_{ik} )^2
        for (let i = 0; i < n_samples; i++) {
            let d0 = sqrt(dist_sq_fcm(px[i], py[i], vx[0], vy[0]));
            let d1 = sqrt(dist_sq_fcm(px[i], py[i], vx[1], vy[1]));

            let sum0 = 1.0 + (d0 / d1) * (d0 / d1);
            let sum1 = 1.0 + (d1 / d0) * (d1 / d0);

            u_mat[i * n_clusters + 0] = 1.0 / sum0;
            u_mat[i * n_clusters + 1] = 1.0 / sum1;
        }

        // 2. Update Centroids: v_j = Σ u_{ij}^2 * x_i / Σ u_{ij}^2
        for (let j = 0; j < n_clusters; j++) {
            let num_x = 0.0;
            let num_y = 0.0;
            let den = 0.0;

            for (let i = 0; i < n_samples; i++) {
                let u = u_mat[i * n_clusters + j];
                let u_sq = u * u; // m = 2.0
                num_x += u_sq * px[i];
                num_y += u_sq * py[i];
                den += u_sq;
            }

            if (den < 0.00001) { den = 0.00001; }
            vx[j] = num_x / den;
            vy[j] = num_y / den;
        }
    }

    print("  Converged Cluster Centroids:");
    print(f"    Centroid A: ({vx[0]}, {vy[0]})");
    print(f"    Centroid B: ({vx[1]}, {vy[1]})\n");

    // --- 3. Inspect Final Soft Memberships ---
    print("--- 3. Continuous Membership Degrees u_{ij} ---");
    let core_a_high = true;
    let core_b_high = true;
    let boundary_split = false;

    for (let i = 0; i < n_samples; i++) {
        let u0 = u_mat[i * n_clusters + 0];
        let u1 = u_mat[i * n_clusters + 1];

        print(f"  Point #{i} ({px[i]}, {py[i]}): P(Cluster A) = {u0 * 100.0}% | P(Cluster B) = {u1 * 100.0}%");

        if (i < 2 && u0 < 0.90) { core_a_high = false; }
        if ((i == 2 || i == 3) && u1 < 0.90) { core_b_high = false; }
        if (i == 4) {
            let diff = u0 - u1;
            if (diff < 0.0) { diff = -diff; }
            if (diff < 0.05) { boundary_split = true; }
        }
    }
    print("");

    if (core_a_high && core_b_high && boundary_split) {
        print("  SUCCESS: Fuzzy C-Means correctly captured core memberships (>95%) and split midpoint (50/50)!\n");
    }

    print("==================================================================");
    print("Fuzzy C-Means (FCM) verified with 0 memory leaks!");
    return 0;
}
