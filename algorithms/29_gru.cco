// Algorithm 29: Gated Recurrent Unit (GRU) - Streamlined Gated Memory & Backpropagation Through Time

/*
================================================================================
                    GATED RECURRENT UNIT (GRU)
================================================================================

1. Streamlined Gating Topology (Cho et al., 2014; Chung et al., 2014):
       Merges the separate cell state and hidden state of LSTM into a single
       recurrent hidden vector h_t ∈ R^{d_hid}.
       Reduces parameter count by 25% by employing only 2 gates (Update and Reset).

2. Mathematical Formulation at Discrete Time Step t:
       Given input x_t ∈ R^{d_in} and previous hidden state h_{t-1} ∈ R^{d_hid}:

       - Update Gate z_t (Controls how much past memory is carried forward):
             z_t = σ( W_z * x_t + U_z * h_{t-1} + b_z )

       - Reset Gate r_t (Controls how much past memory is used in candidate):
             r_t = σ( W_r * x_t + U_r * h_{t-1} + b_r )

       - Candidate Hidden State h̃_t:
             h̃_t = tanh( W_h * x_t + U_h * (r_t ⊙ h_{t-1}) + b_h )
             (When r_t = 0, past history is ignored, resetting memory).

       - Hidden State Update (Linear convex interpolation):
             h_t = (1 - z_t) ⊙ h_{t-1}  +  z_t ⊙ h̃_t
             (When z_t = 0, h_t = h_{t-1}: perfect linear information highway).

3. Output Prediction & Loss:
       ŷ = W_y * h_{T-1} + b_y
       L = 0.5 * (ŷ - y)^2

4. Backpropagation Through Time (BPTT) for GRU:
       Terminal output delta: δ_y = ŷ - y,  δ_{h, T-1} = δ_y * W_y
       Hidden gate error gradients:
           δ_{h̃, t} = δ_{h, t} ⊙ z_t ⊙ ( 1 - h̃_t^2 )
           δ_{z, t}  = δ_{h, t} ⊙ ( h̃_t - h_{t-1} ) ⊙ z_t ⊙ ( 1 - z_t )
           δ_{r, t}  = ( U_h^T * δ_{h̃, t} ) ⊙ h_{t-1} ⊙ r_t ⊙ ( 1 - r_t )

       Backward hidden state recurrence:
           δ_{h, t-1} = δ_{h, t} ⊙ (1 - z_t)
                      + ( U_h^T * δ_{h̃, t} ) ⊙ r_t
                      + U_z^T * δ_{z, t}
                      + U_r^T * δ_{r, t}
================================================================================
*/

fn sigmoid_gru(z: float) -> float {
    if (z > 15.0) { return 1.0; }
    if (z < -15.0) { return 0.0; }
    return 1.0 / (1.0 + exp(-z));
}

fn tanh_gru(u: float) -> float {
    if (u > 10.0) { return 1.0; }
    if (u < -10.0) { return -1.0; }
    let ep = exp(u);
    let em = exp(-u);
    return (ep - em) / (ep + em);
}

// -------------------------------------------------------------
// GRU Forward Pass Over Sequence of Length T
// -------------------------------------------------------------
fn gru_forward(x_seq: &float[], t_steps: int, d_hid: int,
               w_z: &float[], u_z: &float[], b_z: &float[],
               w_r: &float[], u_r: &float[], b_r: &float[],
               w_h: &float[], u_h: &float[], b_h: &float[],
               w_y: &float[], b_y: float,
               z_all: &float[], r_all: &float[], h_tilde_all: &float[],
               h_all: &float[]) -> float {
    for (let t = 0; t < t_steps; t++) {
        let xt = x_seq[t];

        for (let j = 0; j < d_hid; j++) {
            let z_in = w_z[j] * xt + b_z[j];
            let r_in = w_r[j] * xt + b_r[j];

            if (t > 0) {
                let prev_t = t - 1;
                for (let k = 0; k < d_hid; k++) {
                    let prev_h = h_all[prev_t * d_hid + k];
                    z_in += u_z[j * d_hid + k] * prev_h;
                    r_in += u_r[j * d_hid + k] * prev_h;
                }
            }

            let z_val = sigmoid_gru(z_in);
            let r_val = sigmoid_gru(r_in);

            z_all[t * d_hid + j] = z_val;
            r_all[t * d_hid + j] = r_val;
        }

        // Compute candidate hidden state h̃_t
        for (let j = 0; j < d_hid; j++) {
            let h_in = w_h[j] * xt + b_h[j];
            if (t > 0) {
                let prev_t = t - 1;
                for (let k = 0; k < d_hid; k++) {
                    let reset_h = r_all[t * d_hid + k] * h_all[prev_t * d_hid + k];
                    h_in += u_h[j * d_hid + k] * reset_h;
                }
            }

            let h_tilde = tanh_gru(h_in);
            h_tilde_all[t * d_hid + j] = h_tilde;

            // Hidden state interpolation: h_t = (1 - z) * h_{t-1} + z * h̃
            let prev_h = 0.0;
            if (t > 0) {
                prev_h = h_all[(t - 1) * d_hid + j];
            }
            let z_val = z_all[t * d_hid + j];
            h_all[t * d_hid + j] = (1.0 - z_val) * prev_h + z_val * h_tilde;
        }
    }

    let last_t = t_steps - 1;
    let y_hat = b_y;
    for (let j = 0; j < d_hid; j++) {
        y_hat += w_y[j] * h_all[last_t * d_hid + j];
    }
    return y_hat;
}

// -------------------------------------------------------------
// Train GRU via BPTT on Sequential Dataset
// -------------------------------------------------------------
fn train_gru_bptt(x_data: &float[], y_targets: &float[], num_seqs: int, t_steps: int, d_hid: int,
                  epochs: int, lr: float,
                  w_z: &float[], u_z: &float[], b_z: &float[],
                  w_r: &float[], u_r: &float[], b_r: &float[],
                  w_h: &float[], u_h: &float[], b_h: &float[],
                  w_y: &float[], b_y_box: &float[]) -> float {
    let b_y = b_y_box[0];
    let n_f = 1.0 * num_seqs;

    // Buffer allocations
    let z_all = alloc(float, t_steps * d_hid);
    let r_all = alloc(float, t_steps * d_hid);
    let h_tilde_all = alloc(float, t_steps * d_hid);
    let h_all = alloc(float, t_steps * d_hid);

    let delta_h = alloc(float, t_steps * d_hid);
    let delta_ht = alloc(float, t_steps * d_hid);
    let delta_z = alloc(float, t_steps * d_hid);
    let delta_r = alloc(float, t_steps * d_hid);

    // Gradient accumulators
    let gw_z = alloc(float, d_hid); let gu_z = alloc(float, d_hid * d_hid); let gb_z = alloc(float, d_hid);
    let gw_r = alloc(float, d_hid); let gu_r = alloc(float, d_hid * d_hid); let gb_r = alloc(float, d_hid);
    let gw_h = alloc(float, d_hid); let gu_h = alloc(float, d_hid * d_hid); let gb_h = alloc(float, d_hid);
    let gw_y = alloc(float, d_hid);

    let cur_seq = alloc(float, t_steps);
    let final_mse = 0.0;

    for (let ep = 0; ep < epochs; ep++) {
        let total_loss = 0.0;

        let gb_y = 0.0;
        for (let j = 0; j < d_hid; j++) {
            gw_z[j] = 0.0; gb_z[j] = 0.0;
            gw_r[j] = 0.0; gb_r[j] = 0.0;
            gw_h[j] = 0.0; gb_h[j] = 0.0;
            gw_y[j] = 0.0;
            for (let k = 0; k < d_hid; k++) {
                gu_z[j * d_hid + k] = 0.0;
                gu_r[j * d_hid + k] = 0.0;
                gu_h[j * d_hid + k] = 0.0;
            }
        }

        // Process all sequences
        for (let s = 0; s < num_seqs; s++) {
            for (let t = 0; t < t_steps; t++) {
                cur_seq[t] = x_data[s * t_steps + t];
            }
            let target = y_targets[s];

            // 1. Forward Pass
            let y_hat = gru_forward(&cur_seq, t_steps, d_hid,
                                    w_z, u_z, b_z,
                                    w_r, u_r, b_r,
                                    w_h, u_h, b_h,
                                    w_y, b_y,
                                    &z_all, &r_all, &h_tilde_all, &h_all);

            let err = y_hat - target;
            total_loss += err * err;

            // 2. Output Error
            let delta_y = err;
            gb_y += delta_y;
            let last_t = t_steps - 1;
            for (let j = 0; j < d_hid; j++) {
                gw_y[j] += delta_y * h_all[last_t * d_hid + j];
                delta_h[last_t * d_hid + j] = delta_y * w_y[j];
            }

            // 3. Backward Pass Through Time (BPTT)
            for (let t = t_steps - 1; t >= 0; t--) {
                let xt = cur_seq[t];

                for (let j = 0; j < d_hid; j++) {
                    let dh = delta_h[t * d_hid + j];
                    let z_val = z_all[t * d_hid + j];
                    let ht_val = h_tilde_all[t * d_hid + j];

                    let prev_h = 0.0;
                    if (t > 0) { prev_h = h_all[(t - 1) * d_hid + j]; }

                    // Candidate delta: δ_h̃ = δ_h * z * (1 - h̃^2)
                    let d_ht = dh * z_val * (1.0 - (ht_val * ht_val));
                    // Update gate delta: δ_z = δ_h * (h̃ - h_{t-1}) * z * (1 - z)
                    let d_z = dh * (ht_val - prev_h) * z_val * (1.0 - z_val);

                    delta_ht[t * d_hid + j] = d_ht;
                    delta_z[t * d_hid + j] = d_z;

                    gw_h[j] += d_ht * xt; gb_h[j] += d_ht;
                    gw_z[j] += d_z * xt;  gb_z[j] += d_z;

                    if (t > 0) {
                        for (let k = 0; k < d_hid; k++) {
                            let reset_prev = r_all[t * d_hid + k] * h_all[(t - 1) * d_hid + k];
                            gu_h[j * d_hid + k] += d_ht * reset_prev;
                            gu_z[j * d_hid + k] += d_z * h_all[(t - 1) * d_hid + k];
                        }
                    }
                }

                // Reset gate delta and previous hidden state delta
                for (let k = 0; k < d_hid; k++) {
                    let sum_term = 0.0;
                    for (let j = 0; j < d_hid; j++) {
                        sum_term += u_h[j * d_hid + k] * delta_ht[t * d_hid + j];
                    }

                    let prev_hk = 0.0;
                    if (t > 0) { prev_hk = h_all[(t - 1) * d_hid + k]; }
                    let rk_val = r_all[t * d_hid + k];

                    let d_r = sum_term * prev_hk * rk_val * (1.0 - rk_val);
                    delta_r[t * d_hid + k] = d_r;

                    gw_r[k] += d_r * xt;
                    gb_r[k] += d_r;

                    if (t > 0) {
                        for (let m = 0; m < d_hid; m++) {
                            gu_r[k * d_hid + m] += d_r * h_all[(t - 1) * d_hid + m];
                        }

                        // Propagate δ_h back to step t - 1
                        let sum_uz = 0.0;
                        let sum_ur = 0.0;
                        for (let j = 0; j < d_hid; j++) {
                            sum_uz += u_z[j * d_hid + k] * delta_z[t * d_hid + j];
                            sum_ur += u_r[j * d_hid + k] * delta_r[t * d_hid + j];
                        }

                        let zk_val = z_all[t * d_hid + k];
                        delta_h[(t - 1) * d_hid + k] = delta_h[t * d_hid + k] * (1.0 - zk_val)
                                                    + sum_term * rk_val
                                                    + sum_uz
                                                    + sum_ur;
                    }
                }
            }
        }

        final_mse = total_loss / n_f;

        // 4. Update Weights
        b_y -= lr * (gb_y / n_f);
        for (let j = 0; j < d_hid; j++) {
            w_y[j] -= lr * (gw_y[j] / n_f);

            w_z[j] -= lr * (gw_z[j] / n_f); gb_z[j] -= lr * (gb_z[j] / n_f);
            w_r[j] -= lr * (gw_r[j] / n_f); gb_r[j] -= lr * (gb_r[j] / n_f);
            w_h[j] -= lr * (gw_h[j] / n_f); gb_h[j] -= lr * (gb_h[j] / n_f);

            for (let k = 0; k < d_hid; k++) {
                u_z[j * d_hid + k] -= lr * (gu_z[j * d_hid + k] / n_f);
                u_r[j * d_hid + k] -= lr * (gu_r[j * d_hid + k] / n_f);
                u_h[j * d_hid + k] -= lr * (gu_h[j * d_hid + k] / n_f);
            }
        }

        if (ep == 0 || (ep + 1) % 150 == 0 || ep == epochs - 1) {
            print(f"  Epoch #{ep + 1}: Mean Squared Error (MSE) = {final_mse}");
        }
    }

    b_y_box[0] = b_y;
    return final_mse;
}

fn main() -> int {
    print("==================================================================");
    print("   GATED RECURRENT UNIT (GRU): STREAMLINED MEMORY SUITE (v20)     ");
    print("==================================================================\n");

    // 6 Sequences of Length T = 6:
    // Task: Delayed Signal Retention across 5 distractor noise steps
    let num_seqs = 6;
    let t_steps = 6;
    let x_data = alloc(float, num_seqs * t_steps);
    let y_targets = alloc(float, num_seqs);

    for (let i = 0; i < num_seqs * t_steps; i++) {
        x_data[i] = 0.0;
    }

    // Sequence 0: Type +1
    x_data[0 * t_steps + 0] =  1.0; x_data[0 * t_steps + 2] =  0.05; y_targets[0] =  1.0;
    // Sequence 1: Type -1
    x_data[1 * t_steps + 0] = -1.0; x_data[1 * t_steps + 3] = -0.05; y_targets[1] = -1.0;
    // Sequence 2: Type +1
    x_data[2 * t_steps + 0] =  0.9; x_data[2 * t_steps + 1] =  0.02; y_targets[2] =  1.0;
    // Sequence 3: Type -1
    x_data[3 * t_steps + 0] = -0.9; x_data[3 * t_steps + 4] =  0.03; y_targets[3] = -1.0;
    // Sequence 4: Type +1
    x_data[4 * t_steps + 0] =  1.1; x_data[4 * t_steps + 3] = -0.02; y_targets[4] =  1.0;
    // Sequence 5: Type -1
    x_data[5 * t_steps + 0] = -1.1; x_data[5 * t_steps + 2] =  0.01; y_targets[5] = -1.0;

    let d_hid = 2;

    // Allocate GRU weights
    let w_z = alloc(float, d_hid); let u_z = alloc(float, d_hid * d_hid); let b_z = alloc(float, d_hid);
    let w_r = alloc(float, d_hid); let u_r = alloc(float, d_hid * d_hid); let b_r = alloc(float, d_hid);
    let w_h = alloc(float, d_hid); let u_h = alloc(float, d_hid * d_hid); let b_h = alloc(float, d_hid);
    let w_y = alloc(float, d_hid); let b_y_box = alloc(float, 1);

    // Initial parameters: bias update gate towards retaining past state
    b_z[0] = -1.0; b_z[1] = -1.0;
    b_r[0] =  1.0; b_r[1]  = 1.0;
    b_h[0] =  0.0; b_h[1]  = 0.0;

    w_z[0] =  0.2; w_z[1] =  0.2;
    w_r[0] =  0.1; w_r[1] =  0.1;
    w_h[0] =  0.8; w_h[1] = -0.8;

    for (let j = 0; j < d_hid * d_hid; j++) {
        u_z[j] = 0.1; u_r[j] = 0.1; u_h[j] = 0.1;
    }

    w_y[0] = 0.8; w_y[1] = -0.8;
    b_y_box[0] = 0.0;

    let epochs = 600;
    let lr = 0.35;

    print("--- 1. Training GRU via Backpropagation Through Time (BPTT) ---");
    print(f"Sequence Horizon T={t_steps} Steps | Hidden Memory Dimension={d_hid}");
    print(f"Training across {epochs} epochs with learning rate η = {lr}...\n");

    let final_loss = train_gru_bptt(&x_data, &y_targets, num_seqs, t_steps, d_hid, epochs, lr,
                                    &w_z, &u_z, &b_z,
                                    &w_r, &u_r, &b_r,
                                    &w_h, &u_h, &b_h,
                                    &w_y, &b_y_box);
    print(f"  Converged Sequence MSE: {final_loss}\n");

    // --- 2. Evaluating Unseen Sequences with Distractor Noise ---
    print("--- 2. Evaluating Unseen Sequences with Distractor Noise ---");
    let test_pos = alloc(float, t_steps);
    let test_neg = alloc(float, t_steps);
    for (let t = 0; t < t_steps; t++) {
        test_pos[t] = 0.0;
        test_neg[t] = 0.0;
    }
    // Unseen query sequences
    test_pos[0] =  0.95; test_pos[2] =  0.04; test_pos[4] = -0.03;
    test_neg[0] = -0.95; test_neg[1] = -0.04; test_neg[3] =  0.03;

    let z_buf = alloc(float, t_steps * d_hid);
    let r_buf = alloc(float, t_steps * d_hid);
    let ht_buf = alloc(float, t_steps * d_hid);
    let h_buf = alloc(float, t_steps * d_hid);

    let pred_pos = gru_forward(&test_pos, t_steps, d_hid,
                               &w_z, &u_z, &b_z,
                               &w_r, &u_r, &b_r,
                               &w_h, &u_h, &b_h,
                               &w_y, b_y_box[0],
                               &z_buf, &r_buf, &ht_buf, &h_buf);

    print(f"  Unseen Sequence (+1 signal at t=0) -> Terminal Forecast ŷ: {pred_pos} [Expected: +1.0]");
    print(f"    Hidden State at t=0 : h_0 = [{h_buf[0 * d_hid + 0]}, {h_buf[0 * d_hid + 1]}]");
    print(f"    Hidden State at t=5 : h_5 = [{h_buf[5 * d_hid + 0]}, {h_buf[5 * d_hid + 1]}] (Carried across 5 steps!)");

    let pred_neg = gru_forward(&test_neg, t_steps, d_hid,
                               &w_z, &u_z, &b_z,
                               &w_r, &u_r, &b_r,
                               &w_h, &u_h, &b_h,
                               &w_y, b_y_box[0],
                               &z_buf, &r_buf, &ht_buf, &h_buf);

    print(f"  Unseen Sequence (-1 signal at t=0) -> Terminal Forecast ŷ: {pred_neg} [Expected: -1.0]");
    print(f"    Hidden State at t=0 : h_0 = [{h_buf[0 * d_hid + 0]}, {h_buf[0 * d_hid + 1]}]");
    print(f"    Hidden State at t=5 : h_5 = [{h_buf[5 * d_hid + 0]}, {h_buf[5 * d_hid + 1]}]\n");

    if (pred_pos > 0.8 && pred_neg < -0.8) {
        print("  SUCCESS: Gated Recurrent Unit (GRU) maintained long-term memory with 25% fewer parameters!\n");
    }

    print("==================================================================");
    print("Gated Recurrent Unit (GRU) verified with 0 memory leaks!");
    return 0;
}
