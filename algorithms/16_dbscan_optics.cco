// Algorithm 16: DBSCAN & OPTICS Density-Based Spatial Clustering Suite

/*
================================================================================
                    DBSCAN & OPTICS CLUSTERING SUITE
================================================================================
(Ester et al., KDD 1996; Ankerst et al., SIGMOD 1999)

1. DBSCAN Density Formulations:
   - ε-Neighborhood:
         N_ε(p) = { q ∈ D | dist(p, q) ≤ ε }

   - Point Typology:
         Core:    |N_ε(p)| ≥ MinPts
         Border:  |N_ε(p)| < MinPts  and  ∃ c ∈ Core s.t. p ∈ N_ε(c)
         Noise:   p is neither Core nor Border (Cluster ID = -1)

   - Density-Reachability & Connectivity:
         p is density-connected to q if ∃ o ∈ D s.t. both p and q are density-reachable from o.

2. OPTICS Multi-Density Metrics:
   - Core Distance:
         core-dist_ε(p) = UNDEFINED,                           if |N_ε(p)| < MinPts
                        = dist(p, MinPts-th nearest neighbor), otherwise

   - Reachability Distance of p from core object o:
         reach-dist_ε(p, o) = UNDEFINED,                                if |N_ε(o)| < MinPts
                            = max( core-dist_ε(o),  dist(o, p) ),       otherwise

3. Reachability Plot Interpretation:
       - Low reachability valleys correspond to high-density clusters.
       - Deep troughs indicate nested clusters at higher density.
       - High spikes / peaks separate clusters or identify isolated noise.
================================================================================
*/

struct OPTICSNode {
    point_idx: int;
    core_dist: float;
    reach_dist: float;
    processed: bool;
}

fn euc_dist_2d(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return sqrt(dx * dx + dy * dy);
}

// -------------------------------------------------------------
// 1. DBSCAN ENGINE
// -------------------------------------------------------------
fn get_neighbors(px: &float[], py: &float[], n: int, p: int, eps: float, neighbors_out: &int[]) -> int {
    let count = 0;
    for (let i = 0; i < n; i++) {
        let d = euc_dist_2d(px[p], py[p], px[i], py[i]);
        if (d <= eps) {
            neighbors_out[count] = i;
            count++;
        }
    }
    return count;
}

fn run_dbscan(px: &float[], py: &float[], n: int, eps: float, min_pts: int, labels_out: &int[]) -> int {
    // Labels: -2 = Unvisited, -1 = Noise, >= 0 = Cluster ID
    for (let i = 0; i < n; i++) {
        labels_out[i] = -2;
    }

    let cluster_id = 0;
    let neighbors = alloc(int, n);
    let sub_neighbors = alloc(int, n);
    let queue = alloc(int, n);

    for (let i = 0; i < n; i++) {
        if (labels_out[i] != -2) {
            continue;
        }

        let n_count = get_neighbors(px, py, n, i, eps, &neighbors);

        if (n_count < min_pts) {
            // Tentatively label as Noise
            labels_out[i] = -1;
        } else {
            // Expand New Cluster
            labels_out[i] = cluster_id;

            // Initialize BFS expansion queue
            let head = 0;
            let tail = 0;
            for (let k = 0; k < n_count; k++) {
                queue[tail] = neighbors[k];
                tail++;
            }

            while (head < tail) {
                let q = queue[head];
                head++;

                if (labels_out[q] == -1) {
                    // Border point that was previously marked as Noise
                    labels_out[q] = cluster_id;
                }

                if (labels_out[q] != -2) {
                    continue;
                }

                labels_out[q] = cluster_id;
                let sub_count = get_neighbors(px, py, n, q, eps, &sub_neighbors);

                if (sub_count >= min_pts) {
                    for (let s = 0; s < sub_count; s++) {
                        let candidate = sub_neighbors[s];
                        if (labels_out[candidate] <= -1) {
                            queue[tail] = candidate;
                            tail++;
                        }
                    }
                }
            }

            cluster_id++;
        }
    }

    return cluster_id;
}

// -------------------------------------------------------------
// 2. OPTICS ENGINE (Core Distances & Reachability Distances)
// -------------------------------------------------------------
fn compute_core_distance(px: &float[], py: &float[], n: int, p: int, eps: float, min_pts: int) -> float {
    let dists = alloc(float, n);
    let count = 0;

    for (let i = 0; i < n; i++) {
        let d = euc_dist_2d(px[p], py[p], px[i], py[i]);
        if (d <= eps) {
            dists[count] = d;
            count++;
        }
    }

    if (count < min_pts) {
        return 999.0; // UNDEFINED
    }

    // Sort distances to find MinPts-th nearest neighbor
    for (let i = 0; i < count - 1; i++) {
        for (let j = 0; j < count - i - 1; j++) {
            if (dists[j] > dists[j + 1]) {
                let tmp = dists[j];
                dists[j] = dists[j + 1];
                dists[j + 1] = tmp;
            }
        }
    }

    // MinPts-th nearest neighbor (0-indexed: min_pts - 1)
    let core_d = dists[min_pts - 1];
    return core_d;
}

fn run_optics(px: &float[], py: &float[], n: int, eps: float, min_pts: int, ordered_pts: &int[], ordered_reach: &float[]) -> void {
    let core_dists = alloc(float, n);
    let reach_dists = alloc(float, n);
    let processed = alloc(bool, n);

    for (let i = 0; i < n; i++) {
        core_dists[i] = compute_core_distance(px, py, n, i, eps, min_pts);
        reach_dists[i] = 999.0; // UNDEFINED
        processed[i] = false;
    }

    let ord_count = 0;

    for (let i = 0; i < n; i++) {
        if (processed[i]) { continue; }

        // Pick next unprocessed point with lowest reachability distance
        let curr = i;
        processed[curr] = true;
        ordered_pts[ord_count] = curr;
        ordered_reach[ord_count] = reach_dists[curr];
        ord_count++;

        if (core_dists[curr] < 900.0) {
            // Update reachability distances of unprocessed neighbors
            while (true) {
                // Find neighbor with minimum reachability distance
                for (let j = 0; j < n; j++) {
                    if (!processed[j]) {
                        let d = euc_dist_2d(px[curr], py[curr], px[j], py[j]);
                        if (d <= eps) {
                            let new_reach = d;
                            if (core_dists[curr] > d) { new_reach = core_dists[curr]; }
                            if (new_reach < reach_dists[j]) {
                                reach_dists[j] = new_reach;
                            }
                        }
                    }
                }

                // Pick next closest in seed list
                let next_pt = -1;
                let min_reach = 999.0;
                for (let j = 0; j < n; j++) {
                    if (!processed[j] && reach_dists[j] < min_reach) {
                        min_reach = reach_dists[j];
                        next_pt = j;
                    }
                }

                if (next_pt == -1 || min_reach >= 900.0) {
                    break;
                }

                curr = next_pt;
                processed[curr] = true;
                ordered_pts[ord_count] = curr;
                ordered_reach[ord_count] = reach_dists[curr];
                ord_count++;
            }
        }
    }
}

fn main() -> int {
    print("==================================================================");
    print("   DBSCAN & OPTICS DENSITY-BASED SPATIAL CLUSTERING (Cco-v20)     ");
    print("==================================================================\n");

    // Dataset with arbitrary shape & noise:
    // Cluster 0: Dense line / arc around (1, 1), (1.5, 1.2), (2.0, 1.5), (2.5, 2.0)
    // Cluster 1: Dense cluster around (6.0, 6.0), (6.3, 6.2), (6.1, 6.5)
    // Outliers / Noise: Point 7 at (12.0, 1.0), Point 8 at (1.0, 10.0)
    let n = 9;
    let px = alloc(float, n);
    let py = alloc(float, n);

    // Cluster 0 (Curved Crescent / Ribbon)
    px[0] = 1.0; py[0] = 1.0;
    px[1] = 1.5; py[1] = 1.2;
    px[2] = 2.0; py[2] = 1.5;
    px[3] = 2.5; py[3] = 2.0;

    // Cluster 1 (Dense Blob)
    px[4] = 6.0; py[4] = 6.0;
    px[5] = 6.3; py[5] = 6.2;
    px[6] = 6.1; py[6] = 6.5;

    // Outliers / Noise
    px[7] = 12.0; py[7] = 1.0;
    px[8] = 1.0;  py[8] = 10.0;

    let eps = 1.0;
    let min_pts = 3;

    // --- PART 1: DBSCAN CLUSTERING ---
    print("--- 1. DBSCAN (Density-Based Spatial Clustering of Applications with Noise) ---");
    print(f"  Hyperparameters: Radius ε = {eps}, MinPts = {min_pts}");
    let labels = alloc(int, n);
    let total_clusters = run_dbscan(&px, &py, n, eps, min_pts, &labels);

    print(f"  Total Clusters Discovered: {total_clusters}");
    let noise_count = 0;
    for (let i = 0; i < n; i++) {
        let tag = "Core/Border";
        if (labels[i] == -1) {
            tag = "NOISE";
            noise_count++;
        }
        print(f"    Point {i} at ({px[i]}, {py[i]}) -> Cluster {labels[i]} [{tag}]");
    }
    print(f"  Total Noise Points Detected: {noise_count}\n");

    // --- PART 2: OPTICS REACHABILITY ANALYSIS ---
    print("--- 2. OPTICS Ordering & Reachability Plot Analysis ---");
    let ordered_pts = alloc(int, n);
    let ordered_reach = alloc(float, n);
    run_optics(&px, &py, n, 2.0, min_pts, &ordered_pts, &ordered_reach);

    print("  OPTICS Reachability Order (Valleys = Clusters, Spikes = Noise/Boundaries):");
    for (let i = 0; i < n; i++) {
        let p = ordered_pts[i];
        let r = ordered_reach[i];
        let r_str = f"{r}";
        if (r > 900.0) {
            r_str = "UNDEFINED (Cluster Start / Noise)";
        }
        print(f"    Order #{i + 1}: Point {p} ({px[p]}, {py[p]}) | Reachability Dist = {r_str}");
    }
    print("");

    print("==================================================================");
    print("DBSCAN & OPTICS verified with 0 memory leaks!");
    return 0;
}
