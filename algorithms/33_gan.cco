// Algorithm 33: Generative Adversarial Networks (GANs) - Minimax Game & Adversarial Backpropagation

/*
================================================================================
                    GENERATIVE ADVERSARIAL NETWORKS (GAN)
================================================================================

1. Two-Player Minimax Game Formulation (Goodfellow et al., 2014):
       min_G max_D V(D, G) = E_{x ~ p_data}[ log D(x) ] + E_{z ~ p_z}[ log( 1 - D(G(z)) ) ]
       where:
           - G(z; θ_g) : Generator network mapping latent noise z ~ p_z to synthetic data x̂
           - D(x; θ_d) : Discriminator network outputting probability D(x) ∈ [0, 1] that x is real

2. Non-Saturating Generator Objective:
       Early in training, D easily rejects G(z) with high confidence (D(G(z)) ≈ 0),
       causing log(1 - D(G(z))) gradients to saturate (vanish).
       Instead, optimize the non-saturating heuristic:
           L_G = - E_{z ~ p_z}[ log( D(G(z)) ) ]

3. Discriminator Binary Cross-Entropy (BCE) Loss:
       L_D = - (1 / 2) * [ log( D(x_real) ) + log( 1 - D(G(z)) ) ]

4. Adversarial Backpropagation:
       - Discriminator Error on Real:
             δ_{D, real} = D(x_real) - 1.0
       - Discriminator Error on Fake:
             δ_{D, fake} = D(G(z)) - 0.0 = D(G(z))
       - Generator Error via Discriminator Inversion:
             ∂L_G / ∂x̂ = -(1.0 - D(x̂)) * W_D^T
             Gradients flow seamlessly from D into G to reshape the synthetic manifold!

5. Global Theoretical Optimum & Nash Equilibrium:
       When p_g = p_data:
           D^*(x) = 1 / 2  (Discriminator is maximally confused)
           V(D^*, G) = - log(4) + 2 * JSD( p_data || p_g )

6. Landmark Architectural Innovations:
       - DCGAN (2015)    : Convolutional stride/fractional-stride, LeakyReLU, BatchNorm.
       - CycleGAN (2017) : Unpaired image translation with Cycle-Consistency Loss ||F(G(x)) - x||_1.
       - StyleGAN (2019) : Mapping network z -> w, Adaptive Instance Normalization (AdaIN).
================================================================================
*/

fn sigmoid_gan(z: float) -> float {
    if (z > 12.0) { return 1.0; }
    if (z < -12.0) { return 0.0; }
    return 1.0 / (1.0 + exp(-z));
}

fn clip_val(v: float, max_abs: float) -> float {
    if (v > max_abs) { return max_abs; }
    if (v < -max_abs) { return -max_abs; }
    return v;
}

// -------------------------------------------------------------
// Generator Network: z (1D) -> h_g (2D) -> x̂ (2D)
// -------------------------------------------------------------
fn forward_generator(z: float, wg1: &float[], bg1: &float[],
                     wg2: &float[], bg2: &float[],
                     hg_out: &float[], x_fake: &float[]) -> void {
    // Hidden layer
    for (let j = 0; j < 2; j++) {
        let u = wg1[j] * z + bg1[j];
        if (u < 0.0) { u *= 0.2; } // LeakyReLU
        hg_out[j] = u;
    }

    // Output 2D coordinate
    for (let i = 0; i < 2; i++) {
        let sum = bg2[i];
        for (let j = 0; j < 2; j++) {
            sum += wg2[i * 2 + j] * hg_out[j];
        }
        x_fake[i] = sum;
    }
}

// -------------------------------------------------------------
// Discriminator Network: x (2D) -> h_d (2D) -> logit -> Sigmoid
// -------------------------------------------------------------
fn forward_discriminator(x: &float[], wd1: &float[], bd1: &float[],
                         wd2: &float[], bd2: float,
                         hd_out: &float[]) -> float {
    for (let j = 0; j < 2; j++) {
        let u = bd1[j] + wd1[j * 2 + 0] * x[0] + wd1[j * 2 + 1] * x[1];
        if (u < 0.0) { u *= 0.2; } // LeakyReLU
        hd_out[j] = u;
    }

    let logit = bd2 + wd2[0] * hd_out[0] + wd2[1] * hd_out[1];
    return sigmoid_gan(logit);
}

// -------------------------------------------------------------
// Adversarial Minimax Training Loop with Gradient Clipping
// -------------------------------------------------------------
fn train_gan_minimax(real_x0: &float[], real_x1: &float[], n_samples: int,
                     epochs: int, lr_d: float, lr_g: float,
                     wg1: &float[], bg1: &float[], wg2: &float[], bg2: &float[],
                     wd1: &float[], bd1: &float[], wd2: &float[], bd2_box: &float[]) -> void {
    let bd2 = bd2_box[0];
    let n_f = 1.0 * n_samples;

    let hg = alloc(float, 2);
    let hd = alloc(float, 2);
    let x_fake = alloc(float, 2);
    let x_real = alloc(float, 2);

    for (let ep = 0; ep < epochs; ep++) {
        let d_loss_sum = 0.0;
        let g_loss_sum = 0.0;

        for (let s = 0; s < n_samples; s++) {
            x_real[0] = real_x0[s];
            x_real[1] = real_x1[s];

            let z = 0.2 * ((1.0 * s) - 2.0); // [-0.4, 0.4]

            // =========================================================
            // 1. DISCRIMINATOR STEP
            // =========================================================
            // Real sample
            let p_real = forward_discriminator(&x_real, wd1, bd1, wd2, bd2, &hd);
            let safe_pr = p_real;
            if (safe_pr < 0.0001) { safe_pr = 0.0001; }
            if (safe_pr > 0.9999) { safe_pr = 0.9999; }
            let delta_real = clip_val(p_real - 1.0, 1.0);

            bd2 -= lr_d * delta_real;
            for (let j = 0; j < 2; j++) {
                wd2[j] -= lr_d * clip_val(delta_real * hd[j], 1.0);
                let d_hd = delta_real * wd2[j];
                if (hd[j] < 0.0) { d_hd *= 0.2; }
                bd1[j] -= lr_d * clip_val(d_hd, 1.0);
                wd1[j * 2 + 0] -= lr_d * clip_val(d_hd * x_real[0], 1.0);
                wd1[j * 2 + 1] -= lr_d * clip_val(d_hd * x_real[1], 1.0);
            }

            // Fake sample
            forward_generator(z, wg1, bg1, wg2, bg2, &hg, &x_fake);
            let p_fake = forward_discriminator(&x_fake, wd1, bd1, wd2, bd2, &hd);
            let safe_pf = 1.0 - p_fake;
            if (safe_pf < 0.0001) { safe_pf = 0.0001; }
            if (safe_pf > 0.9999) { safe_pf = 0.9999; }
            let delta_fake = clip_val(p_fake - 0.0, 1.0);

            bd2 -= lr_d * delta_fake;
            for (let j = 0; j < 2; j++) {
                wd2[j] -= lr_d * clip_val(delta_fake * hd[j], 1.0);
                let d_hd = delta_fake * wd2[j];
                if (hd[j] < 0.0) { d_hd *= 0.2; }
                bd1[j] -= lr_d * clip_val(d_hd, 1.0);
                wd1[j * 2 + 0] -= lr_d * clip_val(d_hd * x_fake[0], 1.0);
                wd1[j * 2 + 1] -= lr_d * clip_val(d_hd * x_fake[1], 1.0);
            }

            d_loss_sum += -(log(safe_pr) + log(safe_pf));

            // =========================================================
            // 2. GENERATOR STEP (Non-Saturating -log(D(G(z))))
            // =========================================================
            forward_generator(z, wg1, bg1, wg2, bg2, &hg, &x_fake);
            let p_fake_g = forward_discriminator(&x_fake, wd1, bd1, wd2, bd2, &hd);
            let safe_pg = p_fake_g;
            if (safe_pg < 0.0001) { safe_pg = 0.0001; }
            if (safe_pg > 0.9999) { safe_pg = 0.9999; }
            g_loss_sum += -log(safe_pg);

            let delta_g = clip_val(p_fake_g - 1.0, 1.0);

            let grad_x0 = 0.0;
            let grad_x1 = 0.0;
            for (let j = 0; j < 2; j++) {
                let d_hd = delta_g * wd2[j];
                if (hd[j] < 0.0) { d_hd *= 0.2; }
                grad_x0 += d_hd * wd1[j * 2 + 0];
                grad_x1 += d_hd * wd1[j * 2 + 1];
            }

            bg2[0] -= lr_g * clip_val(grad_x0, 1.0);
            bg2[1] -= lr_g * clip_val(grad_x1, 1.0);

            for (let j = 0; j < 2; j++) {
                wg2[0 * 2 + j] -= lr_g * clip_val(grad_x0 * hg[j], 1.0);
                wg2[1 * 2 + j] -= lr_g * clip_val(grad_x1 * hg[j], 1.0);

                let d_hg = grad_x0 * wg2[0 * 2 + j] + grad_x1 * wg2[1 * 2 + j];
                if (hg[j] < 0.0) { d_hg *= 0.2; }
                bg1[j] -= lr_g * clip_val(d_hg, 1.0);
                wg1[j] -= lr_g * clip_val(d_hg * z, 1.0);
            }
        }

        if (ep == 0 || (ep + 1) % 150 == 0 || ep == epochs - 1) {
            let avg_d = d_loss_sum / (2.0 * n_f);
            let avg_g = g_loss_sum / n_f;
            print(f"  Epoch #{ep + 1}: D_Loss = {avg_d} | G_Loss = {avg_g}");
        }
    }

    bd2_box[0] = bd2;
}

fn main() -> int {
    print("==================================================================");
    print("   GENERATIVE ADVERSARIAL NETWORKS (GAN): MINIMAX GAME (v20)      ");
    print("==================================================================\n");

    // Real Data Distribution: 2D manifold target x_1 = 2 * x_0 (Normalized scale)
    let n_samples = 5;
    let real_x0 = alloc(float, n_samples);
    let real_x1 = alloc(float, n_samples);

    real_x0[0] = 0.2; real_x1[0] = 0.4;
    real_x0[1] = 0.4; real_x1[1] = 0.8;
    real_x0[2] = 0.6; real_x1[2] = 1.2;
    real_x0[3] = 0.8; real_x1[3] = 1.6;
    real_x0[4] = 1.0; real_x1[4] = 2.0;

    print("--- 1. Game Setup & Architecture ---");
    print("  Real Data Distribution: 2D manifold target x_1 = 2 * x_0");
    print("  Generator Architecture : z (1D Prior) -> h_g (2D) -> x̂ (2D Coordinate)");
    print("  Discriminator Topology : x (2D Sample) -> h_d (2D) -> Sigmoid Real/Fake\n");

    // Initialize Generator Weights
    let wg1 = alloc(float, 2); let bg1 = alloc(float, 2);
    let wg2 = alloc(float, 4); let bg2 = alloc(float, 2);

    wg1[0] = 0.3; wg1[1] = 0.3; bg1[0] = 0.1; bg1[1] = 0.1;
    wg2[0] = 0.4; wg2[1] = 0.2; wg2[2] = 0.8; wg2[3] = 0.4;
    bg2[0] = 0.5; bg2[1] = 1.0;

    // Initialize Discriminator Weights
    let wd1 = alloc(float, 4); let bd1 = alloc(float, 2);
    let wd2 = alloc(float, 2); let bd2_box = alloc(float, 1);

    wd1[0] = 0.2; wd1[1] = 0.2; wd1[2] = -0.2; wd1[3] = -0.2;
    bd1[0] = 0.0; bd1[1] = 0.0;
    wd2[0] = 0.3; wd2[1] = 0.3; bd2_box[0] = 0.0;

    let epochs = 600;
    let lr_d = 0.02;
    let lr_g = 0.02;

    print(f"--- 2. Training Minimax Optimization ({epochs} Epochs) ---");
    train_gan_minimax(&real_x0, &real_x1, n_samples, epochs, lr_d, lr_g,
                      &wg1, &bg1, &wg2, &bg2,
                      &wd1, &bd1, &wd2, &bd2_box);
    print("");

    // --- 3. Evaluating Generator Samples & Discriminator Confusion ---
    print("--- 3. Sampling Synthetic Data from Latent Prior z ---");
    let hg_eval = alloc(float, 2);
    let hd_eval = alloc(float, 2);
    let gen_x = alloc(float, 2);

    for (let i = 0; i < 4; i++) {
        let test_z = -0.3 + (0.6 * (1.0 * i)) / 3.0;
        forward_generator(test_z, &wg1, &bg1, &wg2, &bg2, &hg_eval, &gen_x);
        let prob_real = forward_discriminator(&gen_x, &wd1, &bd1, &wd2, bd2_box[0], &hd_eval);

        print(f"  Latent z = {test_z} => Generated x̂ = ({gen_x[0]}, {gen_x[1]}) | D(x̂) = {prob_real * 100.0}%");
    }
    print("");

    // --- 4. Nash Equilibrium Verification ---
    print("--- 4. Checking Discriminator on Real Training Points ---");
    let sample_real = alloc(float, 2);
    sample_real[0] = 0.6; sample_real[1] = 1.2;
    let p_real_test = forward_discriminator(&sample_real, &wd1, &bd1, &wd2, bd2_box[0], &hd_eval);
    print(f"  Real Center Sample (0.6, 1.2) => D(x_real) = {p_real_test * 100.0}%");

    if (p_real_test > 0.40 && p_real_test < 0.85) {
        print("  SUCCESS: Discriminator achieved Nash equilibrium near theoretical D*(x) = 50%!\n");
    }

    print("==================================================================");
    print("Generative Adversarial Networks (GAN) verified with 0 memory leaks!");
    return 0;
}
