// Algorithm 59: Q-Learning & SARSA - Model-Free Tabular Temporal-Difference Reinforcement Learning

/*
================================================================================
                    Q-LEARNING vs SARSA (TABULAR TD CONTROL)
================================================================================

1. Model-Free Temporal-Difference (TD) Control (Sutton & Barto, 2018):
       Learns the expected cumulative discounted return Q(s, a) directly from
       environmental transitions (s, a, r, s') without requiring an explicit transition model.

2. Q-Learning (Watkins, 1989) - Off-Policy TD Optimality:
       Updates Q(s, a) using the GREEDY maximum action over next state s':
           Q(s, a) <- Q(s, a) + α * [ r + γ * max_{a'} Q(s', a') - Q(s, a) ]
       - Learns the optimal policy Q* directly regardless of exploratory behavior.
       - Tends to select aggressive paths directly along hazard edges.

3. SARSA (Rummery & Niranjan, 1994) - On-Policy TD Experience:
       Updates Q(s, a) using the ACTUAL action a' taken by the behavior policy:
           Q(s, a) <- Q(s, a) + α * [ r + γ * Q(s', a') - Q(s, a) ]
       - Accounts for exploratory mistakes (e.g. ε-greedy slips into hazards).
       - Learns safer, more conservative routes avoiding perilous cliffs!

4. Cliff Walking Environment:
       Grid: 3 rows x 4 cols (12 States)
       Actions: 0: UP, 1: DOWN, 2: LEFT, 3: RIGHT
       Start: (2, 0) | Goal: (2, 3) | Cliff: (2, 1) and (2, 2)
       Rewards: Goal = +10, Cliff = -50 (resets to start), Step = -1
================================================================================
*/

fn get_next_state(s: int, a: int, n_rows: int, n_cols: int) -> int {
    let r = s / n_cols;
    let c = s % n_cols;

    if (a == 0 && r > 0) { r--; }           // UP
    if (a == 1 && r < n_rows - 1) { r++; }   // DOWN
    if (a == 2 && c > 0) { c--; }           // LEFT
    if (a == 3 && c < n_cols - 1) { c++; }   // RIGHT

    return r * n_cols + c;
}

fn select_action_eps_greedy(s: int, q_table: &float[], n_actions: int, eps_percent: int, seed_box: &int[]) -> int {
    // Pseudo-random number generator
    let rng = seed_box[0] * 1103515245 + 12345;
    if (rng < 0) { rng = -rng; }
    seed_box[0] = rng;

    // Exploration: with probability eps
    if ((rng % 100) < eps_percent) {
        let rng2 = seed_box[0] * 1103515245 + 12345;
        if (rng2 < 0) { rng2 = -rng2; }
        seed_box[0] = rng2;
        return rng2 % n_actions;
    }

    // Exploitation: greedy action
    let best_a = 0;
    let best_q = q_table[s * n_actions + 0];
    for (let a = 1; a < n_actions; a++) {
        let q = q_table[s * n_actions + a];
        if (q > best_q) {
            best_q = q;
            best_a = a;
        }
    }
    return best_a;
}

fn main() -> int {
    print("==================================================================");
    print("   Q-LEARNING vs SARSA: CLIFF WALKING TD BENCHMARK (v20)          ");
    print("==================================================================\n");

    let n_rows = 3;
    let n_cols = 4;
    let n_states = n_rows * n_cols; // 12 states
    let n_actions = 4;              // UP, DOWN, LEFT, RIGHT

    let start_state = 2 * n_cols + 0; // Bottom-Left (2, 0)
    let goal_state  = 2 * n_cols + 3; // Bottom-Right (2, 3)

    print("--- 1. Cliff Walking Grid World Layout (3 x 4) ---");
    print("  [ (0,0)   (0,1)   (0,2)   (0,3) ]  <- Safe High Path");
    print("  [ (1,0)   (1,1)   (1,2)   (1,3) ]  <- Middle Corridor");
    print("  [ START   CLIFF   CLIFF    GOAL ]  <- Perilous Direct Edge\n");

    let alpha = 0.2;
    let gamma = 0.9;
    let eps_train = 15; // 15% exploration
    let episodes = 500;

    // =================================================================
    // 1. Train Q-Learning (Off-Policy)
    // =================================================================
    let q_table_ql = alloc(float, n_states * n_actions);
    for (let i = 0; i < n_states * n_actions; i++) { q_table_ql[i] = 0.0; }

    let seed_box_ql = alloc(int, 1);
    seed_box_ql[0] = 12345;

    for (let ep = 0; ep < episodes; ep++) {
        let s = start_state;

        for (let step = 0; step < 50; step++) {
            if (s == goal_state) { break; }

            let a = select_action_eps_greedy(s, &q_table_ql, n_actions, eps_train, &seed_box_ql);
            let s_next = get_next_state(s, a, n_rows, n_cols);

            let reward = -1.0;
            let is_cliff = false;
            if (s_next == (2 * n_cols + 1) || s_next == (2 * n_cols + 2)) {
                reward = -50.0;
                is_cliff = true;
            } else {
                if (s_next == goal_state) {
                    reward = 10.0;
                }
            }

            // Bellman Optimality Target: max_{a'} Q(s', a')
            let max_next_q = q_table_ql[s_next * n_actions + 0];
            for (let a_p = 1; a_p < n_actions; a_p++) {
                let val = q_table_ql[s_next * n_actions + a_p];
                if (val > max_next_q) { max_next_q = val; }
            }

            if (s_next == goal_state) { max_next_q = 0.0; }

            // Q-Learning Update
            let td_target = reward + gamma * max_next_q;
            let curr_q = q_table_ql[s * n_actions + a];
            q_table_ql[s * n_actions + a] = curr_q + alpha * (td_target - curr_q);

            if (is_cliff) {
                s = start_state; // Reset after falling
            } else {
                s = s_next;
            }
        }
    }

    // =================================================================
    // 2. Train SARSA (On-Policy)
    // =================================================================
    let q_table_sarsa = alloc(float, n_states * n_actions);
    for (let i = 0; i < n_states * n_actions; i++) { q_table_sarsa[i] = 0.0; }

    let seed_box_sarsa = alloc(int, 1);
    seed_box_sarsa[0] = 54321;

    for (let ep = 0; ep < episodes; ep++) {
        let s = start_state;
        let a = select_action_eps_greedy(s, &q_table_sarsa, n_actions, eps_train, &seed_box_sarsa);

        for (let step = 0; step < 50; step++) {
            if (s == goal_state) { break; }

            let s_next = get_next_state(s, a, n_rows, n_cols);

            let reward = -1.0;
            let is_cliff = false;
            if (s_next == (2 * n_cols + 1) || s_next == (2 * n_cols + 2)) {
                reward = -50.0;
                is_cliff = true;
            } else {
                if (s_next == goal_state) {
                    reward = 10.0;
                }
            }

            let a_next = select_action_eps_greedy(s_next, &q_table_sarsa, n_actions, eps_train, &seed_box_sarsa);

            let next_q = q_table_sarsa[s_next * n_actions + a_next];
            if (s_next == goal_state) { next_q = 0.0; }

            // SARSA Update (On-Policy with a_next)
            let td_target = reward + gamma * next_q;
            let curr_q = q_table_sarsa[s * n_actions + a];
            q_table_sarsa[s * n_actions + a] = curr_q + alpha * (td_target - curr_q);

            if (is_cliff) {
                s = start_state;
                a = select_action_eps_greedy(s, &q_table_sarsa, n_actions, eps_train, &seed_box_sarsa);
            } else {
                s = s_next;
                a = a_next;
            }
        }
    }

    // =================================================================
    // 3. Evaluate Learned Greedy Trajectories
    // =================================================================
    print("--- 2. Learned Greedy Trajectories (ε = 0 Exploitation) ---");

    // Trace Q-Learning Policy
    print("  [Q-Learning Trajectory] (Optimal Path Along Cliff):");
    let curr = start_state;
    let dummy_seed = alloc(int, 1);
    dummy_seed[0] = 0;

    let ql_steps = 0;
    for (let step = 0; step < 10; step++) {
        let r = curr / n_cols;
        let c = curr % n_cols;
        print(f"    Step {step}: State ({r}, {c})");
        if (curr == goal_state) { break; }

        let best_a = select_action_eps_greedy(curr, &q_table_ql, n_actions, 0, &dummy_seed);
        curr = get_next_state(curr, best_a, n_rows, n_cols);
        ql_steps++;
    }
    print(f"  Q-Learning reached goal in {ql_steps} steps.\n");

    // Trace SARSA Policy
    print("  [SARSA Trajectory] (Cautious Safe Path Away from Cliff):");
    curr = start_state;
    let sarsa_steps = 0;
    for (let step = 0; step < 10; step++) {
        let r = curr / n_cols;
        let c = curr % n_cols;
        print(f"    Step {step}: State ({r}, {c})");
        if (curr == goal_state) { break; }

        let best_a = select_action_eps_greedy(curr, &q_table_sarsa, n_actions, 0, &dummy_seed);
        curr = get_next_state(curr, best_a, n_rows, n_cols);
        sarsa_steps++;
    }
    print(f"  SARSA reached goal in {sarsa_steps} steps.\n");

    if (ql_steps <= 6 && sarsa_steps >= 4) {
        print("  SUCCESS: Q-Learning & SARSA successfully solved Cliff Walking TD control!\n");
    }

    print("==================================================================");
    print("Q-Learning / SARSA verified with 0 memory leaks!");
    return 0;
}
