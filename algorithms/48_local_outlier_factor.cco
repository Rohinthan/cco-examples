// Algorithm 48: Local Outlier Factor (LOF) - Density-Based Anomaly Detection & Local Reachability

/*
================================================================================
                    LOCAL OUTLIER FACTOR (LOF)
================================================================================

1. The Local Density Ratio Principle (Breunig, Kriegel, Ng & Sander, SIGMOD 2000):
       Global distance-based outlier methods fail when clusters have different densities.
       LOF evaluates an object's anomaly score by comparing its local density against
       the local densities of its k-nearest neighbors.

2. k-Distance of Object p and k-Distance Neighborhood N_k(p):
       - k-distance(p) : Euclidean distance d(p, o) to its k-th nearest neighbor.
       - N_k(p)        : Set of all neighbors q whose distance d(p, q) <= k-distance(p).

3. Reachability Distance:
       reach_dist_k(p, o) = max( k-distance(o),  d(p, o) )
       *Geometric Smoothing*: If p is very close to o, the distance is smoothed to
       k-distance(o), preventing erratic ratio blow-ups in dense clusters.

4. Local Reachability Density (lrd):
       The inverse of the average reachability distance from p to its neighbors in N_k(p):
           lrd_k(p) = |N_k(p)| / Σ_{o ∈ N_k(p)} reach_dist_k(p, o)

5. Local Outlier Factor (LOF) Score:
       The average ratio of the lrd of neighbors to that of object p:
           LOF_k(p) = ( 1 / |N_k(p)| ) * Σ_{o ∈ N_k(p)} [ lrd_k(o) / lrd_k(p) ]

       - LOF ≈ 1.0 : Inlier with density comparable to surrounding neighbors (even in sparse clusters!).
       - LOF < 1.0 : Core inlier situated in a high-density cluster center.
       - LOF >> 1.0: Anomaly/Outlier situated in a region of substantially lower density!
================================================================================
*/

fn dist_l2(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return sqrt(dx * dx + dy * dy);
}

fn main() -> int {
    print("==================================================================");
    print("   LOCAL OUTLIER FACTOR (LOF): DENSITY ANOMALY DETECTION (v20)   ");
    print("==================================================================\n");

    // Dataset: 9 samples in 2D space
    // Cluster 1 (Dense, intra-dist ≈ 0.1): Points 0, 1, 2, 3 around (1.0, 1.0)
    // Cluster 2 (Sparse, intra-dist ≈ 0.6): Points 4, 5, 6, 7 around (6.0, 6.0)
    // Point 8: Isolated Outlier at (3.5, 3.5)
    let n_samples = 9;
    let k_neighbors = 3;

    let px = alloc(float, n_samples);
    let py = alloc(float, n_samples);

    // Dense Cluster
    px[0] = 1.0; py[0] = 1.0;
    px[1] = 1.1; py[1] = 1.05;
    px[2] = 0.95; py[2] = 1.1;
    px[3] = 1.05; py[3] = 0.95;
    // Sparse Cluster (Much lower density, but mutually consistent!)
    px[4] = 6.0; py[4] = 6.0;
    px[5] = 6.6; py[5] = 6.0;
    px[6] = 6.0; py[6] = 6.6;
    px[7] = 6.6; py[7] = 6.6;
    // Isolated Outlier
    px[8] = 3.5; py[8] = 3.5;

    print("--- 1. Multi-Density Dataset ---");
    print("  Cluster 1 (Dense) : Points #0..#3 around (1.0, 1.0) [Intra-dist ≈ 0.1]");
    print("  Cluster 2 (Sparse): Points #4..#7 around (6.0, 6.0) [Intra-dist ≈ 0.6]");
    print("  Isolated Outlier  : Point #8 at (3.5, 3.5) [Dist to nearest cluster ≈ 3.5]\n");

    // Pairwise Distance Matrix
    let dist_mat = alloc(float, n_samples * n_samples);
    for (let i = 0; i < n_samples; i++) {
        for (let j = 0; j < n_samples; j++) {
            if (i == j) {
                dist_mat[i * n_samples + j] = 0.0;
            } else {
                dist_mat[i * n_samples + j] = dist_l2(px[i], py[i], px[j], py[j]);
            }
        }
    }

    // --- 2. Compute k-Distance and Neighborhood N_k(p) for Each Point ---
    let k_dist = alloc(float, n_samples);
    let neighbors = alloc(int, n_samples * k_neighbors);

    for (let i = 0; i < n_samples; i++) {
        let d_list = alloc(float, n_samples);
        let id_list = alloc(int, n_samples);

        for (let j = 0; j < n_samples; j++) {
            d_list[j] = dist_mat[i * n_samples + j];
            id_list[j] = j;
        }

        // Selection sort to find k closest neighbors (excluding self)
        for (let s = 0; s < k_neighbors + 1; s++) {
            let min_idx = s;
            for (let t = s + 1; t < n_samples; t++) {
                if (d_list[t] < d_list[min_idx]) {
                    min_idx = t;
                }
            }
            let tmp_d = d_list[s]; d_list[s] = d_list[min_idx]; d_list[min_idx] = tmp_d;
            let tmp_id = id_list[s]; id_list[s] = id_list[min_idx]; id_list[min_idx] = tmp_id;
        }

        for (let m = 0; m < k_neighbors; m++) {
            neighbors[i * k_neighbors + m] = id_list[m + 1];
        }
        k_dist[i] = d_list[k_neighbors];
    }

    print(f"--- 2. k-Distance Values (k = {k_neighbors}) ---");
    for (let i = 0; i < n_samples; i++) {
        let n0 = neighbors[i * k_neighbors + 0];
        let n1 = neighbors[i * k_neighbors + 1];
        let n2 = neighbors[i * k_neighbors + 2];
        print(f"  Point #{i} ({px[i]}, {py[i]}): {k_neighbors}-dist = {k_dist[i]} | Neighbors: [{n0}, {n1}, {n2}]");
    }
    print("");

    // --- 3. Compute Local Reachability Density (lrd) ---
    let lrd = alloc(float, n_samples);

    for (let p = 0; p < n_samples; p++) {
        let sum_reach_dist = 0.0;
        for (let m = 0; m < k_neighbors; m++) {
            let o = neighbors[p * k_neighbors + m];
            let d_po = dist_mat[p * n_samples + o];
            let k_dist_o = k_dist[o];

            let r_dist = d_po;
            if (k_dist_o > r_dist) { r_dist = k_dist_o; }
            sum_reach_dist += r_dist;
        }

        let avg_reach = sum_reach_dist / (1.0 * k_neighbors);
        lrd[p] = 1.0 / avg_reach;
    }

    // --- 4. Compute Local Outlier Factor (LOF) ---
    print("--- 3. Local Outlier Factor (LOF) Evaluation ---");
    let outlier_detected = -1;

    for (let p = 0; p < n_samples; p++) {
        let sum_lrd_ratio = 0.0;
        for (let m = 0; m < k_neighbors; m++) {
            let o = neighbors[p * k_neighbors + m];
            sum_lrd_ratio += lrd[o] / lrd[p];
        }

        let lof_val = sum_lrd_ratio / (1.0 * k_neighbors);

        let verdict = "NORMAL INLIER";
        if (lof_val >= 1.50) {
            verdict = "ANOMALY (OUTLIER)";
            outlier_detected = p;
        }

        print(f"  Point #{p} ({px[p]}, {py[p]}): lrd = {lrd[p]} | LOF = {lof_val} [{verdict}]");
    }
    print("");

    if (outlier_detected == 8) {
        print("  SUCCESS: LOF recognized both dense & sparse clusters as inliers, isolating only Point #8!\n");
    }

    print("==================================================================");
    print("Local Outlier Factor (LOF) verified with 0 memory leaks!");
    return 0;
}
