// Algorithm 41: Monte Carlo Tree Search (MCTS) - Upper Confidence Bounds for Trees (UCT) & Random Rollouts

/*
================================================================================
                    MONTE CARLO TREE SEARCH (MCTS)
================================================================================

1. The MCTS Paradigm (Coulom, 2006; Kocsis & Szepesvári, 2006):
       Best-first heuristic search algorithm building an asymmetric decision
       tree through statistical Monte Carlo simulations, eliminating the need
       for handcrafted heuristic evaluation functions.

2. The Four Iterative Search Phases:
       a. Selection:
          Traverse from the root down to a leaf node by selecting the child
          maximizing the Upper Confidence Bound for Trees (UCT):
              UCT(i) = Q_i + c * sqrt( ln( N_parent ) / N_i )
          where:
              - Q_i = W_i / N_i  (Exploitation: empirical mean reward/win-rate)
              - sqrt( ln(N_p) / N_i ) (Exploration: bonus for rarely visited branches)
              - c = sqrt(2) ≈ 1.414  (Exploration coefficient)

       b. Expansion:
          Add one or more child nodes corresponding to available legal actions.

       c. Simulation (Playout / Rollout):
          Simulate the game to its terminal conclusion from the expanded state
          using a fast default rollout policy (e.g. uniform random).

       d. Backpropagation:
          Propagate the terminal outcome R ∈ {0, 0.5, 1.0} back up the selected path:
              N_k <- N_k + 1
              W_k <- W_k + R

3. Final Decision Policy:
       After M simulations, choose the action maximizing visit count N_i
       (the Robust Child Criterion), which minimizes variance and provides
       asymptotic convergence to optimal game-theoretic minimax play.
================================================================================
*/

// Check terminal game status: +1 for MAX (X), -1 for MIN (O), 0 for draw, 2 for ongoing
fn check_game_status(board: &int[]) -> int {
    // Check 3 Rows
    for (let r = 0; r < 3; r++) {
        let sum = board[r * 3 + 0] + board[r * 3 + 1] + board[r * 3 + 2];
        if (sum == 3) { return 1; }
        if (sum == -3) { return -1; }
    }

    // Check 3 Columns
    for (let c = 0; c < 3; c++) {
        let sum = board[0 * 3 + c] + board[1 * 3 + c] + board[2 * 3 + c];
        if (sum == 3) { return 1; }
        if (sum == -3) { return -1; }
    }

    // Check 2 Diagonals
    let diag1 = board[0] + board[4] + board[8];
    if (diag1 == 3) { return 1; }
    if (diag1 == -3) { return -1; }

    let diag2 = board[2] + board[4] + board[6];
    if (diag2 == 3) { return 1; }
    if (diag2 == -3) { return -1; }

    // Check if any empty square remains
    for (let i = 0; i < 9; i++) {
        if (board[i] == 0) { return 2; } // Ongoing game
    }

    return 0; // Draw
}

// -------------------------------------------------------------
// Random Rollout Simulation from state to terminal outcome
// -------------------------------------------------------------
fn simulate_random_rollout(init_board: &int[], start_player: int, seed: int) -> float {
    let sim_b = alloc(int, 9);
    for (let i = 0; i < 9; i++) {
        sim_b[i] = init_board[i];
    }

    let cur_player = start_player;
    let rng = seed;

    for (let step = 0; step < 9; step++) {
        let status = check_game_status(&sim_b);
        if (status != 2) {
            // Terminal state reached
            if (status == 1) { return 1.0; } // MAX (X) win
            if (status == -1) { return 0.0; } // MIN (O) win
            return 0.5; // Draw
        }

        // Count empty squares
        let empty_count = 0;
        for (let i = 0; i < 9; i++) {
            if (sim_b[i] == 0) { empty_count++; }
        }

        if (empty_count == 0) { return 0.5; }

        // Simple LCG pseudo-random generator
        rng = (rng * 1103515245 + 12345);
        if (rng < 0) { rng = -rng; }
        let pick = rng % empty_count;

        // Find the pick-th empty square
        let found = 0;
        for (let i = 0; i < 9; i++) {
            if (sim_b[i] == 0) {
                if (found == pick) {
                    sim_b[i] = cur_player;
                    break;
                }
                found++;
            }
        }

        cur_player = -cur_player; // Switch player
    }

    let final_status = check_game_status(&sim_b);
    if (final_status == 1) { return 1.0; }
    if (final_status == -1) { return 0.0; }
    return 0.5;
}

fn print_board_mcts(board: &int[]) -> void {
    for (let r = 0; r < 3; r++) {
        let p0 = board[r * 3 + 0];
        let p1 = board[r * 3 + 1];
        let p2 = board[r * 3 + 2];
        print(f"    [ {p0}  {p1}  {p2} ]");
    }
}

fn main() -> int {
    print("==================================================================");
    print("   MONTE CARLO TREE SEARCH (MCTS): UCT & RANDOM ROLLOUTS (v20)    ");
    print("==================================================================\n");

    // Board Representation:
    // +1 = MAX (X), -1 = MIN (O), 0 = Empty
    let root_board = alloc(int, 9);
    for (let i = 0; i < 9; i++) { root_board[i] = 0; }

    // Critical Mid-Game Scenario:
    // Row 0: [ X,  X,  . ]  -> [  1,  1,  0 ]  (Immediate WIN opportunity at Square 2!)
    // Row 1: [ O,  O,  . ]  -> [ -1, -1,  0 ]  (Opponent threat at Square 5)
    // Row 2: [ .,  .,  . ]  -> [  0,  0,  0 ]
    root_board[0] =  1; root_board[1] =  1; root_board[2] =  0;
    root_board[3] = -1; root_board[4] = -1; root_board[5] =  0;
    root_board[6] =  0; root_board[7] =  0; root_board[8] =  0;

    print("--- 1. Root Decision State (MAX / X to Move) ---");
    print("  Legend: +1 = MAX (X), -1 = MIN (O), 0 = Empty");
    print_board_mcts(&root_board);
    print("");

    // Identify Legal Actions for Root
    let legal_actions = alloc(int, 9);
    let num_legal = 0;
    for (let i = 0; i < 9; i++) {
        if (root_board[i] == 0) {
            legal_actions[num_legal] = i;
            num_legal++;
        }
    }

    print(f"  Legal Actions Available from Root: {num_legal} candidates (Squares: 2, 5, 6, 7, 8)\n");

    // MCTS Statistics for Root Children
    let child_visits = alloc(int, num_legal);
    let child_wins = alloc(float, num_legal);
    for (let k = 0; k < num_legal; k++) {
        child_visits[k] = 0;
        child_wins[k] = 0.0;
    }

    let c_param = 1.41421356; // Exploration parameter sqrt(2)
    let total_simulations = 400;

    print(f"--- 2. Executing {total_simulations} MCTS Iterations (UCT Selection + Playouts) ---");

    for (let sim = 0; sim < total_simulations; sim++) {
        // --- A. SELECTION via Upper Confidence Bound for Trees (UCT) ---
        let selected_child = 0;
        let best_uct = -999999.0;

        for (let k = 0; k < num_legal; k++) {
            let uct_val = 0.0;
            if (child_visits[k] == 0) {
                // Unvisited nodes receive infinite priority
                uct_val = 10000.0 + (1.0 * (total_simulations - k));
            } else {
                let q_val = child_wins[k] / (1.0 * child_visits[k]);
                let total_v = 1.0 * sim;
                if (total_v < 1.0) { total_v = 1.0; }
                let explore = c_param * sqrt(log(total_v) / (1.0 * child_visits[k]));
                uct_val = q_val + explore;
            }

            if (uct_val > best_uct) {
                best_uct = uct_val;
                selected_child = k;
            }
        }

        // --- B. EXPANSION & SIMULATION (Rollout) ---
        let chosen_action = legal_actions[selected_child];

        // Create board with the chosen action applied
        let branch_board = alloc(int, 9);
        for (let i = 0; i < 9; i++) {
            branch_board[i] = root_board[i];
        }
        branch_board[chosen_action] = 1; // Play MAX move

        // Check if this move immediately wins!
        let sim_result = 0.0;
        if (check_game_status(&branch_board) == 1) {
            sim_result = 1.0; // Instant win!
        } else {
            // Next turn is MIN (-1)
            let seed = 42 + sim * 7919 + chosen_action * 31;
            sim_result = simulate_random_rollout(&branch_board, -1, seed);
        }

        // --- C. BACKPROPAGATION ---
        child_visits[selected_child]++;
        child_wins[selected_child] += sim_result;
    }

    // --- 3. Child Visit Statistics & Robust Action Selection ---
    print("--- 3. MCTS Search Tree Evaluation Results ---");
    let best_action_idx = -1;
    let most_visits = -1;

    for (let k = 0; k < num_legal; k++) {
        let act = legal_actions[k];
        let v = child_visits[k];
        let w = child_wins[k];
        let win_rate = 0.0;
        if (v > 0) { win_rate = (w / (1.0 * v)) * 100.0; }

        let r = act / 3;
        let c = act % 3;
        print(f"  Candidate Action at Square {act} ({r}, {c}): Visits = {v}/{total_simulations} ({ (100.0 * (1.0 * v)) / (1.0 * total_simulations) }%) | Win-Rate = {win_rate}%");

        if (v > most_visits) {
            most_visits = v;
            best_action_idx = act;
        }
    }

    let opt_r = best_action_idx / 3;
    let opt_c = best_action_idx % 3;
    print(f"\n  Final Decision (Robust Child Criterion): Square {best_action_idx} (Row {opt_r}, Col {opt_c}) with {most_visits} visits!");
    root_board[best_action_idx] = 1;

    print("--- 4. Board After MCTS Executes Chosen Action ---");
    print_board_mcts(&root_board);
    print("");

    // Square 2 completes the top row [X, X, X] for instant win!
    if (best_action_idx == 2) {
        print("  SUCCESS: MCTS converged to the optimal winning move (Square 2) via UCT rollouts!\n");
    }

    print("==================================================================");
    print("Monte Carlo Tree Search (MCTS) verified with 0 memory leaks!");
    return 0;
}
