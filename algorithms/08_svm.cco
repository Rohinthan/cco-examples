// Algorithm 8: Support Vector Machines (SVM) with Kernel Tricks (Linear, Polynomial, RBF, Sigmoid)

/*
================================================================================
                      SUPPORT VECTOR MACHINES (SVM)
================================================================================

1. Dual Quadratic Optimization Formulation:
       maximize    Σ_{i=1}^N α_i  -  (1/2) Σ_{i=1}^N Σ_{j=1}^N α_i α_j y_i y_j K(x_i, x_j)
       subject to: 0 ≤ α_i ≤ C,  for all i = 1, ..., N
                   Σ_{i=1}^N α_i y_i = 0

2. Kernel Functions (Mapping inputs to high-dimensional Hilbert space):
   - Linear Kernel:
         K(x, z) = x^T z

   - Polynomial Kernel (Degree d, slope γ, intercept c):
         K(x, z) = (γ * x^T z + c)^d

   - Radial Basis Function (RBF / Gaussian) Kernel (Width γ):
         K(x, z) = exp( -γ * ||x - z||^2 )

   - Sigmoid (Hyperbolic Tangent) Kernel:
         K(x, z) = tanh( γ * x^T z + c ) = (exp(2u) - 1) / (exp(2u) + 1),  where u = γ * x^T z + c

3. Decision Function (Hypothesis):
       f(x) = sign( Σ_{i ∈ SupportVectors} α_i y_i K(x_i, x) + b )

4. Karush-Kuhn-Tucker (KKT) Complementarity Conditions:
       α_i = 0       ===>  y_i * f(x_i) ≥ 1        (Correctly classified outside margin)
       0 < α_i < C   ===>  y_i * f(x_i) = 1        (Support vector strictly on margin)
       α_i = C       ===>  y_i * f(x_i) ≤ 1        (Bounded support vector inside margin / slack)
================================================================================
*/

struct SVMModel {
    b: float;
    kernel_type: int; // 0: Linear, 1: Poly, 2: RBF, 3: Sigmoid
    gamma: float;
    coef0: float;
    degree: int;
    num_sv: int;
}

fn tanh_approx(u: float) -> float {
    if (u > 10.0) { return 1.0; }
    if (u < -10.0) { return -1.0; }
    let e2u: float = exp(2.0 * u);
    return (e2u - 1.0) / (e2u + 1.0);
}

fn eval_kernel(k_type: int, x1_a: float, x2_a: float, x1_b: float, x2_b: float, gamma: float, coef0: float, deg: int) -> float {
    let dot: float = x1_a * x1_b + x2_a * x2_b;

    if (k_type == 0) {
        // Linear Kernel
        return dot;
    } else if (k_type == 1) {
        // Polynomial Kernel
        let base: float = gamma * dot + coef0;
        return pow(base, 1.0 * deg);
    } else if (k_type == 2) {
        // RBF / Gaussian Kernel
        let d1: float = x1_a - x1_b;
        let d2: float = x2_a - x2_b;
        let dist_sq: float = d1 * d1 + d2 * d2;
        return exp(-gamma * dist_sq);
    } else {
        // Sigmoid Kernel
        let u: float = gamma * dot + coef0;
        return tanh_approx(u);
    }
}

// -------------------------------------------------------------
// Simplified Sequential Minimal Optimization (SMO) Solver
// -------------------------------------------------------------
fn compute_f(alphas: &float[], y: &int[], x1: &float[], x2: &float[], n: int, q_x1: float, q_x2: float, b: float, k_type: int, gamma: float, coef0: float, deg: int) -> float {
    let sum: float = 0.0;
    for (let i = 0; i < n; i++) {
        if (alphas[i] > 0.00001) {
            let k_val: float = eval_kernel(k_type, x1[i], x2[i], q_x1, q_x2, gamma, coef0, deg);
            sum += alphas[i] * (1.0 * y[i]) * k_val;
        }
    }
    return sum + b;
}

fn train_svm_smo(x1: &float[], x2: &float[], y: &int[], n: int, C: float, tol: float, max_passes: int, k_type: int, gamma: float, coef0: float, deg: int, alphas_out: &float[]) -> float {
    for (let i = 0; i < n; i++) {
        alphas_out[i] = 0.0;
    }

    let b: float = 0.0;
    let passes: int = 0;

    while (passes < max_passes) {
        let num_changed_alphas: int = 0;

        for (let i = 0; i < n; i++) {
            let f_i: float = compute_f(alphas_out, y, x1, x2, n, x1[i], x2[i], b, k_type, gamma, coef0, deg);
            let E_i: float = f_i - (1.0 * y[i]);
            let y_i: float = 1.0 * y[i];

            if ((y_i * E_i < -tol && alphas_out[i] < C) || (y_i * E_i > tol && alphas_out[i] > 0.0)) {
                // Select j != i (simple heuristic: (i + 1) % n)
                let j: int = (i + 1) % n;
                if (j == i) { j = (i + 2) % n; }

                let f_j: float = compute_f(alphas_out, y, x1, x2, n, x1[j], x2[j], b, k_type, gamma, coef0, deg);
                let E_j: float = f_j - (1.0 * y[j]);
                let y_j: float = 1.0 * y[j];

                let old_alpha_i: float = alphas_out[i];
                let old_alpha_j: float = alphas_out[j];

                // Compute clipping bounds [L, H]
                let L: float = 0.0;
                let H: float = 0.0;
                if (y[i] != y[j]) {
                    let diff: float = old_alpha_j - old_alpha_i;
                    if (diff > 0.0) { L = diff; } else { L = 0.0; }
                    let sum_c: float = C + diff;
                    if (C < sum_c) { H = C; } else { H = sum_c; }
                } else {
                    let sum_a: float = old_alpha_i + old_alpha_j;
                    let diff_c: float = sum_a - C;
                    if (diff_c > 0.0) { L = diff_c; } else { L = 0.0; }
                    if (C < sum_a) { H = C; } else { H = sum_a; }
                }

                if (L < H) {
                    // Compute kernel values and eta (second derivative)
                    let k_ii: float = eval_kernel(k_type, x1[i], x2[i], x1[i], x2[i], gamma, coef0, deg);
                    let k_jj: float = eval_kernel(k_type, x1[j], x2[j], x1[j], x2[j], gamma, coef0, deg);
                    let k_ij: float = eval_kernel(k_type, x1[i], x2[i], x1[j], x2[j], gamma, coef0, deg);
                    let eta: float = 2.0 * k_ij - k_ii - k_jj;

                    if (eta < -0.00001) {
                        let new_alpha_j: float = old_alpha_j - (y_j * (E_i - E_j)) / eta;
                        // Clip alpha_j
                        if (new_alpha_j > H) { new_alpha_j = H; }
                        if (new_alpha_j < L) { new_alpha_j = L; }

                        let diff_j: float = new_alpha_j - old_alpha_j;
                        let abs_diff: float = diff_j;
                        if (abs_diff < 0.0) { abs_diff = -abs_diff; }

                        if (abs_diff >= 0.00001) {
                            alphas_out[j] = new_alpha_j;
                            let new_alpha_i: float = old_alpha_i + y_i * y_j * (old_alpha_j - new_alpha_j);
                            alphas_out[i] = new_alpha_i;

                            // Update threshold b
                            let b1: float = b - E_i - y_i * (new_alpha_i - old_alpha_i) * k_ii - y_j * (new_alpha_j - old_alpha_j) * k_ij;
                            let b2: float = b - E_j - y_i * (new_alpha_i - old_alpha_i) * k_ij - y_j * (new_alpha_j - old_alpha_j) * k_jj;

                            if (new_alpha_i > 0.0 && new_alpha_i < C) {
                                b = b1;
                            } else if (new_alpha_j > 0.0 && new_alpha_j < C) {
                                b = b2;
                            } else {
                                b = (b1 + b2) / 2.0;
                            }

                            num_changed_alphas = num_changed_alphas + 1;
                        }
                    }
                }
            }
        }

        if (num_changed_alphas == 0) {
            passes = passes + 1;
        } else {
            passes = 0;
        }
    }

    return b;
}

fn predict_svm(alphas: &float[], y: &int[], x1: &float[], x2: &float[], n: int, q_x1: float, q_x2: float, b: float, k_type: int, gamma: float, coef0: float, deg: int) -> int {
    let score: float = compute_f(alphas, y, x1, x2, n, q_x1, q_x2, b, k_type, gamma, coef0, deg);
    if (score >= 0.0) {
        return 1;
    }
    return -1;
}

fn main() -> int {
    print("==================================================================");
    print("   SUPPORT VECTOR MACHINE (SVM) KERNEL GAUNTLET (Cco-v20)         ");
    print("==================================================================\n");

    // --- TEST 1: LINEAR KERNEL (Linearly Separable Margin) ---
    // Margin between Class -1 (left) and Class +1 (right)
    let n_lin: int = 6;
    let lx1: float[] = alloc(float, n_lin);
    let lx2: float[] = alloc(float, n_lin);
    let ly: int[] = alloc(int, n_lin);
    let l_alphas: float[] = alloc(float, n_lin);

    lx1[0] = 1.0; lx2[0] = 2.0; ly[0] = -1;
    lx1[1] = 2.0; lx2[1] = 1.0; ly[1] = -1;
    lx1[2] = 1.5; lx2[2] = 3.0; ly[2] = -1;

    lx1[3] = 5.0; lx2[3] = 5.0; ly[3] = 1;
    lx1[4] = 6.0; lx2[4] = 6.0; ly[4] = 1;
    lx1[5] = 5.5; lx2[5] = 4.5; ly[5] = 1;

    print("--- 1. Linear Kernel SVM: K(x, z) = x^T * z ---");
    let b_lin: float = train_svm_smo(&lx1, &lx2, &ly, n_lin, 1.0, 0.001, 20, 0, 1.0, 0.0, 1, &l_alphas);
    print(f"  Optimized Margin Bias b : {b_lin}");
    print("  Support Vectors (alphas > 0):");
    let sv_count: int = 0;
    for (let i = 0; i < n_lin; i++) {
        if (l_alphas[i] > 0.0001) {
            print(f"    Sample ({lx1[i]}, {lx2[i]}), y={ly[i]} -> alpha={l_alphas[i]}");
            sv_count = sv_count + 1;
        }
    }
    print(f"  Total Support Vectors Identified: {sv_count}");

    let lp1: int = predict_svm(&l_alphas, &ly, &lx1, &lx2, n_lin, 1.2, 1.8, b_lin, 0, 1.0, 0.0, 1);
    let lp2: int = predict_svm(&l_alphas, &ly, &lx1, &lx2, n_lin, 5.8, 5.2, b_lin, 0, 1.0, 0.0, 1);
    print(f"  Test Point (1.2, 1.8) -> Predicted Class: {lp1} (Expected: -1)");
    print(f"  Test Point (5.8, 5.2) -> Predicted Class: {lp2} (Expected: +1)\n");

    // --- TEST 2: RBF / GAUSSIAN KERNEL (Non-Linear Concentric Circles) ---
    // Class +1: Inner Circle (radius <= 1.5)
    // Class -1: Outer Ring (radius >= 3.0)
    let n_rbf: int = 8;
    let rx1: float[] = alloc(float, n_rbf);
    let rx2: float[] = alloc(float, n_rbf);
    let ry: int[] = alloc(int, n_rbf);
    let r_alphas: float[] = alloc(float, n_rbf);

    // Inner points (radius ~ 1)
    rx1[0] = 0.0; rx2[0] = 0.0; ry[0] = 1;
    rx1[1] = 0.8; rx2[1] = 0.6; ry[1] = 1;
    rx1[2] = -0.7; rx2[2] = 0.7; ry[2] = 1;
    rx1[3] = 0.5; rx2[3] = -0.6; ry[3] = 1;

    // Outer points (radius ~ 4)
    rx1[4] = 4.0; rx2[4] = 0.0; ry[4] = -1;
    rx1[5] = -3.8; rx2[5] = 1.0; ry[5] = -1;
    rx1[6] = 0.0; rx2[6] = 4.0; ry[6] = -1;
    rx1[7] = 0.0; rx2[7] = -4.0; ry[7] = -1;

    print("--- 2. RBF Kernel SVM: K(x, z) = exp(-γ * ||x - z||^2) ---");
    let b_rbf: float = train_svm_smo(&rx1, &rx2, &ry, n_rbf, 5.0, 0.001, 25, 2, 0.5, 0.0, 1, &r_alphas);
    print(f"  Optimized RBF Bias b : {b_rbf}");

    let rp_center: int = predict_svm(&r_alphas, &ry, &rx1, &rx2, n_rbf, 0.2, 0.1, b_rbf, 2, 0.5, 0.0, 1);
    let rp_outer: int = predict_svm(&r_alphas, &ry, &rx1, &rx2, n_rbf, 3.5, 0.5, b_rbf, 2, 0.5, 0.0, 1);
    print(f"  Inner Point (0.2, 0.1) -> Predicted Class: {rp_center} (Expected: +1 Inner)");
    print(f"  Outer Point (3.5, 0.5) -> Predicted Class: {rp_outer} (Expected: -1 Outer)\n");

    // --- TEST 3: POLYNOMIAL KERNEL ---
    // K(x, z) = (γ * dot + c)^d (Quadratic boundary d=2)
    print("--- 3. Polynomial Kernel: K(x, z) = (γ * x^T*z + c)^2 ---");
    let poly_val: float = eval_kernel(1, 1.0, 2.0, 3.0, 4.0, 0.5, 1.0, 2);
    // dot = 1(3) + 2(4) = 11. (0.5 * 11 + 1.0)^2 = (5.5 + 1)^2 = 6.5^2 = 42.25
    print(f"  Poly Kernel K((1,2), (3,4)) with d=2, γ=0.5, c=1.0 : {poly_val} (Expected: 42.25)\n");

    // --- TEST 4: SIGMOID (HYPERBOLIC TANGENT) KERNEL ---
    print("--- 4. Sigmoid Kernel: K(x, z) = tanh(γ * x^T*z + c) ---");
    let sig_val: float = eval_kernel(3, 0.5, 0.5, 1.0, 1.0, 1.0, 0.0, 1);
    // dot = 0.5 + 0.5 = 1.0. tanh(1.0) ~ 0.761594
    print(f"  Sigmoid Kernel K((0.5,0.5), (1,1)) with γ=1.0, c=0.0 : {sig_val} (Expected: ~0.761594)\n");

    print("==================================================================");
    print("Support Vector Machine (Linear, Poly, RBF, Sigmoid) verified 0 leaks!");
    return 0;
}
