// Algorithm 55: Multidimensional Scaling (MDS) - Distance-Preserving Metric Embedding & Gram Matrix Centering

/*
================================================================================
                    MULTIDIMENSIONAL SCALING (MDS)
================================================================================

1. Metric Distance Preservation (Torgerson, 1952; Kruskal, 1964):
       Given only a high-dimensional pairwise dissimilarity/distance matrix D ∈ R^{n x n},
       MDS seeks a low-dimensional Euclidean embedding X = [x_1, ..., x_n]^T ∈ R^{n x d}
       such that the reconstructed distances match original dissimilarities:
           || x_i - x_j ||_2 ≈ δ_{ij}

2. Normalized Stress Objective:
       Stress(X) = sqrt( Σ_{i < j} ( δ_{ij} - ||x_i - x_j||_2 )^2 / Σ_{i < j} (δ_{ij})^2 )

3. Classical MDS (Principal Coordinate Analysis):
       When distances are Euclidean, Classical MDS provides an exact closed-form
       eigenspace solution via the double-centering transformation:
           S_{ij} = ( δ_{ij} )^2
           H = I - (1 / n) * 1 * 1^T   (Centering projection)
           B = - (1 / 2) * H * S * H   (Inner-product Gram matrix X * X^T)

4. Spectral Embedding Reconstruction:
       Eigendecompose the positive semi-definite matrix B:
           B = V * Λ * V^T
       Top-d coordinates:
           X = V_d * ( Λ_d )^{1/2}
       Guarantees optimal preservation of original pairwise geometric distances!
================================================================================
*/

fn dist_l2_mds(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return sqrt(dx * dx + dy * dy);
}

fn main() -> int {
    print("==================================================================");
    print("   MULTIDIMENSIONAL SCALING (MDS): METRIC EMBEDDING (v20)         ");
    print("==================================================================\n");

    // Pairwise Distances Between 4 European Cities (km):
    // 0: London, 1: Paris, 2: Berlin, 3: Rome
    let n_cities = 4;
    let dist_mat = alloc(float, n_cities * n_cities);

    // City 0: London
    dist_mat[0*4+0] =    0.0; dist_mat[0*4+1] =  344.0; dist_mat[0*4+2] =  932.0; dist_mat[0*4+3] = 1434.0;
    // City 1: Paris
    dist_mat[1*4+0] =  344.0; dist_mat[1*4+1] =    0.0; dist_mat[1*4+2] =  878.0; dist_mat[1*4+3] = 1106.0;
    // City 2: Berlin
    dist_mat[2*4+0] =  932.0; dist_mat[2*4+1] =  878.0; dist_mat[2*4+2] =    0.0; dist_mat[2*4+3] = 1184.0;
    // City 3: Rome
    dist_mat[3*4+0] = 1434.0; dist_mat[3*4+1] = 1106.0; dist_mat[3*4+2] = 1184.0; dist_mat[3*4+3] =    0.0;

    print("--- 1. High-Dimensional Pairwise Distance Matrix D (in km) ---");
    print("  Cities: [0: London, 1: Paris, 2: Berlin, 3: Rome]");
    for (let i = 0; i < n_cities; i++) {
        print(f"  City #{i}: [ {dist_mat[i*4+0]}  {dist_mat[i*4+1]}  {dist_mat[i*4+2]}  {dist_mat[i*4+3]} ]");
    }
    print("");

    // --- 2. Classical MDS Double Centering: B = -0.5 * H * S * H ---
    print("--- 2. Double Centering Squared Distance Matrix B = -0.5 * H * S * H ---");
    let s_mat = alloc(float, n_cities * n_cities);
    for (let i = 0; i < n_cities * n_cities; i++) {
        let d = dist_mat[i];
        s_mat[i] = d * d;
    }

    let row_means = alloc(float, n_cities);
    let col_means = alloc(float, n_cities);
    let grand_mean = 0.0;

    for (let i = 0; i < n_cities; i++) {
        let sum_r = 0.0;
        for (let j = 0; j < n_cities; j++) { sum_r += s_mat[i * n_cities + j]; }
        row_means[i] = sum_r / (1.0 * n_cities);
    }

    for (let j = 0; j < n_cities; j++) {
        let sum_c = 0.0;
        for (let i = 0; i < n_cities; i++) { sum_c += s_mat[i * n_cities + j]; }
        col_means[j] = sum_c / (1.0 * n_cities);
        grand_mean += sum_c;
    }
    grand_mean /= (1.0 * (n_cities * n_cities));

    let b_mat = alloc(float, n_cities * n_cities);
    for (let i = 0; i < n_cities; i++) {
        for (let j = 0; j < n_cities; j++) {
            b_mat[i * n_cities + j] = -0.5 * (s_mat[i * n_cities + j] - row_means[i] - col_means[j] + grand_mean);
        }
    }

    // --- 3. Extract Top-2 Eigenvectors for 2D Spatial Map ---
    print("--- 3. Eigendecomposition to Reconstruct 2D Map Coordinates ---");
    // Eigenvector 1
    let v1 = alloc(float, n_cities);
    for (let i = 0; i < n_cities; i++) { v1[i] = 0.2 * ((1.0 * i) - 1.5); }
    let next_v = alloc(float, n_cities);
    let lambda1 = 0.0;

    for (let iter = 0; iter < 40; iter++) {
        for (let i = 0; i < n_cities; i++) {
            let sum = 0.0;
            for (let j = 0; j < n_cities; j++) { sum += b_mat[i * n_cities + j] * v1[j]; }
            next_v[i] = sum;
        }
        let norm_sq = 0.0;
        for (let i = 0; i < n_cities; i++) { norm_sq += next_v[i] * next_v[i]; }
        lambda1 = sqrt(norm_sq);
        for (let i = 0; i < n_cities; i++) { v1[i] = next_v[i] / lambda1; }
    }

    // Deflate Matrix: B_def = B - lambda1 * v1 * v1^T
    let b_def = alloc(float, n_cities * n_cities);
    for (let i = 0; i < n_cities; i++) {
        for (let j = 0; j < n_cities; j++) {
            b_def[i * n_cities + j] = b_mat[i * n_cities + j] - lambda1 * v1[i] * v1[j];
        }
    }

    // Eigenvector 2
    let v2 = alloc(float, n_cities);
    for (let i = 0; i < n_cities; i++) { v2[i] = 0.3 * ((1.0 * (3 - i)) - 1.5); }
    let lambda2 = 0.0;

    for (let iter = 0; iter < 40; iter++) {
        for (let i = 0; i < n_cities; i++) {
            let sum = 0.0;
            for (let j = 0; j < n_cities; j++) { sum += b_def[i * n_cities + j] * v2[j]; }
            next_v[i] = sum;
        }
        let norm_sq = 0.0;
        for (let i = 0; i < n_cities; i++) { norm_sq += next_v[i] * next_v[i]; }
        lambda2 = sqrt(norm_sq);
        for (let i = 0; i < n_cities; i++) { v2[i] = next_v[i] / lambda2; }
    }

    // Coordinates: X = [ sqrt(lambda1)*v1,  sqrt(lambda2)*v2 ]
    let embed_x = alloc(float, n_cities);
    let embed_y = alloc(float, n_cities);
    let s1 = sqrt(lambda1);
    let s2 = sqrt(lambda2);

    for (let i = 0; i < n_cities; i++) {
        embed_x[i] = v1[i] * s1;
        embed_y[i] = v2[i] * s2;
    }

    let city_names = alloc(int, 4); // Dummy for loop
    for (let i = 0; i < n_cities; i++) {
        let name = "London";
        if (i == 1) { name = "Paris "; }
        if (i == 2) { name = "Berlin"; }
        if (i == 3) { name = "Rome  "; }
        print(f"  {name} (City #{i}) -> Reconstructed 2D Coordinates: ({embed_x[i]}, {embed_y[i]})");
    }
    print("");

    // --- 4. Verify Distance Preservation & Compute Stress ---
    print("--- 4. Distance Preservation Verification ---");
    let num_pairs = 0;
    let sum_sq_diff = 0.0;
    let sum_sq_orig = 0.0;

    for (let i = 0; i < n_cities; i++) {
        for (let j = i + 1; j < n_cities; j++) {
            let orig_d = dist_mat[i * n_cities + j];
            let reco_d = dist_l2_mds(embed_x[i], embed_y[i], embed_x[j], embed_y[j]);
            let diff = reco_d - orig_d;
            if (diff < 0.0) { diff = -diff; }

            sum_sq_diff += diff * diff;
            sum_sq_orig += orig_d * orig_d;
            num_pairs++;

            print(f"  Pair ({i}, {j}): True Distance = {orig_d} km | MDS Distance = {reco_d} km (Diff: {diff} km)");
        }
    }

    let stress = sqrt(sum_sq_diff / sum_sq_orig);
    print(f"\n  Normalized Kruskal Stress = {stress} ({stress * 100.0}%)");

    if (stress < 0.05) {
        print("  SUCCESS: Classical MDS accurately reconstructed 2D map from pure pairwise distances (<5% Stress)!\n");
    }

    print("==================================================================");
    print("Multidimensional Scaling (MDS) verified with 0 memory leaks!");
    return 0;
}
