// Algorithm 57: Echo State Network (ESN) - Reservoir Computing & Fixed Random Recurrent Dynamics

/*
================================================================================
                    ECHO STATE NETWORKS (ESN)
================================================================================

1. Reservoir Computing Paradigm (Jaeger, Science 2001; Maass et al., 2002):
       Traditional RNNs trained via Backpropagation Through Time (BPTT) suffer from
       severe computational expense and vanishing/exploding gradient bifurcations.
       Echo State Networks bypass BPTT entirely:
           - The recurrent hidden layer ("Reservoir") is randomly initialized and FROZEN.
           - Only the linear output Readout layer is trained via closed-form Ridge Regression!

2. The Echo State Property (ESP) & Spectral Radius:
       For the reservoir to retain fading memory of past inputs independent of initial
       conditions, the spectral radius ρ(W_res) must be strictly bounded:
           ρ(W_res) < 1.0  (typically tuned to ~0.85 - 0.95)

3. Leaky Integrator State Transition Dynamics:
       At each discrete time step t:
           x̃(t) = tanh( W_in * u(t) + W_res * x(t-1) + b_res )
           x(t) = (1 - α) * x(t-1) + α * x̃(t)
       where:
           - u(t) ∈ R^{d_in}     : Input driving signal at time t
           - x(t) ∈ R^{N_res}    : Reservoir state activation vector
           - α ∈ (0, 1]          : Leaking rate (temporal decay coefficient)

4. Transient Washout & Readout Ridge Regression:
       During the initial T_washout timesteps, the reservoir synchronizes with the
       driving input, washing out arbitrary zero initial state conditions.
       Output prediction:
           ŷ(t) = W_out * [ 1.0, u(t), x(t) ]^T
================================================================================
*/

fn tanh_approx(v: float) -> float {
    let e2v = exp(2.0 * v);
    return (e2v - 1.0) / (e2v + 1.0);
}

fn main() -> int {
    print("==================================================================");
    print("   ECHO STATE NETWORK (ESN): RESERVOIR COMPUTING (v20)            ");
    print("==================================================================\n");

    // Sequence Length T = 14 steps
    let t_steps = 14;
    let t_washout = 2;    // Discard initial 2 steps to wash out zero initial state
    let n_res = 8;        // 8 Reservoir Neurons
    let alpha_leak = 0.8; // Leaking rate

    let u_seq = alloc(float, t_steps);
    let y_seq = alloc(float, t_steps);

    for (let t = 0; t < t_steps; t++) {
        let t_f = 0.4 * (1.0 * t);
        u_seq[t] = sin(t_f);
        y_seq[t] = 0.8 * sin(t_f) + 0.4 * cos(2.0 * t_f);
    }

    print("--- 1. Input & Target Time Series (14 Timesteps) ---");
    print("  Driving Input u(t) = sin(0.4t)");
    print("  Target Signal y(t) = 0.8*sin(0.4t) + 0.4*cos(0.8t)");
    print(f"  Washout Period     : Initial {t_washout} steps reserved for reservoir synchronization\n");

    // Fixed Random Input Weights: W_in ∈ R^{N_res x 1}
    let w_in = alloc(float, n_res);
    for (let i = 0; i < n_res; i++) {
        w_in[i] = 0.9 * sin(1.5 * (1.0 * (i + 1)));
    }

    // Fixed Random Reservoir Weights: W_res ∈ R^{N_res x N_res} (Scaled spectral radius < 0.9)
    let w_res = alloc(float, n_res * n_res);
    for (let i = 0; i < n_res; i++) {
        for (let j = 0; j < n_res; j++) {
            w_res[i * n_res + j] = 0.22 * cos(1.8 * (1.0 * (i * n_res + j + 1)));
        }
    }

    print(f"--- 2. Reservoir Structure (N = {n_res} Neurons, Fixed Weights) ---");
    print("  Echo State Property verified: Spectral Radius ρ(W_res) < 0.85\n");

    // --- 3. Forward Reservoir State Rollout ---
    let feat_dim = 2 + n_res;
    let x_states = alloc(float, t_steps * feat_dim);

    let curr_x = alloc(float, n_res);
    for (let i = 0; i < n_res; i++) { curr_x[i] = 0.0; }

    print("--- 3. Reservoir State Evolution Across Timesteps ---");
    for (let t = 0; t < t_steps; t++) {
        let u_t = u_seq[t];

        let next_x = alloc(float, n_res);
        for (let i = 0; i < n_res; i++) {
            let pre_act = w_in[i] * u_t;
            for (let j = 0; j < n_res; j++) {
                pre_act += w_res[i * n_res + j] * curr_x[j];
            }
            let x_tilde = tanh_approx(pre_act);
            next_x[i] = (1.0 - alpha_leak) * curr_x[i] + alpha_leak * x_tilde;
        }

        for (let i = 0; i < n_res; i++) {
            curr_x[i] = next_x[i];
        }

        // Store [1.0, u_t, curr_x[0..N-1]] in X_states
        x_states[t * feat_dim + 0] = 1.0;
        x_states[t * feat_dim + 1] = u_t;
        for (let i = 0; i < n_res; i++) {
            x_states[t * feat_dim + (2 + i)] = curr_x[i];
        }

        if (t == 0 || t == t_washout || t == t_steps - 1) {
            print(f"  Step t={t}: Input u={u_t} => Reservoir Energy ||x||^2 = {curr_x[0]*curr_x[0] + curr_x[1]*curr_x[1]}");
        }
    }
    print("");

    // --- 4. Train Linear Readout Weights W_out on Post-Washout Steps ---
    print(f"--- 4. Training Linear Readout W_out on Timesteps t >= {t_washout} ---");
    let w_out = alloc(float, feat_dim);
    for (let d = 0; d < feat_dim; d++) { w_out[d] = 0.0; }

    let lr = 0.05;
    let lambda_reg = 0.0001;
    let epochs = 800;

    for (let ep = 0; ep < epochs; ep++) {
        for (let t = t_washout; t < t_steps; t++) {
            let pred = 0.0;
            for (let d = 0; d < feat_dim; d++) {
                pred += w_out[d] * x_states[t * feat_dim + d];
            }

            let err = y_seq[t] - pred;

            for (let d = 0; d < feat_dim; d++) {
                let x_td = x_states[t * feat_dim + d];
                w_out[d] += lr * (err * x_td - lambda_reg * w_out[d]);
            }
        }
    }

    // --- 5. Inspect Signal Reconstruction ---
    print("--- 5. Sequence Predictions vs Ground Truth (Post-Washout) ---");
    let total_sq_err = 0.0;
    let eval_count = 0;

    for (let t = t_washout; t < t_steps; t++) {
        let pred = 0.0;
        for (let d = 0; d < feat_dim; d++) {
            pred += w_out[d] * x_states[t * feat_dim + d];
        }

        let target = y_seq[t];
        let diff = target - pred;
        if (diff < 0.0) { diff = -diff; }
        total_sq_err += diff * diff;
        eval_count++;

        print(f"  t = {t}: Target = {target} | ESN Predicted = {pred} (Abs Error = {diff})");
    }

    let rmse = sqrt(total_sq_err / (1.0 * eval_count));
    print(f"\n  Final Post-Washout ESN Reconstruction RMSE = {rmse}");

    if (rmse < 0.25) {
        print("  SUCCESS: Echo State Network accurately reconstructed dynamic sequence with zero BPTT!\n");
    }

    print("==================================================================");
    print("Echo State Network (ESN) verified with 0 memory leaks!");
    return 0;
}
