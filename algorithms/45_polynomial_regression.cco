// Algorithm 45: Polynomial Regression - Non-Linear Basis Expansion & Vandermonde Modeling

/*
================================================================================
                        POLYNOMIAL REGRESSION
================================================================================

1. Non-Linear Feature Mapping via Polynomial Basis:
       Transforms a scalar feature x ∈ R into a d-degree polynomial feature vector:
           ϕ_d(x) = [ 1,  x,  x^2,  x^3,  ...,  x^d ]^T ∈ R^{d+1}

       Polynomial regression models non-linear relationships by fitting a linear
       hyperplane within this expanded feature space:
           ŷ = w_0 + w_1 * x + w_2 * x^2 + ... + w_d * x^d = w^T ϕ_d(x)

2. The Vandermonde Design Matrix X:
       X = [ 1   x_1   x_1^2   ...   x_1^d ]
           [ 1   x_2   x_2^2   ...   x_2^d ]
           [ :    :      :      ...    :   ]
           [ 1   x_n   x_n^2   ...   x_n^d ]

3. Regularized Least Squares Objective:
       L(w) = (1 / (2*n)) * || y - X * w ||_2^2 + (λ / 2) * ||w||_2^2

       Normal Equations:
           w^* = ( X^T X + λ * I )^{-1} * X^T y
       *Significance*: High-degree Vandermonde matrices have severely ill-conditioned
       condition numbers. Ridge regularization prevents Runge's boundary oscillation!

4. Underfitting vs Optimal Capacity Trade-Off:
       - Degree 1 (Linear) : Underfits non-linear curves (high bias).
       - Degree 3 (Cubic)  : Perfectly fits cubic inflection points and extrema (optimal).
================================================================================
*/

fn train_poly_regression(x_poly: &float[], y_data: &float[], n_samples: int, n_powers: int,
                         epochs: int, lr: float, lambda_reg: float,
                         w_out: &float[], b_out: &float[]) -> float {
    let n_f = 1.0 * n_samples;
    for (let p = 0; p < n_powers; p++) {
        w_out[p] = 0.0;
    }
    b_out[0] = 0.0;

    let b_curr = 0.0;
    let final_mse = 0.0;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_b = 0.0;
        let grad_w = alloc(float, n_powers);
        for (let p = 0; p < n_powers; p++) { grad_w[p] = 0.0; }

        let mse_sum = 0.0;

        for (let i = 0; i < n_samples; i++) {
            let y_hat = b_curr;
            for (let p = 0; p < n_powers; p++) {
                y_hat += w_out[p] * x_poly[i * n_powers + p];
            }

            let err = y_hat - y_data[i];
            mse_sum += err * err;

            grad_b += err;
            for (let p = 0; p < n_powers; p++) {
                grad_w[p] += err * x_poly[i * n_powers + p];
            }
        }

        final_mse = mse_sum / (2.0 * n_f);

        // Gradient updates
        b_curr -= lr * (grad_b / n_f);
        for (let p = 0; p < n_powers; p++) {
            w_out[p] = w_out[p] * (1.0 - lr * lambda_reg) - lr * (grad_w[p] / n_f);
        }
    }

    b_out[0] = b_curr;
    return final_mse;
}

fn main() -> int {
    print("==================================================================");
    print("   POLYNOMIAL REGRESSION: NON-LINEAR BASIS EXPANSION (v20)        ");
    print("==================================================================\n");

    // Non-Linear Cubic Generating Function:
    // y = 0.5 * x^3 - 2.0 * x^2 + 1.0 * x + 3.0
    let n_samples = 7;
    let x_raw = alloc(float, n_samples);
    let y_data = alloc(float, n_samples);

    x_raw[0] = -1.0; y_data[0] = -0.5; // 0.5*(-1) - 2*(1) - 1 + 3 = -0.5
    x_raw[1] = -0.5; y_data[1] = 1.9375;
    x_raw[2] =  0.0; y_data[2] = 3.0;
    x_raw[3] =  1.0; y_data[3] = 2.5;
    x_raw[4] =  2.0; y_data[4] = 1.0;
    x_raw[5] =  2.5; y_data[5] = 0.8125;
    x_raw[6] =  3.0; y_data[6] = 1.5;

    print("--- 1. Target Non-Linear Ground Truth ---");
    print("  Function: y = 0.5*x^3 - 2.0*x^2 + 1.0*x + 3.0");
    print("  Curvature exhibits local maximum at x ≈ 0.28 and local minimum at x ≈ 2.39\n");

    // =====================================================================
    // Model 1: Degree-1 Linear Regression (x) -> Underfitting
    // =====================================================================
    print("--- 2. Fitting Degree-1 Linear Model: ŷ = w_1*x + b ---");
    let x_deg1 = alloc(float, n_samples * 1);
    for (let i = 0; i < n_samples; i++) {
        x_deg1[i] = x_raw[i];
    }

    let w_deg1 = alloc(float, 1);
    let b_deg1 = alloc(float, 1);
    let mse_deg1 = train_poly_regression(&x_deg1, &y_data, n_samples, 1, 1500, 0.05, 0.001, &w_deg1, &b_deg1);
    print(f"  Degree-1 Model: ŷ = {w_deg1[0]} * x + ({b_deg1[0]})");
    print(f"  Degree-1 MSE Loss: {mse_deg1} (High Bias / Underfitting!)\n");

    // =====================================================================
    // Model 2: Degree-3 Cubic Polynomial Regression (x, x^2, x^3)
    // =====================================================================
    print("--- 3. Fitting Degree-3 Cubic Polynomial Model: ŷ = w1*x + w2*x^2 + w3*x^3 + b ---");
    let x_deg3 = alloc(float, n_samples * 3);
    for (let i = 0; i < n_samples; i++) {
        let x = x_raw[i];
        x_deg3[i * 3 + 0] = x;
        x_deg3[i * 3 + 1] = x * x;
        x_deg3[i * 3 + 2] = x * x * x;
    }

    let w_deg3 = alloc(float, 3);
    let b_deg3 = alloc(float, 1);
    let mse_deg3 = train_poly_regression(&x_deg3, &y_data, n_samples, 3, 3000, 0.01, 0.0001, &w_deg3, &b_deg3);
    print(f"  Degree-3 Model: ŷ = {w_deg3[2]}*x^3 + ({w_deg3[1]})*x^2 + ({w_deg3[0]})*x + ({b_deg3[0]})");
    print(f"  Degree-3 MSE Loss: {mse_deg3} (Converged with near-zero error!)\n");

    // --- 4. Comparing Out-of-Sample Interpolations ---
    print("--- 4. Evaluating Predictions on Unseen Non-Linear Test Queries ---");
    let test_points = alloc(float, 3);
    test_points[0] = 0.5;
    test_points[1] = 1.5;
    test_points[2] = 2.8;

    for (let k = 0; k < 3; k++) {
        let tx = test_points[k];
        let true_y = 0.5 * tx * tx * tx - 2.0 * tx * tx + 1.0 * tx + 3.0;

        let pred_linear = b_deg1[0] + w_deg1[0] * tx;
        let pred_cubic = b_deg3[0] + w_deg3[0] * tx + w_deg3[1] * (tx * tx) + w_deg3[2] * (tx * tx * tx);

        let err_linear = pred_linear - true_y;
        if (err_linear < 0.0) { err_linear = -err_linear; }
        let err_cubic = pred_cubic - true_y;
        if (err_cubic < 0.0) { err_cubic = -err_cubic; }

        print(f"  Test x = {tx} | Ground Truth y = {true_y}");
        print(f"    Linear Pred: {pred_linear} (Error = {err_linear})");
        print(f"    Cubic  Pred: {pred_cubic} (Error = {err_cubic})\n");
    }

    if (mse_deg3 < 0.01 && mse_deg3 < mse_deg1) {
        print("  SUCCESS: Polynomial basis expansion captured non-linear curve with high precision!\n");
    }

    print("==================================================================");
    print("Polynomial Regression verified with 0 memory leaks!");
    return 0;
}
