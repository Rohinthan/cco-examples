// Algorithm 53: Non-Negative Matrix Factorization (NMF) - Additive Parts-Based Decomposition & Multiplicative Updates

/*
================================================================================
                NON-NEGATIVE MATRIX FACTORIZATION (NMF)
================================================================================

1. The Non-Negativity Constraint & Parts-Based Representation (Lee & Seung, Nature 1999):
       Given a non-negative data matrix V ∈ R_{>= 0}^{n x m}, factorize it into
       two lower-rank non-negative matrices:
           V ≈ W * H
       where:
           - W ∈ R_{>= 0}^{n x r} : Basis dictionary / feature parts matrix
           - H ∈ R_{>= 0}^{r x m} : Activation coefficients / encoding matrix
           - r << min(n, m)       : Rank / number of latent parts

       *Significance*: Unlike PCA or SVD which permit negative numbers and subtractive
       cancellations, NMF enforces purely additive, parts-based combinations:
           V_{ij} ≈ Σ_{k=1}^r W_{ik} * H_{kj}

2. Frobenius Norm Reconstruction Objective:
       min_{W >= 0, H >= 0} (1 / 2) * || V - W * H ||_F^2 = (1 / 2) * Σ_{i,j} ( V_{ij} - (W*H)_{ij} )^2

3. Lee & Seung Multiplicative Update Rules:
       Guaranteed monotonic non-increasing loss convergence while strictly preserving
       non-negativity (no gradient projection required!):
           H_{kj} <- H_{kj} * [ ( W^T * V )_{kj} / ( ( W^T * W * H )_{kj} + ε ) ]
           W_{ik} <- W_{ik} * [ ( V * H^T )_{ik} / ( ( W * H * H^T )_{ik} + ε ) ]
================================================================================
*/

fn main() -> int {
    print("==================================================================");
    print("   NON-NEGATIVE MATRIX FACTORIZATION (NMF): PARTS-BASED (v20)     ");
    print("==================================================================\n");

    // Document-Word Term Matrix: 4 Documents (rows), 5 Words (columns)
    // Words: [0: Code, 1: Compiler, 2: Algorithm, 3: Gene, 4: DNA]
    // Docs 0, 1: Computer Science (Topics 0)
    // Docs 2, 3: Biology / Genetics (Topic 1)
    let n_docs = 4;
    let n_words = 5;
    let r_rank = 2; // 2 Latent Topics

    let v_mat = alloc(float, n_docs * n_words);

    // Doc 0: Tech [5.0, 4.0, 4.5, 0.0, 0.0]
    v_mat[0*5+0] = 5.0; v_mat[0*5+1] = 4.0; v_mat[0*5+2] = 4.5; v_mat[0*5+3] = 0.0; v_mat[0*5+4] = 0.0;
    // Doc 1: Tech [4.5, 5.0, 4.0, 0.0, 0.0]
    v_mat[1*5+0] = 4.5; v_mat[1*5+1] = 5.0; v_mat[1*5+2] = 4.0; v_mat[1*5+3] = 0.0; v_mat[1*5+4] = 0.0;
    // Doc 2: Bio  [0.0, 0.0, 0.0, 5.0, 4.0]
    v_mat[2*5+0] = 0.0; v_mat[2*5+1] = 0.0; v_mat[2*5+2] = 0.0; v_mat[2*5+3] = 5.0; v_mat[2*5+4] = 4.0;
    // Doc 3: Bio  [0.0, 0.0, 0.0, 4.0, 5.0]
    v_mat[3*5+0] = 0.0; v_mat[3*5+1] = 0.0; v_mat[3*5+2] = 0.0; v_mat[3*5+3] = 4.0; v_mat[3*5+4] = 5.0;

    print("--- 1. Input Non-Negative Document-Word Matrix V (4 x 5) ---");
    print("  Vocabulary: [0: Code, 1: Compiler, 2: Algorithm, 3: Gene, 4: DNA]");
    for (let i = 0; i < n_docs; i++) {
        print(f"  Doc #{i}: [ {v_mat[i*5+0]}  {v_mat[i*5+1]}  {v_mat[i*5+2]}  {v_mat[i*5+3]}  {v_mat[i*5+4]} ]");
    }
    print("");

    // Initialize W (4 x 2) and H (2 x 5) with strictly positive values
    let w_mat = alloc(float, n_docs * r_rank);
    let h_mat = alloc(float, r_rank * n_words);

    w_mat[0*2+0] = 0.8; w_mat[0*2+1] = 0.2;
    w_mat[1*2+0] = 0.7; w_mat[1*2+1] = 0.1;
    w_mat[2*2+0] = 0.1; w_mat[2*2+1] = 0.9;
    w_mat[3*2+0] = 0.2; w_mat[3*2+1] = 0.8;

    for (let k = 0; k < r_rank; k++) {
        for (let j = 0; j < n_words; j++) {
            let offset_rem = (k + j) % 3;
            h_mat[k * n_words + j] = 0.5 + 0.1 * (1.0 * offset_rem);
        }
    }

    // Intermediate Buffers for Multiplicative Updates
    let wt_v = alloc(float, r_rank * n_words);
    let wt_w_h = alloc(float, r_rank * n_words);
    let wt_w = alloc(float, r_rank * r_rank);

    let v_ht = alloc(float, n_docs * r_rank);
    let w_h_ht = alloc(float, n_docs * r_rank);
    let h_ht = alloc(float, r_rank * r_rank);

    let eps = 0.000000001;
    let max_iter = 300;

    print(f"--- 2. Executing Lee & Seung Multiplicative Updates ({max_iter} Iterations) ---");

    for (let iter = 0; iter < max_iter; iter++) {
        // =================================================================
        // 1. Update H: H <- H * (W^T * V) / (W^T * W * H + eps)
        // =================================================================
        // Compute W^T * V (r x m)
        for (let k = 0; k < r_rank; k++) {
            for (let j = 0; j < n_words; j++) {
                let sum = 0.0;
                for (let i = 0; i < n_docs; i++) {
                    sum += w_mat[i * r_rank + k] * v_mat[i * n_words + j];
                }
                wt_v[k * n_words + j] = sum;
            }
        }

        // Compute W^T * W (r x r)
        for (let k1 = 0; k1 < r_rank; k1++) {
            for (let k2 = 0; k2 < r_rank; k2++) {
                let sum = 0.0;
                for (let i = 0; i < n_docs; i++) {
                    sum += w_mat[i * r_rank + k1] * w_mat[i * r_rank + k2];
                }
                wt_w[k1 * r_rank + k2] = sum;
            }
        }

        // Compute (W^T * W) * H (r x m)
        for (let k = 0; k < r_rank; k++) {
            for (let j = 0; j < n_words; j++) {
                let sum = 0.0;
                for (let c = 0; c < r_rank; c++) {
                    sum += wt_w[k * r_rank + c] * h_mat[c * n_words + j];
                }
                wt_w_h[k * n_words + j] = sum;
            }
        }

        // Apply H Multiplicative Update
        for (let k = 0; k < r_rank; k++) {
            for (let j = 0; j < n_words; j++) {
                let num = wt_v[k * n_words + j];
                let den = wt_w_h[k * n_words + j] + eps;
                h_mat[k * n_words + j] *= (num / den);
            }
        }

        // =================================================================
        // 2. Update W: W <- W * (V * H^T) / (W * H * H^T + eps)
        // =================================================================
        // Compute V * H^T (n x r)
        for (let i = 0; i < n_docs; i++) {
            for (let k = 0; k < r_rank; k++) {
                let sum = 0.0;
                for (let j = 0; j < n_words; j++) {
                    sum += v_mat[i * n_words + j] * h_mat[k * n_words + j];
                }
                v_ht[i * r_rank + k] = sum;
            }
        }

        // Compute H * H^T (r x r)
        for (let k1 = 0; k1 < r_rank; k1++) {
            for (let k2 = 0; k2 < r_rank; k2++) {
                let sum = 0.0;
                for (let j = 0; j < n_words; j++) {
                    sum += h_mat[k1 * n_words + j] * h_mat[k2 * n_words + j];
                }
                h_ht[k1 * r_rank + k2] = sum;
            }
        }

        // Compute W * (H * H^T) (n x r)
        for (let i = 0; i < n_docs; i++) {
            for (let k = 0; k < r_rank; k++) {
                let sum = 0.0;
                for (let c = 0; c < r_rank; c++) {
                    sum += w_mat[i * r_rank + c] * h_ht[c * r_rank + k];
                }
                w_h_ht[i * r_rank + k] = sum;
            }
        }

        // Apply W Multiplicative Update
        for (let i = 0; i < n_docs; i++) {
            for (let k = 0; k < r_rank; k++) {
                let num = v_ht[i * r_rank + k];
                let den = w_h_ht[i * r_rank + k] + eps;
                w_mat[i * r_rank + k] *= (num / den);
            }
        }
    }

    // Compute final Frobenius Reconstruction Error
    let frob_err = 0.0;
    for (let i = 0; i < n_docs; i++) {
        for (let j = 0; j < n_words; j++) {
            let recon_val = 0.0;
            for (let k = 0; k < r_rank; k++) {
                recon_val += w_mat[i * r_rank + k] * h_mat[k * n_words + j];
            }
            let diff = v_mat[i * n_words + j] - recon_val;
            frob_err += diff * diff;
        }
    }
    frob_err = sqrt(frob_err);
    print(f"  Converged Frobenius Reconstruction Error ||V - WH||_F = {frob_err}\n");

    // --- 3. Inspect Discovered Topics (H Matrix) ---
    print("--- 3. Discovered Parts-Based Vocabulary Topics (H Matrix: 2 x 5) ---");
    for (let k = 0; k < r_rank; k++) {
        print(f"  Topic #{k}: [ Code={h_mat[k*5+0]}, Compiler={h_mat[k*5+1]}, Algorithm={h_mat[k*5+2]}, Gene={h_mat[k*5+3]}, DNA={h_mat[k*5+4]} ]");
    }
    print("");

    // --- 4. Inspect Document Topic Mixtures (W Matrix) ---
    print("--- 4. Document Topic Loadings (W Matrix: 4 x 2) ---");
    for (let i = 0; i < n_docs; i++) {
        let label = "Computer Science";
        if (i >= 2) { label = "Genetics / Biology"; }
        print(f"  Doc #{i} [{label}] -> Topic 0: {w_mat[i*2+0]} | Topic 1: {w_mat[i*2+1]}");
    }
    print("");

    if (frob_err < 1.50) {
        print("  SUCCESS: NMF cleanly decomposed documents into non-negative parts-based semantic topics!\n");
    }

    print("==================================================================");
    print("Non-Negative Matrix Factorization (NMF) verified with 0 memory leaks!");
    return 0;
}
