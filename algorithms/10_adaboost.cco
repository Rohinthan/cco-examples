// Algorithm 10: AdaBoost (Adaptive Boosting) with Decision Stumps

/*
================================================================================
                      ADABOOST (ADAPTIVE BOOSTING)
================================================================================

1. Initialization of Instance Weights:
       w_1(i) = 1 / N,   for i = 1, ..., N

2. For each boosting round m = 1, ..., M:
   a. Fit Weak Learner (Decision Stump):
          h_m(x) = s * sign(x_j - θ),  where s ∈ {-1, +1}

   b. Weighted Classification Error:
          ε_m = Σ_{i=1}^N w_m(i) * I( y_i != h_m(x_i) )

   c. Learner Stage Weight (Amount of Say):
          α_m = (1/2) * ln( (1 - ε_m) / (ε_m + ε) )

   d. Exponential Weight Update & Normalization:
          w_{m+1}(i) = (w_m(i) * exp( -α_m * y_i * h_m(x_i) )) / Z_m
          where Z_m = Σ_{i=1}^N w_m(i) * exp( -α_m * y_i * h_m(x_i) )

3. Final Strong Classifier (Weighted Majority Vote):
       H(x) = sign( Σ_{m=1}^M α_m * h_m(x) )
================================================================================
*/

struct DecisionStump {
    feature: int;       // 0 for x1, 1 for x2
    threshold: float;
    polarity: int;      // +1: if x <= th then +1 else -1; -1: if x <= th then -1 else +1
    alpha: float;       // Learner weight
    error: float;       // Weighted training error
}

fn predict_stump(s: &DecisionStump, x1_val: float, x2_val: float) -> int {
    let val: float = x1_val;
    if (s.feature == 1) {
        val = x2_val;
    }

    if (val <= s.threshold) {
        return s.polarity;
    }
    return -s.polarity;
}

// -------------------------------------------------------------
// Find Optimal Decision Stump for Current Sample Weights
// -------------------------------------------------------------
fn train_weak_stump(x1: &float[], x2: &float[], y: &int[], weights: &float[], n: int) -> DecisionStump {
    let best_feat: int = 0;
    let best_thresh: float = 0.0;
    let best_pol: int = 1;
    let min_err: float = 999.0;

    for (let f = 0; f < 2; f++) {
        for (let i = 0; i < n; i++) {
            let t: float = x1[i];
            if (f == 1) { t = x2[i]; }

            // Try both polarities: +1 and -1
            for (let pol_idx = 0; pol_idx < 2; pol_idx++) {
                let p: int = 1;
                if (pol_idx == 1) { p = -1; }

                let err: float = 0.0;
                for (let j = 0; j < n; j++) {
                    let val: float = x1[j];
                    if (f == 1) { val = x2[j]; }

                    let pred: int = -p;
                    if (val <= t) { pred = p; }

                    if (pred != y[j]) {
                        err += weights[j];
                    }
                }

                if (err < min_err) {
                    min_err = err;
                    best_feat = f;
                    best_thresh = t;
                    best_pol = p;
                }
            }
        }
    }

    let eps: float = 0.000001;
    if (min_err < eps) { min_err = eps; }
    if (min_err > 1.0 - eps) { min_err = 1.0 - eps; }

    // Stage Weight α = 0.5 * ln((1 - ε) / ε)
    let alpha: float = 0.5 * log((1.0 - min_err) / min_err);

    return DecisionStump {
        feature: best_feat,
        threshold: best_thresh,
        polarity: best_pol,
        alpha: alpha,
        error: min_err
    };
}

// -------------------------------------------------------------
// Train Full AdaBoost Ensemble
// -------------------------------------------------------------
fn train_adaboost(x1: &float[], x2: &float[], y: &int[], n: int, num_stumps: int, stumps: &DecisionStump[]) -> void {
    let weights: float[] = alloc(float, n);
    let init_w: float = 1.0 / (1.0 * n);
    for (let i = 0; i < n; i++) {
        weights[i] = init_w;
    }

    for (let m = 0; m < num_stumps; m++) {
        let stump: DecisionStump = train_weak_stump(x1, x2, y, &weights, n);
        stumps[m] = stump;

        // Update & normalize weights: w_i <- w_i * exp(-α * y_i * h(x_i))
        let z_sum: float = 0.0;
        for (let i = 0; i < n; i++) {
            let pred: int = predict_stump(&stump, x1[i], x2[i]);
            let exponent: float = -stump.alpha * (1.0 * y[i]) * (1.0 * pred);
            weights[i] = weights[i] * exp(exponent);
            z_sum += weights[i];
        }

        // Re-normalize weights
        for (let i = 0; i < n; i++) {
            weights[i] = weights[i] / z_sum;
        }

        print(f"  Round #{m + 1} Weak Stump: Feature {stump.feature} <= {stump.threshold} (Polarity: {stump.polarity}) | Error: {stump.error} | Alpha: {stump.alpha}");
    }
}

fn predict_adaboost_score(stumps: &DecisionStump[], num_stumps: int, x1_val: float, x2_val: float) -> float {
    let total_score: float = 0.0;
    for (let m = 0; m < num_stumps; m++) {
        let pred: int = predict_stump(&stumps[m], x1_val, x2_val);
        total_score += stumps[m].alpha * (1.0 * pred);
    }
    return total_score;
}

fn predict_adaboost_class(stumps: &DecisionStump[], num_stumps: int, x1_val: float, x2_val: float) -> int {
    let score: float = predict_adaboost_score(stumps, num_stumps, x1_val, x2_val);
    if (score >= 0.0) {
        return 1;
    }
    return -1;
}

fn main() -> int {
    print("==================================================================");
    print("   ADABOOST (ADAPTIVE BOOSTING) ENSEMBLE CLASSIFIER (Cco-v20)     ");
    print("==================================================================\n");

    // Non-linear Sandwich Dataset:
    // Class +1 is strictly bounded inside [3.0, 7.0]
    // Class -1 is outside: < 3.0 or > 7.0
    // A single linear decision stump CANNOT separate this! (Requires at least 2 stumps)
    let n: int = 8;
    let x1: float[] = alloc(float, n);
    let x2: float[] = alloc(float, n);
    let y: int[] = alloc(int, n);

    // Left outer (-1)
    x1[0] = 1.0; x2[0] = 2.0; y[0] = -1;
    x1[1] = 2.0; x2[1] = 3.0; y[1] = -1;
    // Middle inner (+1)
    x1[2] = 4.0; x2[2] = 4.0; y[2] = 1;
    x1[3] = 5.0; x2[3] = 6.0; y[3] = 1;
    x1[4] = 6.0; x2[4] = 5.0; y[4] = 1;
    // Right outer (-1)
    x1[5] = 8.0; x2[5] = 7.0; y[5] = -1;
    x1[6] = 9.0; x2[6] = 8.0; y[6] = -1;
    x1[7] = 10.0; x2[7] = 9.0; y[7] = -1;

    let num_stumps: int = 3;
    let stumps: DecisionStump[] = alloc(DecisionStump, num_stumps);

    print("--- 1. Iterative Boosting Rounds (Reweighting Misclassified Points) ---");
    train_adaboost(&x1, &x2, &y, n, num_stumps, &stumps);
    print("");

    print("--- 2. Comparing Single Weak Stump vs AdaBoost Ensemble ---");
    let single_correct: int = 0;
    let ensemble_correct: int = 0;

    for (let i = 0; i < n; i++) {
        let single_p: int = predict_stump(&stumps[0], x1[i], x2[i]);
        let ensemble_p: int = predict_adaboost_class(&stumps, num_stumps, x1[i], x2[i]);

        if (single_p == y[i]) { single_correct = single_correct + 1; }
        if (ensemble_p == y[i]) { ensemble_correct = ensemble_correct + 1; }
    }

    let single_acc: float = (1.0 * single_correct) / (1.0 * n);
    let ensemble_acc: float = (1.0 * ensemble_correct) / (1.0 * n);

    print(f"  Single Weak Stump Accuracy : {single_acc * 100.0}% ({single_correct}/{n})");
    print(f"  AdaBoost Ensemble Accuracy : {ensemble_acc * 100.0}% ({ensemble_correct}/{n})");
    print("  (Demonstrates successful boosting of weak learners into a strong classifier!)\n");

    print("--- 3. Testing Generalization on Unseen Data Points ---");
    let t1: int = predict_adaboost_class(&stumps, num_stumps, 1.5, 2.5);
    let t2: int = predict_adaboost_class(&stumps, num_stumps, 5.5, 5.2);
    let t3: int = predict_adaboost_class(&stumps, num_stumps, 8.5, 7.8);

    print(f"  Unseen Point (1.5, 2.5) -> AdaBoost Pred: {t1} (Expected: -1 Outer Left)");
    print(f"  Unseen Point (5.5, 5.2) -> AdaBoost Pred: {t2} (Expected: +1 Inner Middle)");
    print(f"  Unseen Point (8.5, 7.8) -> AdaBoost Pred: {t3} (Expected: -1 Outer Right)\n");

    print("==================================================================");
    print("AdaBoost ensemble validation complete with 0 memory leaks!");
    return 0;
}
