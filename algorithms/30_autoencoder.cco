// Algorithm 30: Autoencoders (Vanilla & Denoising) - Unsupervised Latent Representation & Manifold Reconstruction

/*
================================================================================
                    AUTOENCODERS & DENOISING AUTOENCODERS
================================================================================

1. Network Architecture & Latent Bottleneck:
       An autoencoder is an unsupervised neural network trained to reconstruct
       its input through an information bottleneck:
           Input Layer   : x ∈ R^D          (e.g., D = 4)
           Encoder       : z = f_θ(x) = σ( W_e * x + b_e ) ∈ R^d  (d < D, e.g., d = 2)
           Decoder       : x̂ = g_ϕ(z) = W_d * z + b_d ∈ R^D

2. Objective Function (Reconstruction Loss):
       Mean Squared Error (MSE):
           L(x, x̂) = (1 / 2) * ||x - x̂||^2 = (1 / 2) * Σ_{j=1}^D (x_j - x̂_j)^2

3. Denoising Autoencoder (DAE - Vincent et al., 2008):
       - Corrupt input: x̃ = x + ε,  where ε ~ N(0, σ^2)
       - Objective: Reconstruct uncorrupted x from corrupted x̃:
             L_DAE = (1 / 2) * ||x - g_ϕ(f_θ(x̃))||^2
       - Forces the latent space to project corrupted samples back onto the true
         low-dimensional data manifold, learning robust noise-invariant features!

4. Backpropagation Gradients:
       - Decoder output delta:
             δ_d = ∂L / ∂x̂ = x̂ - x
       - Decoder parameter gradients:
             ∂L / ∂W_d = δ_d * z^T,   ∂L / ∂b_d = δ_d

       - Encoder hidden error delta via Chain Rule:
             δ_e = ( W_d^T * δ_d ) ⊙ z ⊙ (1 - z)   (for Sigmoid activation)
       - Encoder parameter gradients:
             ∂L / ∂W_e = δ_e * x̃^T,   ∂L / ∂b_e = δ_e

5. Gradient Descent Update:
       W_d -= η * (∂L / ∂W_d),   b_d -= η * (∂L / ∂b_d)
       W_e -= η * (∂L / ∂W_e),   b_e -= η * (∂L / ∂b_e)
================================================================================
*/

fn sigmoid_ae(z: float) -> float {
    if (z > 15.0) { return 1.0; }
    if (z < -15.0) { return 0.0; }
    return 1.0 / (1.0 + exp(-z));
}

// -------------------------------------------------------------
// Forward Pass: Encoder (x -> z) and Decoder (z -> x̂)
// -------------------------------------------------------------
fn forward_ae(x: &float[], d_in: int, d_latent: int,
              w_e: &float[], b_e: &float[],
              w_d: &float[], b_d: &float[],
              z_latent: &float[], x_recon: &float[]) -> void {
    // 1. Encode: z = Sigmoid(W_e * x + b_e)
    for (let j = 0; j < d_latent; j++) {
        let sum = b_e[j];
        for (let i = 0; i < d_in; i++) {
            sum += w_e[j * d_in + i] * x[i];
        }
        z_latent[j] = sigmoid_ae(sum);
    }

    // 2. Decode: x̂ = W_d * z + b_d
    for (let i = 0; i < d_in; i++) {
        let sum = b_d[i];
        for (let j = 0; j < d_latent; j++) {
            sum += w_d[i * d_latent + j] * z_latent[j];
        }
        x_recon[i] = sum;
    }
}

// -------------------------------------------------------------
// Train Autoencoder via Full-Batch Gradient Descent
// -------------------------------------------------------------
fn train_autoencoder(x_clean: &float[], x_train: &float[], n_samples: int,
                     d_in: int, d_latent: int,
                     epochs: int, lr: float,
                     w_e: &float[], b_e: &float[],
                     w_d: &float[], b_d: &float[]) -> float {
    let n_f = 1.0 * n_samples;

    // Buffer allocations
    let z_all = alloc(float, n_samples * d_latent);
    let x_hat = alloc(float, n_samples * d_in);
    let cur_x = alloc(float, d_in);
    let cur_z = alloc(float, d_latent);
    let cur_recon = alloc(float, d_in);

    let delta_d = alloc(float, d_in);
    let delta_e = alloc(float, d_latent);

    let grad_we = alloc(float, d_latent * d_in);
    let grad_be = alloc(float, d_latent);
    let grad_wd = alloc(float, d_in * d_latent);
    let grad_bd = alloc(float, d_in);

    let final_loss = 0.0;

    for (let ep = 0; ep < epochs; ep++) {
        // Reset gradient accumulators
        for (let i = 0; i < d_in; i++) {
            grad_bd[i] = 0.0;
            for (let j = 0; j < d_latent; j++) {
                grad_wd[i * d_latent + j] = 0.0;
            }
        }
        for (let j = 0; j < d_latent; j++) {
            grad_be[j] = 0.0;
            for (let i = 0; i < d_in; i++) {
                grad_we[j * d_in + i] = 0.0;
            }
        }

        let total_mse = 0.0;

        for (let s = 0; s < n_samples; s++) {
            for (let i = 0; i < d_in; i++) {
                cur_x[i] = x_train[s * d_in + i];
            }

            // 1. Forward Pass
            forward_ae(&cur_x, d_in, d_latent, w_e, b_e, w_d, b_d, &cur_z, &cur_recon);

            for (let j = 0; j < d_latent; j++) {
                z_all[s * d_latent + j] = cur_z[j];
            }
            for (let i = 0; i < d_in; i++) {
                x_hat[s * d_in + i] = cur_recon[i];
                let diff = cur_recon[i] - x_clean[s * d_in + i];
                total_mse += 0.5 * diff * diff;
            }

            // 2. Decoder Error: δ_d = x̂ - x_clean
            for (let i = 0; i < d_in; i++) {
                delta_d[i] = cur_recon[i] - x_clean[s * d_in + i];
                grad_bd[i] += delta_d[i];
                for (let j = 0; j < d_latent; j++) {
                    grad_wd[i * d_latent + j] += delta_d[i] * cur_z[j];
                }
            }

            // 3. Encoder Error: δ_e = (W_d^T * δ_d) ⊙ z ⊙ (1 - z)
            for (let j = 0; j < d_latent; j++) {
                let sum_wd = 0.0;
                for (let i = 0; i < d_in; i++) {
                    sum_wd += w_d[i * d_latent + j] * delta_d[i];
                }
                let zj = cur_z[j];
                let d_sigmoid = zj * (1.0 - zj);
                let de = sum_wd * d_sigmoid;
                delta_e[j] = de;

                grad_be[j] += de;
                for (let i = 0; i < d_in; i++) {
                    grad_we[j * d_in + i] += de * cur_x[i];
                }
            }
        }

        final_loss = total_mse / n_f;

        // 4. Update Weights via Gradient Descent
        for (let i = 0; i < d_in; i++) {
            b_d[i] -= lr * (grad_bd[i] / n_f);
            for (let j = 0; j < d_latent; j++) {
                w_d[i * d_latent + j] -= lr * (grad_wd[i * d_latent + j] / n_f);
            }
        }

        for (let j = 0; j < d_latent; j++) {
            b_e[j] -= lr * (grad_be[j] / n_f);
            for (let i = 0; i < d_in; i++) {
                w_e[j * d_in + i] -= lr * (grad_we[j * d_in + i] / n_f);
            }
        }

        if (ep == 0 || (ep + 1) % 150 == 0 || ep == epochs - 1) {
            print(f"  Epoch #{ep + 1}: Reconstruction Loss (MSE) = {final_loss}");
        }
    }

    return final_loss;
}

fn main() -> int {
    print("==================================================================");
    print("   AUTOENCODERS (AE & DAE): UNSUPERVISED MANIFOLD LEARNING (v20)  ");
    print("==================================================================\n");

    // 6 Samples in 4D Space residing on a 2D Linear Subspace:
    // x2 = 2 * x0, x3 = 3 * x1
    let n_samples = 6;
    let d_in = 4;
    let d_latent = 2; // 50% Dimensionality Reduction Bottleneck (4D -> 2D -> 4D)

    let x_clean = alloc(float, n_samples * d_in);
    let x_noisy = alloc(float, n_samples * d_in);

    // Clean data points
    x_clean[0 * d_in + 0] = 1.0; x_clean[0 * d_in + 1] = 0.5; x_clean[0 * d_in + 2] = 2.0; x_clean[0 * d_in + 3] = 1.5;
    x_clean[1 * d_in + 0] = 2.0; x_clean[1 * d_in + 1] = 1.0; x_clean[1 * d_in + 2] = 4.0; x_clean[1 * d_in + 3] = 3.0;
    x_clean[2 * d_in + 0] = 0.5; x_clean[2 * d_in + 1] = 2.0; x_clean[2 * d_in + 2] = 1.0; x_clean[2 * d_in + 3] = 6.0;
    x_clean[3 * d_in + 0] = 1.5; x_clean[3 * d_in + 1] = 1.5; x_clean[3 * d_in + 2] = 3.0; x_clean[3 * d_in + 3] = 4.5;
    x_clean[4 * d_in + 0] = 3.0; x_clean[4 * d_in + 1] = 0.8; x_clean[4 * d_in + 2] = 6.0; x_clean[4 * d_in + 3] = 2.4;
    x_clean[5 * d_in + 0] = 0.8; x_clean[5 * d_in + 1] = 2.5; x_clean[5 * d_in + 2] = 1.6; x_clean[5 * d_in + 3] = 7.5;

    // Noisy data for Denoising Autoencoder (DAE) training
    for (let s = 0; s < n_samples; s++) {
        for (let i = 0; i < d_in; i++) {
            let noise = 0.05 * ((s + i) % 3 - 1);
            x_noisy[s * d_in + i] = x_clean[s * d_in + i] + noise;
        }
    }

    // Allocate parameters
    let w_e = alloc(float, d_latent * d_in);
    let b_e = alloc(float, d_latent);
    let w_d = alloc(float, d_in * d_latent);
    let b_d = alloc(float, d_in);

    // Initial random-scale weights
    w_e[0] =  0.4; w_e[1] =  0.2; w_e[2] =  0.8; w_e[3] =  0.6; b_e[0] = 0.0;
    w_e[4] = -0.3; w_e[5] =  0.5; w_e[6] = -0.6; w_e[7] =  0.9; b_e[1] = 0.0;

    w_d[0] = 1.0; w_d[1] = 0.5; b_d[0] = 0.1;
    w_d[2] = 0.5; w_d[3] = 1.0; b_d[1] = 0.1;
    w_d[4] = 2.0; w_d[5] = 1.0; b_d[2] = 0.2;
    w_d[6] = 1.5; w_d[7] = 3.0; b_d[3] = 0.3;

    let epochs = 600;
    let lr = 0.3;

    print("Architecture: 4D Input -> 2D Latent Bottleneck (Sigmoid) -> 4D Reconstruction (Linear)");
    print(f"Training Denoising Autoencoder across {epochs} epochs (η = {lr})...\n");

    print("--- 1. Minimizing Reconstruction Loss (MSE) ---");
    let final_loss = train_autoencoder(&x_clean, &x_noisy, n_samples, d_in, d_latent, epochs, lr,
                                       &w_e, &b_e, &w_d, &b_d);
    print(f"  Converged Reconstruction Loss: {final_loss}\n");

    // --- 2. Evaluating Reconstruction & Latent Codes ---
    print("--- 2. Latent Embeddings & Reconstruction Evaluation ---");
    let cur_in = alloc(float, d_in);
    let cur_z = alloc(float, d_latent);
    let cur_rec = alloc(float, d_in);

    for (let s = 0; s < 3; s++) {
        for (let i = 0; i < d_in; i++) {
            cur_in[i] = x_clean[s * d_in + i];
        }
        forward_ae(&cur_in, d_in, d_latent, &w_e, &b_e, &w_d, &b_d, &cur_z, &cur_rec);

        print(f"  Sample #{s} Clean: [{cur_in[0]}, {cur_in[1]}, {cur_in[2]}, {cur_in[3]}]");
        print(f"    Latent 2D Code z : [{cur_z[0]}, {cur_z[1]}]");
        print(f"    Reconstructed x̂  : [{cur_rec[0]}, {cur_rec[1]}, {cur_rec[2]}, {cur_rec[3]}]");
    }
    print("");

    // --- 3. Denoising Unseen Corrupted Input ---
    print("--- 3. Testing Denoising Capability on Corrupted Unseen Sample ---");
    let unseen_clean = alloc(float, d_in);
    let unseen_noisy = alloc(float, d_in);

    unseen_clean[0] = 2.5; unseen_clean[1] = 1.2; unseen_clean[2] = 5.0; unseen_clean[3] = 3.6;
    // Add heavy noise (+0.3, -0.25)
    unseen_noisy[0] = 2.8; unseen_noisy[1] = 0.95; unseen_noisy[2] = 5.25; unseen_noisy[3] = 3.35;

    forward_ae(&unseen_noisy, d_in, d_latent, &w_e, &b_e, &w_d, &b_d, &cur_z, &cur_rec);

    print(f"  Unseen Ground Truth Clean: [{unseen_clean[0]}, {unseen_clean[1]}, {unseen_clean[2]}, {unseen_clean[3]}]");
    print(f"  Corrupted Sensor Input   : [{unseen_noisy[0]}, {unseen_noisy[1]}, {unseen_noisy[2]}, {unseen_noisy[3]}]");
    print(f"  Denoised Clean Output x̂  : [{cur_rec[0]}, {cur_rec[1]}, {cur_rec[2]}, {cur_rec[3]}]\n");

    if (final_loss < 0.05) {
        print("  SUCCESS: Denoising Autoencoder learned the underlying manifold and removed noise!\n");
    }

    print("==================================================================");
    print("Autoencoder (Vanilla & DAE) verified with 0 memory leaks!");
    return 0;
}
