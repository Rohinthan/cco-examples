// 242_top_level_script_hello.cco — Python-style top-level script syntax in Cco
// Entry files can execute statements directly at the top level without an explicit `fn main()` wrapper.

let greeting: string = "Hello, Cco World!";
let year: int = 2026;
let pi: float = 3.14159;
let is_awesome: bool = true;

print(greeting);
print(year);
print(pi);
print(is_awesome);
