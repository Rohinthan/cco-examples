// 243_top_level_script_fibonacci.cco — Top-level script with functions declared alongside
// Helper functions (fn) can be defined alongside top-level script statements.

fn fib_iterative(n: int) -> int {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }

    let a: int = 0;
    let b: int = 1;
    let temp: int = 0;

    for (let i: int = 2; i <= n; i++) {
        temp = a + b;
        a = b;
        b = temp;
    }

    return b;
}

fn fib_recursive(n: int) -> int {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

print(fib_iterative(10));
print(fib_recursive(10));
